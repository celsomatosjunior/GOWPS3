#include <windows.h>
#include "version.h"

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GOW3_VERSION_RC
PRODUCTVERSION GOW3_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", "GOW3 PS3 PC (projeto independente)"
      VALUE "FileDescription", "GOW3 PS3 PC - God of War III (PS3) com RPCS3"
      VALUE "FileVersion", GOW3_VERSION_STR
      VALUE "InternalName", "GOW3_PS3_PC"
      VALUE "LegalCopyright", "GPL-2.0-only. Sem afiliacao com a Sony Interactive Entertainment."
      VALUE "OriginalFilename", "GOW3_PS3_PC.exe"
      VALUE "ProductName", "GOW3 PS3 PC"
      VALUE "ProductVersion", GOW3_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
