@@ -0,0 +1,138 @@
+#!/usr/bin/env python3
+"""spu_float_inputs.py: which float-op operands get SPU_AXI()."""
+import unittest
+
+from spu_float_inputs import mark_body, mark_body_flow, mark_float_inputs, unclamp_chains
+
+
+class MarkBody(unittest.TestCase):
+    def test_result_of_float_op_is_not_clamped_again(self):
+        out, n = mark_body(["        r_3 = spu_fm(r_1, r_2);",
+                            "        r_4 = spu_fma(r_3, r_1, r_3);"])
+        self.assertEqual(out[0].strip(), "r_3 = spu_fm(SPU_AXI(r_1), SPU_AXI(r_2));")
+        self.assertEqual(out[1].strip(), "r_4 = spu_fma(r_3, SPU_AXI(r_1), r_3);")
+        self.assertEqual(n, 3)
+
+    def test_other_assignment_forgets_the_register(self):
+        out, _ = mark_body(["        r_3 = spu_fa(r_1, r_2);",
+                            "        r_3 = spu_ori(r_9, 0);",
+                            "        r_4 = spu_fs(r_3, r_3);"])
+        self.assertEqual(out[2].strip(), "r_4 = spu_fs(SPU_AXI(r_3), SPU_AXI(r_3));")
+
+    def test_label_and_call_forget_everything(self):
+        for barrier in ("loc_00001234:", "        { SPU_DIRECT(ctx, 0x100, f); }", "        SPU_RET(ctx);"):
+            out, _ = mark_body(["        r_3 = spu_fm(r_1, r_2);", barrier, "        r_4 = spu_fm(r_3, r_3);"])
+            self.assertEqual(out[2].strip(), "r_4 = spu_fm(SPU_AXI(r_3), SPU_AXI(r_3));", barrier)
+
+    def test_stores_branches_and_conversions_keep_knowledge(self):
+        out, _ = mark_body(["        r_3 = spu_fm(r_1, r_2);",
+                            "        SPU_LSW(ctx, _ls, r_5._u32[0] + 0x10, r_3);",
+                            "        if (r_6._u32[0] != 0) goto loc_00000100;",
+                            "        r_7 = spu_cuflt(r_8, 155);",
+                            "        r_4 = spu_fma(r_3, r_7, r_3);"])
+        self.assertEqual(out[4].strip(), "r_4 = spu_fma(r_3, r_7, r_3);")
+
+    def test_gpr_form(self):
+        out, _ = mark_body(["    ctx->gpr[3] = spu_fm(ctx->gpr[1], ctx->gpr[2]);",
+                            "    ctx->gpr[4] = spu_fa(ctx->gpr[3], ctx->gpr[1]);"])
+        self.assertEqual(out[1].strip(), "ctx->gpr[4] = spu_fa(ctx->gpr[3], SPU_AXI(ctx->gpr[1]));")
+
+    def test_whole_unit_resets_per_function(self):
+        src = ("void f_1(spu_context* ctx) {\n        r_3 = spu_fm(r_1, r_2);\n}\n"
+               "void f_2(spu_context* ctx) {\n        r_4 = spu_fm(r_3, r_3);\n}\n")
+        out, n = mark_float_inputs(src)
+        self.assertIn("r_4 = spu_fm(SPU_AXI(r_3), SPU_AXI(r_3));", out)
+        self.assertEqual(n, 4)
+
+
+ENTRY = "        u128 r_1 = ctx->gpr[1]; u128 r_2 = ctx->gpr[2]; u128 r_3 = ctx->gpr[3]; u128 r_4 = ctx->gpr[4];"
+
+
+class UnclampChains(unittest.TestCase):
+    def test_intermediate_read_only_by_float_ops(self):
+        out, n = unclamp_chains([ENTRY,
+                                 "        r_3 = spu_fm(r_1, r_2);",
+                                 "        r_4 = spu_fma(r_3, r_1, r_3);",
+                                 "        r_3 = spu_il(0);",
+                                 "        SPU_LSW(ctx, _ls, r_2._u32[0] + 0x0, r_4);",
+                                 "        SPU_RET(ctx);"])
+        self.assertEqual(out[1].strip(), "r_3 = spu_fm_u(r_1, r_2);")
+        self.assertEqual(out[2].strip(), "r_4 = spu_fma(r_3, r_1, r_3);")   # stored: keeps the clamp
+        self.assertEqual(n, 1)
+
+    def test_value_reaching_an_exit_keeps_the_clamp(self):
+        out, n = unclamp_chains([ENTRY,
+                                 "        r_3 = spu_fm(r_1, r_2);",
+                                 "        r_4 = spu_fa(r_3, r_1);",
+                                 "        SPU_RET(ctx);"])
+        self.assertEqual(n, 0)    # r_3 and r_4 are both live at the return
+
+    def test_loop_back_edge_is_followed(self):
+        out, n = unclamp_chains([ENTRY,
+                                 "loc_00000100:",
+                                 "        r_3 = spu_fm(r_1, r_2);",
+                                 "        r_4 = spu_fa(r_3, r_4);",
+                                 "        if (r_1._u32[0] != 0) goto loc_00000100;",
+                                 "        r_3 = spu_il(0);",
+                                 "        SPU_LSW(ctx, _ls, r_2._u32[0] + 0x0, r_4);",
+                                 "        { SPU_DIRECT(ctx, 0x200, f); }"])
+        self.assertEqual(out[2].strip(), "r_3 = spu_fm_u(r_1, r_2);")
+        self.assertEqual(out[3].strip(), "r_4 = spu_fa(r_3, r_4);")
+
+    def test_non_float_reader_keeps_the_clamp(self):
+        for reader in ("        r_9 = spu_ori(r_3, 0);", "        if (r_3._u32[0] != 0) goto loc_00000100;",
+                       "        SPU_LSW(ctx, _ls, r_2._u32[0] + 0x0, r_3);"):
+            out, n = unclamp_chains([ENTRY, "loc_00000100:", "        r_3 = spu_fm(r_1, r_2);", reader,
+                                     "        r_3 = spu_il(0);", "        SPU_RET(ctx);"])
+            self.assertEqual(n, 0, reader)
+
+    def test_gpr_functions_are_left_alone(self):
+        body = ["    ctx->gpr[3] = spu_fm(ctx->gpr[1], ctx->gpr[2]);", "    SPU_RET(ctx);"]
+        self.assertEqual(unclamp_chains(body), (body, 0))
+
+
+class MarkBodyFlow(unittest.TestCase):
+    def test_loop_carried_copy_is_not_clamped_again(self):
+        out, _ = mark_body_flow([ENTRY,
+                                 "        r_3 = spu_fm(r_1, r_2);",
+                                 "loc_00000100:",
+                                 "        r_4 = spu_fma(r_3, r_3, r_4);",
+                                 "        r_2 = spu_fa(r_4, r_1);",
+                                 "        r_3 = spu_shlqbyi(r_2, 0);",
+                                 "        if (r_1._u32[0] != 0) goto loc_00000100;",
+                                 "        SPU_RET(ctx);"])
+        self.assertEqual(out[3].strip(), "r_4 = spu_fma(r_3, r_3, SPU_AXI(r_4));")   # r_4 comes from the entry
+        self.assertEqual(out[4].strip(), "r_2 = spu_fa(r_4, SPU_AXI(r_1));")
+
+    def test_one_unclamped_path_keeps_the_clamp(self):
+        out, _ = mark_body_flow([ENTRY,
+                                 "        r_3 = spu_fm(r_1, r_2);",
+                                 "        if (r_1._u32[0] != 0) goto loc_00000100;",
+                                 "        r_3 = spu_ori(r_9, 0);",
+                                 "loc_00000100:",
+                                 "        r_4 = spu_fm(r_3, r_3);",
+                                 "        SPU_RET(ctx);"])
+        self.assertEqual(out[5].strip(), "r_4 = spu_fm(SPU_AXI(r_3), SPU_AXI(r_3));")
+
+    def test_block_line_forgets_only_what_it_assigns(self):
+        out, _ = mark_body_flow([ENTRY,
+                                 "        r_3 = spu_fm(r_1, r_2);",
+                                 "        r_4 = spu_fm(r_1, r_2);",
+                                 "        if (r_1._u32[0] == 0) { ctx->gpr[3] = r_3; spu_call(ctx); r_4 = ctx->gpr[4]; }",
+                                 "        r_2 = spu_fa(r_3, r_4);",
+                                 "        SPU_RET(ctx);"])
+        self.assertEqual(out[4].strip(), "r_2 = spu_fa(r_3, SPU_AXI(r_4));")
+
+    def test_label_reached_only_by_goto_after_return(self):
+        out, _ = mark_body_flow([ENTRY,
+                                 "        r_3 = spu_fm(r_1, r_2);",
+                                 "        if (r_1._u32[0] != 0) goto loc_00000100;",
+                                 "        SPU_RET(ctx);",
+                                 "loc_00000100:",
+                                 "        r_4 = spu_fm(r_3, r_3);",
+                                 "        SPU_RET(ctx);"])
+        self.assertEqual(out[5].strip(), "r_4 = spu_fm(r_3, r_3);")
+
+
+if __name__ == "__main__":
+    unittest.main()
