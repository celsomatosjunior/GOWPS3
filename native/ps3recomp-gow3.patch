+/* CellSpursTasksetAttribute2 (512 bytes, 8-aligned), big-endian in guest memory:
+ *   +0x00 revision  +0x04 name (ea)  +0x08 args (u64)  +0x10 priority[8]
+ *   +0x18 maxContention  +0x1C enableClearLs  +0x20 taskNameBuffer (ea)
+ * A CellSpursTaskset2 is the 0x2900-byte taskset. */
+#define CSTS2_ATTR_SIZE 0x200u
+#define CSTS2_SIZE      0x2900u
+
+s32 _cellSpursTasksetAttribute2Initialize(void* attr, u32 revision)
+{
+    u32 ea = (u32)(uintptr_t)attr;
+    if (!ea) return (s32)0x80410911u;
+    if (ea & 7u) return (s32)0x80410910u;
+    if (!spurs_guest_range_valid(ea, CSTS2_ATTR_SIZE)) return (s32)0x8041090Du;
+    memset(GUEST_PTR(attr, u8*), 0, CSTS2_ATTR_SIZE);
+    vm_write32(ea + 0x00, revision);
+    vm_write32(ea + 0x10, 0x01010101u);    /* priority[0..7] = 1 */
+    vm_write32(ea + 0x14, 0x01010101u);
+    vm_write32(ea + 0x18, 8);              /* maxContention */
+    printf("[cellSpurs] _TasksetAttribute2Initialize(rev=%u)\n", revision);
+    return CELL_OK;
+}
+
+s32 cellSpursCreateTaskset2(CellSpurs* spurs, CellSpursTaskset* taskset, const void* attr)
+{
+    u32 attr_ea = (u32)(uintptr_t)attr;
+    u64 args = 0;
+    u8 priority[8] = {1, 1, 1, 1, 1, 1, 1, 1};
+    u32 max_contention = 8;
+    if (attr_ea) {
+        if (attr_ea & 7u) return (s32)0x80410910u;
+        if (!spurs_guest_range_valid(attr_ea, CSTS2_ATTR_SIZE)) return (s32)0x8041090Du;
+        args = ((u64)vm_read32(attr_ea + 0x08) << 32) | vm_read32(attr_ea + 0x0C);
+        memcpy(priority, GUEST_PTR(attr_ea + 0x10, const u8*), sizeof(priority));
+        max_contention = vm_read32(attr_ea + 0x18);
+    }
+    printf("[cellSpurs] CreateTaskset2(attr=0x%08X args=0x%llX maxContention=%u)\n",
+           attr_ea, (unsigned long long)args, max_contention);
+    return spurs_create_taskset(spurs, taskset, args, priority, max_contention, CSTS2_SIZE);
+}
