+    static int n = 0;
+    if (PS3_LOG_FIRST(n, 16))
+        printf("[cellSpurs] CreateTask2(taskset=0x%08X elf=0x%08X arg=0x%08X attr=0x%08X ctx=0x%llX size=0x%X)\n",
+               (u32)(uintptr_t)taskset, (u32)(uintptr_t)elf, argument_ea, attr_ea,
+               (unsigned long long)ea_ctx, size_ctx);
+    return cellSpursCreateTask(taskset, taskId, elf, (void*)(uintptr_t)(u32)ea_ctx, size_ctx,
+                               lsp_ea, argument_ea);
+}
