  * Taskset
  * =====================================================================*/
 
+/* Registry of the tasksets this HLE created, for callers that only know a
+ * (spurs, wid, taskId) triple -- the LFQueue signal function of a lifted
+ * libsre reaches a task that way. Every HLE taskset carries wid 0, so the
+ * triple can match several; the one where taskId is waiting wins, then one
+ * where it is enabled. */
+#define SPURS_TS_REG_MAX 64
+static u32 s_ts_reg[SPURS_TS_REG_MAX];
+static u32 s_ts_reg_n;
+
+static void spurs_taskset_registry_add(u32 taskset_ea)
+{
+    for (u32 i = 0; i < s_ts_reg_n; i++)
+        if (s_ts_reg[i] == taskset_ea) return;
+    if (s_ts_reg_n < SPURS_TS_REG_MAX) s_ts_reg[s_ts_reg_n++] = taskset_ea;
+}
+
+static int spurs_taskset_bit(u32 bitset_ea, u32 taskId)
+{
+    return (vm_read32(bitset_ea + (taskId >> 5) * 4) >> (31 - (taskId & 31))) & 1;
+}
+
+u32 spurs_taskset_find(u32 spurs_ea, u32 wid, u32 taskId)
+{
+    u32 enabled = 0;
+    if (taskId > 0x7F) return 0;
+    for (u32 i = s_ts_reg_n; i-- > 0;) {
+        u32 ts = s_ts_reg[i];
+        if ((u32)vm_read64(ts + CSTS_SPURS) != spurs_ea || vm_read32(ts + CSTS_WID) != wid) continue;
+        if (spurs_taskset_bit(ts + CSTS_WAITING, taskId)) return ts;
+        if (!enabled && spurs_taskset_bit(ts + CSTS_ENABLED, taskId)) enabled = ts;
+    }
+    return enabled;
+}
+
 static s32 spurs_create_taskset(CellSpurs* spurs, CellSpursTaskset* taskset,
                                 u64 args, const u8* priority, u32 maxContention,
                                 u32 taskset_size)
@@ -910,6 +944,7 @@ static s32 spurs_create_taskset(CellSpurs* spurs, CellSpursTaskset* taskset,
     spurs_taskset_init(taskset_ea, spurs_ea, args, /*wid*/0,
                        taskset_size, /*evf1*/0, /*evf2*/0);
     g_ydkj_real_taskset_ea = taskset_ea;
+    spurs_taskset_registry_add(taskset_ea);
 
     g_ydkj_real_spurs_ea = spurs_ea;   /* capture for the taskset-policy handoff (LS[0x1C0]) */
     printf("[cellSpurs] CreateTaskset() ea=0x%08X spurs=0x%08X (real BE layout)\n", taskset_ea, spurs_ea);
@@ -937,6 +972,46 @@ s32 cellSpursCreateTasksetWithAttribute(CellSpurs* spurs,
     return spurs_create_taskset(spurs, taskset, 0, NULL, 0, size);
 }
 
+/* CellSpursTasksetAttribute2 (512 bytes, 8-aligned), big-endian in guest memory:
+ *   +0x00 revision  +0x04 name (ea)  +0x08 args (u64)  +0x10 priority[8]
+ *   +0x18 maxContention  +0x1C enableClearLs  +0x20 taskNameBuffer (ea)
+ * A CellSpursTaskset2 is the 0x2900-byte taskset. */
+#define CSTS2_ATTR_SIZE 0x200u
+#define CSTS2_SIZE      0x2900u
+
+s32 _cellSpursTasksetAttribute2Initialize(void* attr, u32 revision)
+{
+    u32 ea = (u32)(uintptr_t)attr;
+    if (!ea) return (s32)0x80410911u;
+    if (ea & 7u) return (s32)0x80410910u;
+    if (!spurs_guest_range_valid(ea, CSTS2_ATTR_SIZE)) return (s32)0x8041090Du;
+    memset(GUEST_PTR(attr, u8*), 0, CSTS2_ATTR_SIZE);
+    vm_write32(ea + 0x00, revision);
+    vm_write32(ea + 0x10, 0x01010101u);    /* priority[0..7] = 1 */
+    vm_write32(ea + 0x14, 0x01010101u);
+    vm_write32(ea + 0x18, 8);              /* maxContention */
+    printf("[cellSpurs] _TasksetAttribute2Initialize(rev=%u)\n", revision);
+    return CELL_OK;
+}
+
+s32 cellSpursCreateTaskset2(CellSpurs* spurs, CellSpursTaskset* taskset, const void* attr)
+{
+    u32 attr_ea = (u32)(uintptr_t)attr;
+    u64 args = 0;
+    u8 priority[8] = {1, 1, 1, 1, 1, 1, 1, 1};
+    u32 max_contention = 8;
+    if (attr_ea) {
+        if (attr_ea & 7u) return (s32)0x80410910u;
+        if (!spurs_guest_range_valid(attr_ea, CSTS2_ATTR_SIZE)) return (s32)0x8041090Du;
+        args = ((u64)vm_read32(attr_ea + 0x08) << 32) | vm_read32(attr_ea + 0x0C);
+        memcpy(priority, GUEST_PTR(attr_ea + 0x10, const u8*), sizeof(priority));
+        max_contention = vm_read32(attr_ea + 0x18);
+    }
+    printf("[cellSpurs] CreateTaskset2(attr=0x%08X args=0x%llX maxContention=%u)\n",
+           attr_ea, (unsigned long long)args, max_contention);
+    return spurs_create_taskset(spurs, taskset, args, priority, max_contention, CSTS2_SIZE);
+}
+
 s32 cellSpursDestroyTaskset(CellSpursTaskset* taskset)
 {
     taskset = GUEST_PTR(taskset, CellSpursTaskset*);
