+     * the runtime write each task's exit there (spu_taskset2_set_exit), which
+     * cellSpursJoinTask2 and the SPU-side join read. */
+    if (rc == CELL_OK) { extern void spu_taskset2_register(uint32_t); spu_taskset2_register((u32)(uintptr_t)taskset); }
+    return rc;
