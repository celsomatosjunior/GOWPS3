new file mode 100644
index 00000000..1d348c24
--- /dev/null
+++ b/tools/test_spu_live_flush.py
@@ -0,0 +1,137 @@
+#!/usr/bin/env python3
+"""Tests for spu_live_flush.py (run: python tools/test_spu_live_flush.py)."""
+import os
+import sys
+import unittest
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import spu_live_flush as L  # noqa: E402
+
+
+def fn(name, body):
+    return f"void {name}(spu_context* ctx) {{\n" + "\n".join("        " + b for b in body) + "\n}\n"
+
+
+def stores(text, name):
+    seg = text[text.index(f"void {name}("):]
+    seg = seg[:seg.index("\n}\n")]
+    return sorted(int(x) for x in __import__("re").findall(r"ctx->gpr\[(\d+)\] = r_\1;", seg))
+
+
+class LiveFlush(unittest.TestCase):
+    def test_dead_temp_cut(self):
+        # A writes r5 and r6 and leaves to B; B reads r6 and overwrites r5 before returning.
+        a = fn("m_spu_func_00000100", [
+            "u128 r_5 = ctx->gpr[5]; u128 r_6 = ctx->gpr[6]; u128 r_7 = ctx->gpr[7];",
+            "r_5 = spu_ai(r_7, 1);",
+            "r_6 = spu_ai(r_5, 2);",
+            "ctx->gpr[5] = r_5; ctx->gpr[6] = r_6;",
+            "{ SPU_DIRECT(ctx, 0x200, m_spu_func_00000200); }"])
+        b = fn("m_spu_func_00000200", [
+            "ctx->gpr[8] = spu_ai(ctx->gpr[6], 3);",
+            "ctx->gpr[5] = spu_il(0);",
+            "SPU_RET(ctx);"])
+        out, n = L.process(a + b)
+        self.assertEqual(stores(out, "m_spu_func_00000100"), [6])
+        self.assertEqual(n, 1)
+
+    def test_live_to_return_kept(self):
+        a = fn("m_spu_func_00000100", [
+            "u128 r_5 = ctx->gpr[5]; u128 r_6 = ctx->gpr[6];",
+            "r_5 = spu_il(1);",
+            "r_6 = spu_il(2);",
+            "ctx->gpr[5] = r_5; ctx->gpr[6] = r_6;",
+            "{ SPU_DIRECT(ctx, 0x200, m_spu_func_00000200); }"])
+        b = fn("m_spu_func_00000200", ["SPU_RET(ctx);"])
+        out, _ = L.process(a + b)
+        self.assertEqual(stores(out, "m_spu_func_00000100"), [5, 6])
+        out, _ = L.process(a + b, L.ABI_RET_LIVE)    # r5/r6 are volatile under the ABI
+        self.assertEqual(stores(out, "m_spu_func_00000100"), [])
+
+    def test_unknown_target_keeps_all(self):
+        a = fn("m_spu_func_00000100", [
+            "u128 r_5 = ctx->gpr[5];",
+            "r_5 = spu_il(1);",
+            "ctx->gpr[5] = r_5;",
+            "{ SPU_DIRECT(ctx, 0x900, other_spu_func_00000900); }"])
+        out, _ = L.process(a)
+        self.assertEqual(stores(out, "m_spu_func_00000100"), [5])
+
+    def test_conditional_exit_in_loop(self):
+        # loop: r9 counter; r5 temp each pass; exit to B, which reads only r9.
+        a = fn("m_spu_func_00000100", [
+            "u128 r_5 = ctx->gpr[5]; u128 r_9 = ctx->gpr[9];",
+            "loc_00000100:",
+            "r_5 = spu_ai(r_9, 4);",
+            "r_9 = spu_ai(r_5, -1);",
+            "if (r_9._u32[0] == 0) { ctx->gpr[5] = r_5; ctx->gpr[9] = r_9; SPU_DIRECT(ctx, 0x200, m_spu_func_00000200); }",
+            "goto loc_00000100;"])
+        b = fn("m_spu_func_00000200", [
+            "ctx->gpr[5] = spu_ai(ctx->gpr[9], 1);",
+            "SPU_RET(ctx);"])
+        out, _ = L.process(a + b)
+        self.assertEqual(stores(out, "m_spu_func_00000100"), [9])
+
+    def test_channel_reads_only_its_register(self):
+        a = fn("m_spu_func_00000100", [
+            "u128 r_5 = ctx->gpr[5]; u128 r_6 = ctx->gpr[6];",
+            "r_5 = spu_il(1);",
+            "r_6 = spu_il(2);",
+            "ctx->gpr[5] = r_5; ctx->gpr[6] = r_6;",
+            "{ SPU_DIRECT(ctx, 0x200, m_spu_func_00000200); }"])
+        b = fn("m_spu_func_00000200", [
+            "spu_wrch(ctx, MFC_LSA, ctx->gpr[6]);",
+            "ctx->gpr[5] = spu_il(0); ctx->gpr[6] = spu_il(0);",
+            "SPU_RET(ctx);"])
+        out, _ = L.process(a + b)
+        # the second line of B has two statements: conservatively a use of r5/r6, no kill
+        self.assertEqual(stores(out, "m_spu_func_00000100"), [5, 6])
+
+    def test_call_keeps_callee_reads_and_after(self):
+        a = fn("m_spu_func_00000100", [
+            "u128 r_5 = ctx->gpr[5]; u128 r_6 = ctx->gpr[6];",
+            "r_5 = spu_il(1);",
+            "r_6 = spu_il(2);",
+            "ctx->gpr[5] = r_5; ctx->gpr[6] = r_6;",
+            "{ SPU_DIRECT(ctx, 0x200, m_spu_func_00000200); }"])
+        b = fn("m_spu_func_00000200", [
+            "ctx->gpr[0] = spu_link(0x210); { int32_t _si = (int32_t)ctx->image_id; ctx->host_depth++; "
+            "m_spu_func_00000300(ctx); spu_drain_call(ctx, 0x210); ctx->host_depth--; }",
+            "ctx->gpr[6] = spu_il(0);",
+            "SPU_RET(ctx);"])
+        c = fn("m_spu_func_00000300", [
+            "ctx->gpr[3] = spu_ai(ctx->gpr[5], 1);",
+            "SPU_RET(ctx);"])
+        out, _ = L.process(a + b + c, L.ABI_RET_LIVE)
+        self.assertEqual(stores(out, "m_spu_func_00000100"), [5])
+
+    def test_auto_abi_keeps_nonabi_result(self):
+        # B is called by A, and A reads r5 (volatile) after the call: B's returns keep r5 even in abi-auto;
+        # C is called only by code that reads nothing volatile afterwards: its returns follow the ABI.
+        a = fn("m_spu_func_00000100", [
+            "ctx->gpr[0] = spu_link(0x110); { int32_t _si = (int32_t)ctx->image_id; ctx->host_depth++; "
+            "m_spu_func_00000200(ctx); spu_drain_call(ctx, 0x110); ctx->host_depth--; }",
+            "ctx->gpr[3] = spu_ai(ctx->gpr[5], 1);",
+            "ctx->gpr[0] = spu_link(0x120); { int32_t _si = (int32_t)ctx->image_id; ctx->host_depth++; "
+            "m_spu_func_00000300(ctx); spu_drain_call(ctx, 0x120); ctx->host_depth--; }",
+            "SPU_RET(ctx);"])
+        b = fn("m_spu_func_00000200", [
+            "u128 r_5 = ctx->gpr[5]; u128 r_6 = ctx->gpr[6];",
+            "r_5 = spu_il(1);",
+            "r_6 = spu_il(2);",
+            "ctx->gpr[5] = r_5; ctx->gpr[6] = r_6;",
+            "{ SPU_DIRECT(ctx, 0x280, m_spu_func_00000280); }"])
+        b2 = fn("m_spu_func_00000280", ["SPU_RET(ctx);"])
+        c = fn("m_spu_func_00000300", [
+            "u128 r_5 = ctx->gpr[5];",
+            "r_5 = spu_il(1);",
+            "ctx->gpr[5] = r_5;",
+            "{ SPU_DIRECT(ctx, 0x380, m_spu_func_00000380); }"])
+        c2 = fn("m_spu_func_00000380", ["SPU_RET(ctx);"])
+        out, _ = L.process(a + b + b2 + c + c2, auto_abi=True)
+        self.assertEqual(stores(out, "m_spu_func_00000200"), [5, 6])
+        self.assertEqual(stores(out, "m_spu_func_00000300"), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
