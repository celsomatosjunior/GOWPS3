+/* Workload flag (RPCS3 cellSpurs.h): the 16-byte CellSpursWorkloadFlag sits at +0x60
+ * of the instance with its u32 flag at +0x6C, and +0x77 holds the wid that receives it
+ * (0xFF = none). A workload sets the flag to -1 when it is armed; the receiver polls
+ * and clears it. */
+s32 cellSpursGetWorkloadFlag(CellSpurs* spurs, void* flag)
+{
+    u32 s = (u32)(uintptr_t)spurs, f = (u32)(uintptr_t)flag;
+    if (!s || !f) return (s32)0x80410711u;   /* CELL_SPURS_POLICY_MODULE_ERROR_NULL_POINTER */
+    if (s & 0x7Fu) return (s32)0x80410710u;   /* ..._ALIGN */
+    vm_write32(f, s + 0x60);
+    return CELL_OK;
+}
+
+s32 _cellSpursWorkloadFlagReceiver(CellSpurs* spurs, u32 wid, u32 is_set)
+{
+    u32 s = (u32)(uintptr_t)spurs;
+    if (!s) return (s32)0x80410711u;
+    if (s & 0x7Fu) return (s32)0x80410710u;
+    if (wid >= 32) return (s32)0x80410702u;   /* ..._INVAL */
+    /* One CAS on the receiver byte; no global lock-line lock, which the SPU side
+     * also takes and which wedged the caller here. */
+    u8* recv = vm_base + s + 0x77;
+    u8 expect = is_set ? 0xFF : (u8)wid;
+    s32 rc = CELL_OK;
+    if (!__atomic_compare_exchange_n(recv, &expect, is_set ? (u8)wid : (u8)0xFF, 0,
+                                     __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+        rc = is_set ? (s32)0x8041070Au : (s32)0x80410709u;   /* ..._BUSY / ..._PERM */
+    else
+        vm_write32(s + 0x6C, 0xFFFFFFFFu);
+    static int n = 0;
+    if (PS3_LOG_FIRST(n, 8))
+        printf("[cellSpurs] WorkloadFlagReceiver(spurs=0x%08X wid=%u set=%u) -> 0x%08X\n", s, wid, is_set, (u32)rc);
+    return rc;
+}
+
+/* CellSpursTaskAttribute2 (256 bytes), big-endian in guest memory:
+ *   +0x00 revision  +0x04 sizeContext  +0x08 eaContext (u64)  +0x10 lsPattern[16]  +0x20 name (ea) */
+#define CSTA2_SIZE 0x100u
+
+s32 _cellSpursTaskAttribute2Initialize(void* attr, u32 revision)
+{
+    u32 ea = (u32)(uintptr_t)attr;
+    if (!ea) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if (ea & 0xFu) return (s32)0x80410910u;   /* CELL_SPURS_TASK_ERROR_ALIGN */
+    memset(GUEST_PTR(attr, u8*), 0, CSTA2_SIZE);
+    vm_write32(ea + 0x00, revision);
+    return CELL_OK;
+}
+
+/* cellSpursCreateTask2(taskset2, taskId, elf, argument, attribute2): the context, its size and
+ * the LS pattern come from the attribute (all optional), the argument is the 16-byte
+ * CellSpursTaskArgument. Same task model as cellSpursCreateTask. */
+s32 cellSpursCreateTask2(CellSpursTaskset* taskset, CellSpursTaskId* taskId, void* elf,
+                         u32 argument_ea, u32 attr_ea)
