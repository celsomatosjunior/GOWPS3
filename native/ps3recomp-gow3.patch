 }
 
+/* CellSpursTasksetAttribute2 (512 bytes, 8-aligned), big-endian in guest memory:
+ *   +0x00 revision  +0x04 name (ea)  +0x08 args (u64)  +0x10 priority[8]
+ *   +0x18 maxContention  +0x1C enableClearLs  +0x20 taskNameBuffer (ea)
+ * A CellSpursTaskset2 is the 0x2900-byte taskset. */
+#define CSTS2_ATTR_SIZE 0x200u
+#define CSTS2_SIZE      0x2900u
+
+s32 _cellSpursTasksetAttribute2Initialize(void* attr, u32 revision)
+{
+    u32 ea = (u32)(uintptr_t)attr;
+    if (!ea) return (s32)0x80410911u;
+    if (ea & 7u) return (s32)0x80410910u;
+    if (!spurs_guest_range_valid(ea, CSTS2_ATTR_SIZE)) return (s32)0x8041090Du;
+    memset(GUEST_PTR(attr, u8*), 0, CSTS2_ATTR_SIZE);
+    vm_write32(ea + 0x00, revision);
+    vm_write32(ea + 0x10, 0x01010101u);    /* priority[0..7] = 1 */
+    vm_write32(ea + 0x14, 0x01010101u);
+    vm_write32(ea + 0x18, 8);              /* maxContention */
+    printf("[cellSpurs] _TasksetAttribute2Initialize(rev=%u)\n", revision);
+    return CELL_OK;
+}
+
+s32 cellSpursCreateTaskset2(CellSpurs* spurs, CellSpursTaskset* taskset, const void* attr)
+{
+    u32 attr_ea = (u32)(uintptr_t)attr;
+    u64 args = 0;
+    u8 priority[8] = {1, 1, 1, 1, 1, 1, 1, 1};
+    u32 max_contention = 8;
+    if (attr_ea) {
+        if (attr_ea & 7u) return (s32)0x80410910u;
+        if (!spurs_guest_range_valid(attr_ea, CSTS2_ATTR_SIZE)) return (s32)0x8041090Du;
+        args = ((u64)vm_read32(attr_ea + 0x08) << 32) | vm_read32(attr_ea + 0x0C);
+        memcpy(priority, GUEST_PTR(attr_ea + 0x10, const u8*), sizeof(priority));
+        max_contention = vm_read32(attr_ea + 0x18);
+    }
+    printf("[cellSpurs] CreateTaskset2(attr=0x%08X args=0x%llX maxContention=%u)\n",
+           attr_ea, (unsigned long long)args, max_contention);
+    return spurs_create_taskset(spurs, taskset, args, priority, max_contention, CSTS2_SIZE);
+}
+
 s32 cellSpursDestroyTaskset(CellSpursTaskset* taskset)
 {
     taskset = GUEST_PTR(taskset, CellSpursTaskset*);
@@ -1000,6 +1077,81 @@ s32 cellSpursTasksetAttributeSetName(CellSpursTasksetAttribute* attr,
  * from an EA computed out of r3 = that argument (spu_0003 task main @0x17e70:
  * `wrch $ch18, f(r3.word3)`), so a zero argument makes it GET from EA 0 and
  * stall. lsPattern/argument arrive as guest EAs (generic adapter forwards r3..r10). */
+s32 cellSpursCreateTask(CellSpursTaskset* taskset, CellSpursTaskId* taskId,
+                        void* elf, void* context, u32 sizeContext,
+                        u32 lsPattern_ea, u32 argument_ea);
+
+/* Workload flag (RPCS3 cellSpurs.h): the 16-byte CellSpursWorkloadFlag sits at +0x60
+ * of the instance with its u32 flag at +0x6C, and +0x77 holds the wid that receives it
+ * (0xFF = none). A workload sets the flag to -1 when it is armed; the receiver polls
+ * and clears it. */
+s32 cellSpursGetWorkloadFlag(CellSpurs* spurs, void* flag)
+{
+    u32 s = (u32)(uintptr_t)spurs, f = (u32)(uintptr_t)flag;
+    if (!s || !f) return (s32)0x80410711u;   /* CELL_SPURS_POLICY_MODULE_ERROR_NULL_POINTER */
+    if (s & 0x7Fu) return (s32)0x80410710u;   /* ..._ALIGN */
+    vm_write32(f, s + 0x60);
+    return CELL_OK;
+}
+
+s32 _cellSpursWorkloadFlagReceiver(CellSpurs* spurs, u32 wid, u32 is_set)
+{
+    u32 s = (u32)(uintptr_t)spurs;
+    if (!s) return (s32)0x80410711u;
+    if (s & 0x7Fu) return (s32)0x80410710u;
+    if (wid >= 32) return (s32)0x80410702u;   /* ..._INVAL */
+    u8* recv = vm_base + s + 0x77;
+    spu_lockline_lock();
+    s32 rc = CELL_OK;
+    if (is_set ? *recv != 0xFF : *recv != wid) {
+        rc = is_set ? (s32)0x8041070Au : (s32)0x80410709u;   /* ..._BUSY / ..._PERM */
+    } else {
+        vm_write32(s + 0x6C, 0xFFFFFFFFu);
+        *recv = is_set ? (u8)wid : 0xFF;
+    }
+    spu_lockline_unlock();
+    static int n = 0;
+    if (PS3_LOG_FIRST(n, 8))
+        printf("[cellSpurs] WorkloadFlagReceiver(spurs=0x%08X wid=%u set=%u) -> 0x%08X\n", s, wid, is_set, (u32)rc);
+    return rc;
+}
+
+/* CellSpursTaskAttribute2 (256 bytes), big-endian in guest memory:
+ *   +0x00 revision  +0x04 sizeContext  +0x08 eaContext (u64)  +0x10 lsPattern[16]  +0x20 name (ea) */
+#define CSTA2_SIZE 0x100u
+
+s32 _cellSpursTaskAttribute2Initialize(void* attr, u32 revision)
+{
+    u32 ea = (u32)(uintptr_t)attr;
+    if (!ea) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if (ea & 0xFu) return (s32)0x80410910u;   /* CELL_SPURS_TASK_ERROR_ALIGN */
+    memset(GUEST_PTR(attr, u8*), 0, CSTA2_SIZE);
+    vm_write32(ea + 0x00, revision);
+    return CELL_OK;
+}
+
+/* cellSpursCreateTask2(taskset2, taskId, elf, argument, attribute2): the context, its size and
+ * the LS pattern come from the attribute (all optional), the argument is the 16-byte
+ * CellSpursTaskArgument. Same task model as cellSpursCreateTask. */
+s32 cellSpursCreateTask2(CellSpursTaskset* taskset, CellSpursTaskId* taskId, void* elf,
+                         u32 argument_ea, u32 attr_ea)
+{
+    u32 size_ctx = 0, lsp_ea = 0;
+    u64 ea_ctx = 0;
+    if (attr_ea) {
+        size_ctx = vm_read32(attr_ea + 0x04);
+        ea_ctx   = ((u64)vm_read32(attr_ea + 0x08) << 32) | vm_read32(attr_ea + 0x0C);
+        lsp_ea   = attr_ea + 0x10;
+    }
+    static int n = 0;
+    if (PS3_LOG_FIRST(n, 16))
+        printf("[cellSpurs] CreateTask2(taskset=0x%08X elf=0x%08X arg=0x%08X attr=0x%08X ctx=0x%llX size=0x%X)\n",
+               (u32)(uintptr_t)taskset, (u32)(uintptr_t)elf, argument_ea, attr_ea,
+               (unsigned long long)ea_ctx, size_ctx);
+    return cellSpursCreateTask(taskset, taskId, elf, (void*)(uintptr_t)(u32)ea_ctx, size_ctx,
+                               lsp_ea, argument_ea);
+}
+
 s32 cellSpursCreateTask(CellSpursTaskset* taskset, CellSpursTaskId* taskId,
                         void* elf, void* context, u32 sizeContext,
                         u32 lsPattern_ea, u32 argument_ea)
