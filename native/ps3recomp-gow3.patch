+/* Registry of the tasksets this HLE created, for callers that only know a
+ * (spurs, wid, taskId) triple -- the LFQueue signal function of a lifted
+ * libsre reaches a task that way. Every HLE taskset carries wid 0, so the
+ * triple can match several; the one where taskId is waiting wins, then one
+ * where it is enabled. */
+#define SPURS_TS_REG_MAX 64
+static u32 s_ts_reg[SPURS_TS_REG_MAX];
+static u32 s_ts_reg_n;
+
+static void spurs_taskset_registry_add(u32 taskset_ea)
+{
+    for (u32 i = 0; i < s_ts_reg_n; i++)
+        if (s_ts_reg[i] == taskset_ea) return;
+    if (s_ts_reg_n < SPURS_TS_REG_MAX) s_ts_reg[s_ts_reg_n++] = taskset_ea;
+}
+
+static int spurs_taskset_bit(u32 bitset_ea, u32 taskId)
+{
+    return (vm_read32(bitset_ea + (taskId >> 5) * 4) >> (31 - (taskId & 31))) & 1;
+}
+
+u32 spurs_taskset_find(u32 spurs_ea, u32 wid, u32 taskId)
+{
+    u32 enabled = 0;
+    if (taskId > 0x7F) return 0;
+    for (u32 i = s_ts_reg_n; i-- > 0;) {
+        u32 ts = s_ts_reg[i];
+        if ((u32)vm_read64(ts + CSTS_SPURS) != spurs_ea || vm_read32(ts + CSTS_WID) != wid) continue;
+        if (spurs_taskset_bit(ts + CSTS_WAITING, taskId)) return ts;
+        if (!enabled && spurs_taskset_bit(ts + CSTS_ENABLED, taskId)) enabled = ts;
+    }
+    return enabled;
+}
