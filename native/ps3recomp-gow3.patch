+#!/usr/bin/env python3
+"""Inline a lifted function's fall-through into the next chunk (run before spu_reg_locals.py).
+
+spu_lifter.py cuts a function at every branch target, so a loop's preamble and the loop itself (whose
+header is the target of its own back edge) are two C functions joined by SPU_DIRECT. With register
+locals every such hop stores the registers the first one wrote and the second loads them all again: in
+God of War III's hottest EDGE loop ~60 stores and ~75 loads per entry, more than the loop body when it
+runs a few iterations.
+
+This pass looks at functions whose last statement is an unconditional SPU_DIRECT to the chunk that
+starts right after them in address order (a fall-through) defined in the same file, and appends that
+chunk's body in place of the hop -- repeatedly, up to max_depth chunks and max_lines lines in all, so
+the result stays within spu_reg_locals.py's limits. The inlined chunk keeps its own function for its
+other entries. Labels are per SPU address and stay unique; a branch back into an inlined chunk is a
+plain goto to its label (each inlined chunk gets its entry label, so a later SPU_DIRECT to it can be
+turned into one by spu_reg_locals.py). What the pass gives up is the per-hop checks SPU_DIRECT makes (a pending
+interrupt, the stack-reset hint) on that one hop: a chain stays bounded by max_depth.
+"""
+from __future__ import annotations
+
+import re
+import sys
+
+_SIG = re.compile(r"^void (\w+_spu_func_([0-9A-Fa-f]{8}))\(spu_context\* ctx\) \{$")
+_TAIL = re.compile(r"^\s*\{ SPU_DIRECT\(ctx, 0x([0-9A-Fa-f]+), (\w+)\); \}\s*$")
+
+
+def inline_fallthrough(text: str, max_lines: int = 500, max_depth: int = 4) -> tuple[str, int]:
+    lines = text.split("\n")
+    funcs = {}            # name -> (start, end) line indices of the body
+    order = []            # (address, name)
+    i = 0
+    while i < len(lines):
+        m = _SIG.match(lines[i])
+        if m:
+            j = i + 1
+            while j < len(lines) and lines[j] != "}":
+                j += 1
+            funcs[m.group(1)] = (i + 1, j)
+            order.append((int(m.group(2), 16), m.group(1)))
+            i = j
+        i += 1
+    order.sort()
+    nxt = {order[k][1]: order[k + 1][1] for k in range(len(order) - 1)}
+    body = {n: lines[a:b] for n, (a, b) in funcs.items()}
+
+    def tail_target(b):
+        k = len(b) - 1
+        while k >= 0 and not b[k].strip():
+            k -= 1
+        m = _TAIL.match(b[k]) if k >= 0 else None
+        return (k, m.group(2)) if m else (None, None)
+
+    merged = 0
+    new_body = {}
+    for name, b in body.items():
+        cur, seen, depth = list(b), {name}, 0
+        while depth < max_depth:
+            k, tgt = tail_target(cur)
+            if tgt is None or tgt not in body or tgt in seen or nxt.get(_last_chunk(seen, name, nxt)) != tgt:
+                break
+            add = body[tgt]
+            lab = f"loc_{int(_SIG.match(lines[funcs[tgt][0] - 1]).group(2), 16):08X}:"
+            if not any(x.strip() == lab for x in add):
+                add = [lab] + add     # spu_reg_locals.py turns a branch back to it into a goto
+            if len(cur) - 1 + len(add) > max_lines:
+                break
+            cur = cur[:k] + add
+            seen.add(tgt); depth += 1; merged += 1
+        new_body[name] = cur
+    out, i = [], 0
+    while i < len(lines):
+        m = _SIG.match(lines[i])
+        if m:
+            a, b = funcs[m.group(1)]
+            out.append(lines[i]); out.extend(new_body[m.group(1)])
+            i = b
+            continue
+        out.append(lines[i]); i += 1
+    return "\n".join(out), merged
+
+
+def _last_chunk(seen, first, nxt):
+    """The chunk the current chain ends with: follow fall-throughs from the first while they are in it."""
+    c = first
+    while nxt.get(c) in seen:
+        c = nxt[c]
+    return c
+
+
+if __name__ == "__main__":
+    for p in sys.argv[1:]:
+        with open(p, encoding="utf-8") as f:
+            t, n = inline_fallthrough(f.read())
+        with open(p, "w", encoding="utf-8", newline="\n") as f:
+            f.write(t)
+        print(f"{p}: {n} fall-throughs inlined")
