diff --git a/libs/video/tests/test_vertex_remap.c b/libs/video/tests/test_vertex_remap.c
new file mode 100644
index 00000000..4b9d97a2
--- /dev/null
+++ b/libs/video/tests/test_vertex_remap.c
@@ -0,0 +1,73 @@
+/*
+ * rsx_vertex_remap_build against a naive first-occurrence reference, on random
+ * reference lists that take both the dense path (one base_index, narrow range)
+ * and the hash path (mixed base_index, wide range), reusing one remap across
+ * calls so the generation stamps are exercised too.
+ *
+ * Build (from the repo root):
+ *   clang -std=gnu17 -O2 -Wall -Wextra -Wno-unused-parameter -I include -I libs/video \
+ *     -o /tmp/test_vertex_remap libs/video/tests/test_vertex_remap.c \
+ *     libs/video/rsx_vertex_compact.c libs/video/rsx_dispatch.c
+ */
+#include "rsx_vertex_compact.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint64_t s_rng = 0x9E3779B97F4A7C15ull;
+static u32 rnd(void)
+{
+    s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17;
+    return (u32)(s_rng >> 16);
+}
+
+int main(void)
+{
+    enum { MAXN = 5000 };
+    static rsx_vertex_ref in[MAXN], got[MAXN], want[MAXN];
+    static u32 want_occ[MAXN];
+    rsx_vertex_remap remap;
+    memset(&remap, 0, sizeof remap);
+    int failures = 0, dense_like = 0;
+    for (int iter = 0; iter < 20000; iter++) {
+        const u32 n = 1 + rnd() % (iter % 7 == 0 ? MAXN : 300);
+        const u32 kind = rnd() % 4;
+        const u32 base = rnd() % 3 == 0 ? rnd() : 0;
+        const u32 lo = rnd() % 4 == 0 ? rnd() : rnd() % 70000;
+        const u32 span = kind == 0 ? 1 + rnd() % 8 : kind == 1 ? 1 + rnd() % (n + 1)
+                       : kind == 2 ? 1 + rnd() % (8 * n + 9000) : rnd() | 1;
+        for (u32 i = 0; i < n; i++) {
+            in[i].vertex_id = lo + rnd() % span;
+            in[i].base_index = (kind == 3 && rnd() % 5 == 0) ? base + 1 : base;
+        }
+        if (kind <= 1) dense_like++;
+        /* reference: quadratic first-occurrence dedup */
+        u32 wu = 0;
+        for (u32 i = 0; i < n; i++) {
+            u32 j = 0;
+            for (; j < wu; j++)
+                if (want[j].vertex_id == in[i].vertex_id && want[j].base_index == in[i].base_index) break;
+            if (j == wu) want[wu++] = in[i];
+            want_occ[i] = j;
+        }
+        memcpy(got, in, n * sizeof *got);
+        u32 unique = 0;
+        if (!rsx_vertex_remap_build(&remap, got, n, &unique)) {
+            printf("iter %d: build failed\n", iter); failures++; continue;
+        }
+        int bad = unique != wu;
+        for (u32 i = 0; !bad && i < wu; i++)
+            bad = got[i].vertex_id != want[i].vertex_id || got[i].base_index != want[i].base_index;
+        for (u32 i = 0; !bad && i < n; i++)
+            bad = rsx_vertex_remap_index(&remap, i) != want_occ[i];
+        if (bad) {
+            if (failures < 5) printf("iter %d (kind %u n %u): unique %u want %u\n", iter, kind, n, unique, wu);
+            failures++;
+        }
+    }
+    rsx_vertex_remap_destroy(&remap);
+    printf("test_vertex_remap: 20000 lists (%d narrow), %d failure(s)\n", dense_like, failures);
+    return failures != 0;
+}
