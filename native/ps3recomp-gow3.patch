+/* cellSpursJoinTask2(taskset2, taskId, &exitCode): wait for the task to exit
+ * and take its exit code. task_exit_code[taskId] (+0x1980, 16 bytes): exit
+ * code at +8, state in the low nibble of byte 15 -- 2 exited, 4 joined -- as
+ * the runtime writes it when a task's thread returns. God of War III joins
+ * the five tasks of a taskset it restarts every frame; with the import
+ * unresolved each join failed at once and the game never moved past its
+ * difficulty screen. A task that is neither exited nor enabled is ESRCH;
+ * joining twice is ESRCH as well. */
+s32 cellSpursJoinTask2(CellSpursTaskset* taskset, CellSpursTaskId taskId, s32* exitCode)
+{
+    const u32 ts = (u32)(uintptr_t)taskset, out = (u32)(uintptr_t)exitCode;
+    if (!ts) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if (taskId >= 128) return CELL_SPURS_TASK_ERROR_INVAL;
+    const u32 e = ts + 0x1980u + 16u * taskId;
+    for (unsigned waited = 0;; waited++) {
+        const u8 state = vm_read8(e + 15) & 0xF;
+        if (state == 2) {
+            vm_write8(e + 15, (u8)((vm_read8(e + 15) & 0xF0) | 4));
+            if (out) vm_write32(out, vm_read32(e + 8));
+            return CELL_OK;
+        }
+        if (state == 4) return CELL_SPURS_TASK_ERROR_SRCH;
+        const u32 enabled = vm_read32(ts + 0x30 + (taskId / 32) * 4) & ((1u << 31) >> (taskId % 32));
+        if (!enabled && state == 0) return CELL_SPURS_TASK_ERROR_SRCH;
+        if (waited == 2000) {
+            static int n = 0;
+            if (PS3_LOG_FIRST(n, 8))
+                printf("[cellSpurs] JoinTask2(taskset=0x%08X task=%u) still waiting after 2 s\n", ts, taskId);
+        }
