+#!/usr/bin/env python3
+"""--reg-locals (spu_reg_locals.py) must keep the lifted program's behaviour.
+
+Unit checks of the rewrite (pure lines on locals, store-back around escapes,
+store-back inside an `if` that leaves) and the merge-chunks interrupt program
+compiled and run with the rewrite on, merged and unmerged: the pending
+interrupt must still be taken at the chunk entry and r3 reach the same value.
+
+Usage:
+    python3 tools/test_spu_reg_locals.py
+"""
+
+import sys
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+sys.path.insert(0, str(TOOLS))
+
+from spu_reg_locals import localize_body, localize_source  # noqa: E402
+import test_spu_lifter_merge_chunks as mc  # noqa: E402
+
+
+class Rewrite(unittest.TestCase):
+    def test_pure_lines_use_locals(self):
+        out = localize_body(["    ctx->gpr[3] = spu_ai(ctx->gpr[4], 1);",
+                             "    spu_ls_write128(ctx, ctx->gpr[1]._u32[0] + 0x10, ctx->gpr[3]);"])
+        self.assertIn("u128 r_1 = ctx->gpr[1]; u128 r_3 = ctx->gpr[3]; u128 r_4 = ctx->gpr[4];"
+                      " uint8_t* _ls = ctx->ls;", out[0])
+        self.assertEqual(out[1].strip(), "r_3 = spu_ai(r_4, 1);")
+        self.assertEqual(out[2].strip(), "SPU_LSW(ctx, _ls, r_1._u32[0] + 0x10, r_3);")
+
+    def test_escape_stores_back_and_reloads(self):
+        out = localize_body(["    ctx->gpr[3] = spu_ai(ctx->gpr[3], 1);",
+                             "    spu_wrch(ctx, 28, ctx->gpr[3]);",
+                             "    ctx->gpr[4] = spu_ori(ctx->gpr[3], 0);"])
+        self.assertEqual([l.strip() for l in out[2:5]],
+                         ["ctx->gpr[3] = r_3; ctx->gpr[4] = r_4;",
+                          "spu_wrch(ctx, 28, ctx->gpr[3]);",
+                          "r_3 = ctx->gpr[3]; r_4 = ctx->gpr[4];"])
+
+    def test_leaving_if_stores_back_inside(self):
+        out = localize_body(["    ctx->gpr[5] = spu_il(1);",
+                             "    if (ctx->gpr[5]._u32[0] != 0) { SPU_DIRECT(ctx, 0x40, f); }"])
+        self.assertEqual(out[2].strip(),
+                         "if (r_5._u32[0] != 0) { ctx->gpr[5] = r_5; SPU_DIRECT(ctx, 0x40, f); }")
+
+    def test_ctx_condition_with_return_block(self):
+        line = ("    if (ctx->int_enable && (ctx->event_status & ctx->event_mask)) "
+                "{ ctx->pc = 0x4; g_spu_trampoline_fn = f; return; }")
+        out = localize_body(["    ctx->gpr[3] = spu_il(0);", "loc_4:", line])
+        self.assertEqual(out[2], "loc_4:")
+        self.assertTrue(out[3].strip().startswith(
+            "if (ctx->int_enable && (ctx->event_status & ctx->event_mask)) { ctx->gpr[3] = r_3;"))
+
+    def test_many_escapes_left_unchanged(self):
+        body = ["    ctx->gpr[3] = spu_ai(ctx->gpr[3], 1);",
+                "    spu_wrch(ctx, 28, ctx->gpr[3]);"] * 9
+        self.assertEqual(localize_body(body), body)
+        self.assertNotEqual(localize_body(body, max_escapes=0), body)
+
+    def test_branch_to_own_entry_is_a_local_loop(self):
+        src = ("void m_spu_func_00000100(spu_context* ctx) {\n"
+               "    ctx->gpr[3] = spu_ai(ctx->gpr[3], -1);\n"
+               "    if (ctx->gpr[3]._u32[0] != 0) { SPU_DIRECT(ctx, 0x100, m_spu_func_00000100); }\n"
+               "    SPU_RET(ctx);\n}\n")
+        out = localize_source(src).split("\n")
+        self.assertEqual(out[2], "loc_00000100:")          # after the entry loads
+        self.assertEqual(out[4].strip(),
+                         "if (r_3._u32[0] != 0) { if (SPU_DIRECT_LOCAL_OK(ctx, 0x100)) goto loc_00000100; "
+                         "ctx->gpr[3] = r_3; SPU_DIRECT(ctx, 0x100, m_spu_func_00000100); }")
+
+    def test_branch_elsewhere_gets_no_entry_label(self):
+        src = ("void m_spu_func_00000100(spu_context* ctx) {\n"
+               "    ctx->gpr[3] = spu_ai(ctx->gpr[3], -1);\n"
+               "    if (ctx->gpr[3]._u32[0] != 0) { SPU_DIRECT(ctx, 0x200, m_spu_func_00000200); }\n"
+               "    SPU_RET(ctx);\n}\n")
+        out = localize_source(src)
+        self.assertNotIn("loc_00000100:", out)
+        self.assertNotIn("SPU_DIRECT_LOCAL_OK", out)
+
+    def test_unconditional_branch_to_a_label_in_the_body(self):
+        out = localize_body(["    ctx->gpr[3] = spu_il(4);",
+                             "loc_00000110:",
+                             "    ctx->gpr[3] = spu_ai(ctx->gpr[3], -1);",
+                             "    { SPU_DIRECT(ctx, 0x110, m_spu_func_00000110); }"], entry=0x100)
+        self.assertNotIn("loc_00000100:", out)
+        self.assertEqual([l.strip() for l in out[4:8]],
+                         ["if (SPU_DIRECT_LOCAL_OK(ctx, 0x110)) goto loc_00000110;",
+                          "ctx->gpr[3] = r_3;",
+                          "{ SPU_DIRECT(ctx, 0x110, m_spu_func_00000110); }",
+                          "r_3 = ctx->gpr[3];"])
+
+    def test_function_without_registers_is_unchanged(self):
+        src = "void f(spu_context* ctx) {\n    ctx->pc = 0x10u; return;\n}\n"
+        self.assertEqual(localize_source(src), src)
+
+
+class Behaviour(mc.MergeChunkInterrupts):
+    """The merge-chunks programs again, lifted with --reg-locals."""
+
+    def run_program(self, merge):
+        orig = mc.lift
+
+        def lift_rl(m):
+            lifter = orig(m)
+            lifter.reg_locals = True
+            return lifter
+        mc.lift = lift_rl
+        try:
+            return super().run_program(merge)
+        finally:
+            mc.lift = orig
+
+    # the body checks look at the raw lifter output, which --reg-locals does not change
+    test_merged_entry_checks_for_pending_interrupt = None
+    test_unmerged_output_has_no_entry_check = None
+
+
+if __name__ == '__main__':
+    unittest.main()
