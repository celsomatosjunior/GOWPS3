new file mode 100644
index 00000000..42b46926
--- /dev/null
+++ b/runtime/spu/spu_jobcap.c
@@ -0,0 +1,169 @@
+/* SPU job capture: the state a real SPU job starts from, every DMA it does and the state it ends in,
+ * written to files so the job can be replayed and timed outside the game (tools/spu_job_replay).
+ *
+ * SPU_JOBCAP=<dir>,<image id>,<entry LSA hex>[,<max jobs>[,<skip jobs>]]
+ *   A job starts when a dispatch to <entry> runs the function the registry has for (<image id>, <entry>)
+ *   (a WWS job-code module's image, e.g. 206 for God of War III's EDGE geometry module); its record opens
+ *   as <dir>/job_<n>.gjc. It ends when the call that entered it drains back to the link address it
+ *   was entered with (r0 at entry); a new job start on the same thread closes an unfinished record as
+ *   incomplete. Default 64 jobs, none skipped.
+ *
+ * Record format (host byte order, u32 words):
+ *   "GJC1" u32 version(1) u32 image u32 entry
+ *   chunks: u32 tag, u32 a, u32 b, u32 size, then size bytes
+ *     1 start: a = the context's own image (the job manager's), b = link (r0); data = 128 registers (u128, host layout) + the 256 KB LS
+ *     2 GET:   a = lsa, b = ea; data = the bytes the GET put in the LS
+ *     3 PUT:   a = lsa, b = ea; data = the bytes the PUT wrote to main memory
+ *     7 context: data = image_id, resident_ovl, resident_task, decrementer value at the start (after tag 1)
+ *     8 event/interrupt/MFC tag/parked list state (gjc_state, after tag 7)
+ *     5 end:   a = image, b = pc; data = registers + LS, as tag 1
+ *     6 incomplete (no end seen), size 0
+ *     4 eof, size 0
+ * Atomic transfers (GETLLAR/PUTLLC) are not recorded. */
+#include "spu_context.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+volatile int g_spu_jobcap_live = -1;          /* -1 not parsed, 0 off, 1 armed */
+static char s_dir[400];
+static int s_image;
+static uint32_t s_entry;
+static long s_max = 64, s_skip = 0;
+static volatile long s_seen = 0, s_done = 0;
+static SPU_THREAD_LOCAL FILE* t_rec;
+static SPU_THREAD_LOCAL const spu_context* t_ctx;
+static SPU_THREAD_LOCAL uint32_t t_link;
+
+static void jc_parse(void)
+{
+    const char* e = getenv("SPU_JOBCAP");
+    if (!e || !*e) { g_spu_jobcap_live = 0; return; }
+    char tmp[600]; strncpy(tmp, e, sizeof tmp - 1); tmp[sizeof tmp - 1] = 0;
+    char* f[5] = {0}; int n = 0;
+    for (char* p = tmp; n < 5 && p; ) { f[n++] = p; p = strchr(p, ','); if (p) *p++ = 0; }
+    if (n < 3) { fprintf(stderr, "[jobcap] SPU_JOBCAP=<dir>,<image>,<entry hex>[,max[,skip]]\n"); g_spu_jobcap_live = 0; return; }
+    strncpy(s_dir, f[0], sizeof s_dir - 1);
+    s_image = atoi(f[1]);
+    s_entry = (uint32_t)strtoul(f[2], 0, 16);
+    if (n > 3 && *f[3]) s_max = atol(f[3]);
+    if (n > 4 && *f[4]) s_skip = atol(f[4]);
+    fprintf(stderr, "[jobcap] image %d entry 0x%05X -> %s (max %ld, skip %ld)\n", s_image, s_entry, s_dir, s_max, s_skip);
+    g_spu_jobcap_live = 1;
+}
+
+
+/* tag 8 (the event/interrupt/MFC tag/parked list state a job starts with) comes from an optional local
+ * file, spu_jobcap_state_ps3kit.c, which fills these in from a constructor; without it no tag 8. */
+void   (*g_spu_jobcap_state_save)(void* s, const spu_context* c) = 0;
+void   (*g_spu_jobcap_state_load)(spu_context* c, const void* s) = 0;
+size_t g_spu_jobcap_state_size = 0;
+
+
+/* The value SPU_RdDec would return now, without the read's side effects. */
+#ifndef SPU_DECREMENTER_HZ
+#define SPU_DECREMENTER_HZ 79800000ull   /* as spu_channels.c */
+#endif
+extern uint64_t spu_host_ns_pub(void);
+static uint32_t spu_read_channel_u32_dec(const spu_context* ctx)
+{
+    if (!ctx->dec_base_ns) return ctx->decrementer;
+    const uint64_t elapsed = spu_host_ns_pub() - ctx->dec_base_ns;
+    const uint64_t secs = elapsed / 1000000000ull, rem = elapsed % 1000000000ull;
+    const uint32_t ticks = (uint32_t)(secs * SPU_DECREMENTER_HZ + (rem * SPU_DECREMENTER_HZ) / 1000000000ull);
+    return ctx->decrementer - ticks;
+}
+
+static void jc_chunk(FILE* f, uint32_t tag, uint32_t a, uint32_t b, const void* d1, uint32_t n1, const void* d2, uint32_t n2)
+{
+    const uint32_t h[4] = { tag, a, b, n1 + n2 };
+    fwrite(h, 4, 4, f);
+    if (n1) fwrite(d1, 1, n1, f);
+    if (n2) fwrite(d2, 1, n2, f);
+}
+
+static void jc_close(int complete, const spu_context* ctx)
+{
+    if (!t_rec) return;
+    if (complete) jc_chunk(t_rec, 5, (uint32_t)s_image, ctx->pc, ctx->gpr, sizeof ctx->gpr, ctx->ls, SPU_LS_SIZE);
+    else jc_chunk(t_rec, 6, 0, 0, 0, 0, 0, 0);
+    jc_chunk(t_rec, 4, 0, 0, 0, 0, 0, 0);
+    fclose(t_rec); t_rec = NULL; t_ctx = NULL;
+    const long d = __atomic_add_fetch(&s_done, 1, __ATOMIC_RELAXED);
+    if (d >= s_max) g_spu_jobcap_live = 0;
+}
+
+/* From spu_indirect_branch, before the resolved function runs. */
+typedef void (*jc_fn)(spu_context*);
+extern jc_fn spu_lookup(uint32_t addr, int image_id);
+static jc_fn s_entry_fn;
+void spu_jobcap_dispatch(spu_context* ctx, void (*fn)(spu_context*))
+{
+    if (g_spu_jobcap_live < 0) jc_parse();
+    if (g_spu_jobcap_live <= 0) return;
+    /* the job went back to its link by a computed branch (the manager's own dispatch loop takes it there) */
+    if (t_rec && ctx == t_ctx && (ctx->pc & SPU_LS_MASK) == t_link) { jc_close(1, ctx); return; }
+    { static int dbg = -1, nd = 0;   /* SPU_JOBCAP_DEBUG=1: the first dispatches into the job code buffer */
+      if (dbg < 0) dbg = getenv("SPU_JOBCAP_DEBUG") ? 1 : 0;
+      const uint32_t pc = ctx->pc & SPU_LS_MASK;
+      if (dbg && pc >= 0x4000u && pc < 0x20000u && nd < 40) { nd++;
+          fprintf(stderr, "[jobcap-dbg] pc=0x%05X image=%d resident_ovl=%d task=%d r0=0x%05X\n",
+                  pc, ctx->image_id, ctx->resident_ovl, ctx->resident_task, ctx->gpr[0]._u32[0] & SPU_LS_MASK); } }
+    { static int dbg2 = -1;   /* SPU_JOBCAP_DEBUG: job entries (link back in the manager, below 0x4000), counted */
+      if (dbg2 < 0) dbg2 = getenv("SPU_JOBCAP_DEBUG") ? 1 : 0;
+      const uint32_t pc = ctx->pc & SPU_LS_MASK, lr = ctx->gpr[0]._u32[0] & SPU_LS_MASK;
+      if (dbg2 && pc >= 0x4000u && lr < 0x4000u) {
+          static uint32_t epc[64]; static unsigned long long en[64], tot;
+          int k = 0; while (k < 64 && epc[k] && epc[k] != pc) k++;
+          if (k < 64) { if (!epc[k]) epc[k] = pc; en[k]++; }
+          if ((++tot % 200000) == 0) {
+              fprintf(stderr, "[jobcap-dbg] %llu job entries:", tot);
+              for (int i = 0; i < 64 && epc[i]; i++) if (en[i] * 100 >= tot) fprintf(stderr, " %05X=%llu", epc[i], en[i]);
+              fprintf(stderr, "%c", 10);
+          } } }
+    if ((ctx->pc & SPU_LS_MASK) != s_entry) return;
+    /* the module's entry, by the function about to run (image ids at dispatch are not the module's) */
+    if (!s_entry_fn) s_entry_fn = spu_lookup(s_entry, s_image);
+    { static int nm = 0; if (getenv("SPU_JOBCAP_DEBUG") && nm < 10 && fn != s_entry_fn) { nm++;
+        fprintf(stderr, "[jobcap-dbg] entry 0x%05X: dispatched fn=%p, registry (%d)=%p, image=%d ovl=%d"
+                "%c", s_entry, (void*)fn, s_image, (void*)s_entry_fn, ctx->image_id, ctx->resident_ovl, 10); } }
+    if (!fn || fn != s_entry_fn) return;
+    if (t_rec) jc_close(0, ctx);                       /* a job that never drained back */
+    const long k = __atomic_fetch_add(&s_seen, 1, __ATOMIC_RELAXED);
+    if (k < s_skip || k - s_skip >= s_max) return;
+    char path[512]; snprintf(path, sizeof path, "%s/job_%05ld.gjc", s_dir, k - s_skip);
+    FILE* f = fopen(path, "wb");
+    if (!f) { fprintf(stderr, "[jobcap] cannot open %s\n", path); g_spu_jobcap_live = 0; return; }
+    setvbuf(f, NULL, _IOFBF, 1 << 20);
+    const uint32_t hdr[4] = { 0x31434A47u /* "GJC1" */, 1u, (uint32_t)s_image, s_entry };
+    fwrite(hdr, 4, 4, f);
+    t_link = ctx->gpr[0]._u32[0] & SPU_LS_MASK;
+    jc_chunk(f, 1, (uint32_t)ctx->image_id, t_link, ctx->gpr, sizeof ctx->gpr, ctx->ls, SPU_LS_SIZE);
+    { /* the decrementer as the job would read it now (SPU_RdDec: decrementer - ticks since dec_base_ns) */
+      const uint32_t dec_now = spu_read_channel_u32_dec(ctx);
+      const uint32_t st[4] = { (uint32_t)ctx->image_id, (uint32_t)ctx->resident_ovl, (uint32_t)ctx->resident_task, dec_now };
+      jc_chunk(f, 7, 0, 0, st, sizeof st, 0, 0); }
+    if (g_spu_jobcap_state_save && g_spu_jobcap_state_size <= 4096) {
+        uint8_t gs[4096]; g_spu_jobcap_state_save(gs, ctx);
+        jc_chunk(f, 8, 0, 0, gs, (uint32_t)g_spu_jobcap_state_size, 0, 0); }
+    t_rec = f; t_ctx = ctx;
+}
+
+/* From spu_drain_call (inline and full): the call that entered the job is back at its link. */
+void spu_jobcap_ret(spu_context* ctx, uint32_t return_pc)
+{
+    if (t_rec && ctx == t_ctx && (return_pc & SPU_LS_MASK) == t_link && (ctx->pc & SPU_LS_MASK) == t_link)
+        jc_close(1, ctx);
+}
+
+/* From mfc_do_transfer, after a GET's copy / before a PUT's copy (the LS bytes are the data either way). */
+/* SPU_JOBREPLAY (spu_jobreplay.c): the context being replayed and a callback for its DMAs. */
+spu_context* volatile g_spu_jobreplay_ctx = 0;
+void (*g_spu_jobreplay_dma)(int put, uint32_t lsa, uint32_t ea, const uint8_t* ls_ptr, uint32_t size) = 0;
+
+void spu_jobcap_dma(spu_context* ctx, int put, uint32_t lsa, uint64_t ea, const uint8_t* ls_ptr, uint32_t size)
+{
+    if (ctx == g_spu_jobreplay_ctx && g_spu_jobreplay_dma) { g_spu_jobreplay_dma(put, lsa, (uint32_t)ea, ls_ptr, size); return; }
+    if (t_rec && ctx == t_ctx && size)
+        jc_chunk(t_rec, put ? 3u : 2u, lsa, (uint32_t)ea, ls_ptr, size, 0, 0);
+}
diff --git a/runtime/spu/spu_jobreplay.c b/runtime/spu/spu_jobreplay.c
new file mode 100644
index 00000000..f9be897f
--- /dev/null
+++ b/runtime/spu/spu_jobreplay.c
@@ -0,0 +1,250 @@
+/* SPU job replay: run jobs recorded by SPU_JOBCAP (spu_jobcap.c) outside the game, time them and compare
+ * them with what they did in the game.
+ *
+ * SPU_JOBREPLAY=<dir>[,<reps>[,<first>[,<count>]]]   (the title's main calls spu_jobreplay_main once guest
+ * memory and the lifted code are registered, and exits with its result)
+ *
+ * Each <dir>/job_<n>.gjc: the GETs' bytes are written to guest memory at their EAs (in record order), a
+ * fresh context gets the recorded registers and local store, its link register becomes SPU_JOB_RETURN_LS
+ * so the job halts when it returns, and the job runs <reps> times (default 10) from its entry. The first
+ * run is compared with the record's end state: local store bytes, registers r1..r127 (r0, the link, was
+ * replaced) and every PUT's bytes in guest memory (a later PUT to the same bytes wins, as in the game).
+ * Printed per job: [jobreplay] job <n>: ok|DIFF, LS bytes differing (and the first ranges), registers
+ * differing, PUT bytes differing, median time of the runs in microseconds. A summary line ends it.
+ *
+ * Differences are expected where the job manager's interrupt handler wrote during the job in the game
+ * (it pipelines the next jobs' inputs): the replay has no interrupts. */
+#include "spu_context.h"
+#include "spu_interp.h"   /* spu_lifted_fn / spu_lifted_lookup */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+extern uint8_t* vm_base;
+extern int spu_run_with_halt(void (*entry)(spu_context*), spu_context* ctx);
+extern spu_lifted_fn spu_lookup(uint32_t addr, int image_id);
+extern void   (*g_spu_jobcap_state_load)(spu_context* c, const void* s);   /* spu_jobcap.c (optional) */
+extern size_t g_spu_jobcap_state_size;
+
+typedef struct { uint32_t tag, a, b, size; uint8_t* data; } jr_chunk;
+
+/* the replayed job's own DMAs, in order (spu_jobcap_dma calls back while g_spu_jobreplay_ctx is it) */
+extern spu_context* volatile g_spu_jobreplay_ctx;
+extern volatile int g_spu_jobcap_live;
+extern void (*g_spu_jobreplay_dma)(int put, uint32_t lsa, uint32_t ea, const uint8_t* ls_ptr, uint32_t size);
+typedef struct { int put; uint32_t lsa, ea, size; uint8_t* data; } jr_dma;
+static jr_dma s_dma[512]; static int s_ndma, s_dma_limit, s_stalled, s_keep;
+static void jr_on_dma(int put, uint32_t lsa, uint32_t ea, const uint8_t* ls_ptr, uint32_t size)
+{
+    if (s_dma_limit && s_ndma >= s_dma_limit) {   /* far past the record: a wait the game never had */
+        extern void spu_halt(spu_context* ctx);
+        s_stalled = 1; spu_halt(g_spu_jobreplay_ctx); return;
+    }
+    if (s_ndma >= 512 || !s_keep) { s_ndma++; return; }
+    jr_dma* d = &s_dma[s_ndma++];
+    d->put = put; d->lsa = lsa; d->ea = ea; d->size = size;
+    d->data = (uint8_t*)malloc(size); memcpy(d->data, ls_ptr, size);
+}
+
+static double jr_now_us(void)
+{
+#ifdef _WIN32
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart * 1e6 / (double)f.QuadPart;
+#else
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return ts.tv_sec * 1e6 + ts.tv_nsec / 1e3;
+#endif
+}
+
+static int jr_cmp_d(const void* a, const void* b)
+{
+    const double x = *(const double*)a, y = *(const double*)b; return x < y ? -1 : x > y;
+}
+
+/* What the manager's `bisl` into the job does: the job runs as a call that drains back to the recorded link
+ * (the call sequence the SPU lifter emits for every bisl). Entering the job this way, in policy mode and with
+ * its own link, follows the replay in Arnaldo Lima's ps3kit (spu_jobcap.c, replay_entry/replay_setup). */
+static void (*s_replay_fn)(spu_context*);
+static uint32_t s_replay_ret;
+static void jr_entry(spu_context* ctx)
+{
+    ctx->host_depth++;
+    s_replay_fn(ctx);
+    spu_drain_call(ctx, s_replay_ret);
+    ctx->host_depth--;
+}
+
+/* Returns 0 on success (all compared jobs identical), 1 if any differed, 2 on an error. */
+static int jr_job(const char* path, int reps, int* ndiff, double* tsum, int* njobs)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) return -1;
+    uint32_t hdr[4];
+    if (fread(hdr, 4, 4, f) != 4 || hdr[0] != 0x31434A47u) { fclose(f); fprintf(stderr, "[jobreplay] %s: not a GJC1 record\n", path); return 2; }
+    const int image = (int)hdr[2]; const uint32_t entry = hdr[3];
+    jr_chunk* ch = NULL; int n = 0, cap = 0;
+    for (;;) {
+        jr_chunk c; uint32_t h[4];
+        if (fread(h, 4, 4, f) != 4) break;
+        c.tag = h[0]; c.a = h[1]; c.b = h[2]; c.size = h[3]; c.data = NULL;
+        if (c.size) { c.data = (uint8_t*)malloc(c.size); if (fread(c.data, 1, c.size, f) != c.size) { free(c.data); break; } }
+        if (n == cap) { cap = cap ? cap * 2 : 64; ch = (jr_chunk*)realloc(ch, cap * sizeof *ch); }
+        ch[n++] = c;
+        if (c.tag == 4) break;
+    }
+    fclose(f);
+    const jr_chunk *start = NULL, *end = NULL, *cst = NULL, *sst = NULL;
+    int gets = 0, puts = 0, incomplete = 0;
+    for (int i = 0; i < n; i++) {
+        if (ch[i].tag == 1) start = &ch[i];
+        else if (ch[i].tag == 5) end = &ch[i];
+        else if (ch[i].tag == 2) gets++;
+        else if (ch[i].tag == 3) puts++;
+        else if (ch[i].tag == 6) incomplete = 1;
+        else if (ch[i].tag == 7 && ch[i].size >= 12) cst = &ch[i];
+        else if (ch[i].tag == 8 && ch[i].size == g_spu_jobcap_state_size && g_spu_jobcap_state_load) sst = &ch[i];
+    }
+    const size_t st_size = sizeof(((spu_context*)0)->gpr) + SPU_LS_SIZE;
+    int rc = 0;
+    if (!start || start->size != st_size) { fprintf(stderr, "[jobreplay] %s: no start state\n", path); rc = 2; goto out; }
+    /* the job's inputs, where it reads them */
+    const uint32_t* cs = cst ? (const uint32_t*)cst->data : NULL;
+    const int ctx_image = cs ? (int)cs[0] : (int)start->a;
+    double* t = (double*)malloc(sizeof(double) * (reps > 0 ? reps : 1));
+    spu_context* ctx = (spu_context*)calloc(1, sizeof(spu_context));
+    uint8_t* ls0 = NULL;
+    int ls_diff = 0, reg_diff = 0, put_diff = 0, first_ranges = 0;
+    char ranges[256] = "";
+    for (int r = 0; r < reps; r++) {
+        /* the job's inputs, where it reads them, before every run: a run's own PUTs (its output ring's
+         * allocator line, for one) would otherwise change what the next run finds */
+        for (int i = n - 1; i >= 0; i--)            /* the earliest GET of a range wins */
+            if (ch[i].tag == 2) memcpy(vm_base + ch[i].b, ch[i].data, ch[i].size);
+        spu_context_init(ctx, 0);
+        ctx->image_id = ctx_image;
+        ctx->resident_ovl = cs ? (int)cs[1] : 0;
+        ctx->resident_task = cs ? (int)cs[2] : 0;
+        memcpy(ctx->gpr, start->data, sizeof ctx->gpr);
+        memcpy(ctx->ls, start->data + sizeof ctx->gpr, SPU_LS_SIZE);
+        if (sst) g_spu_jobcap_state_load(ctx, sst->data);
+        { /* SPU_JOBREPLAY_CODE=<ea hex>:<lsa hex>:<size hex>: the job's streamed code is already in the local
+           * store (its manager fetched it before the record started), so tell the runtime it is resident, as
+           * that GET did in the game -- else the code runs through the self-modifying-code path and the
+           * interpreter (the idea of ps3kit's replay_reclaim). */
+          static int nc = -1; static uint32_t c_ea, c_lsa, c_size;
+          if (nc < 0) { const char* e = getenv("SPU_JOBREPLAY_CODE"); nc = 0;
+                        if (e && sscanf(e, "%x:%x:%x", &c_ea, &c_lsa, &c_size) == 3) nc = 1; }
+          if (nc) { extern void spu_overlay_note_get(spu_context*, uint32_t, const uint8_t*, uint32_t);
+                    spu_overlay_note_get(ctx, c_ea, ctx->ls + (c_lsa & SPU_LS_MASK), c_size); } }
+        { static int noirq = -1; if (noirq < 0) noirq = getenv("SPU_JOBREPLAY_NOIRQ") ? 1 : 0;
+          if (noirq) { ctx->int_enable = 0; ctx->event_status = 0; } }   /* the manager's interrupt handler stays out */
+        ctx->policy_mode = 1;                                  /* the job runs inside its manager's context */
+        ctx->status = SPU_STATUS_RUNNING;
+        ctx->pc = entry;
+        spu_lifted_fn fn = spu_lookup(entry, image);
+        s_replay_fn = fn; s_replay_ret = start->b;             /* the recorded link (r0 at entry) */
+        if (!fn) { fprintf(stderr, "[jobreplay] %s: no lifted code at 0x%05X (image %d)\n", path, entry, image); rc = 2; break; }
+        for (int i = 0; i < 512; i++) { free(s_dma[i].data); s_dma[i].data = NULL; }
+        s_ndma = 0;
+        g_spu_jobreplay_dma = jr_on_dma; g_spu_jobreplay_ctx = ctx; g_spu_jobcap_live = 1;
+        s_dma_limit = 2 * (gets + puts) + 16; s_stalled = 0; s_keep = (r == 0);
+        if (cs) {   /* the decrementer counts on from the recorded value, from now */
+            extern uint64_t spu_host_ns_pub(void);
+            ctx->decrementer = cs[3]; ctx->dec_base_ns = spu_host_ns_pub();
+        }
+        extern volatile uint64_t g_spu_interp_calls;
+        const uint64_t ic0 = g_spu_interp_calls;
+        const double t0 = jr_now_us();
+        spu_run_with_halt(jr_entry, ctx);
+        t[r] = jr_now_us() - t0;
+        g_spu_jobreplay_ctx = 0;
+        if (s_stalled) { fprintf(stderr, "[jobreplay] %s: STALL (more than %d DMAs; not repeated)%c", path, s_dma_limit, 10);
+                                   reps = 1; }
+        if (r == 0 && g_spu_interp_calls != ic0)
+            fprintf(stderr, "[jobreplay]   interpreter entered %llu times\n", (unsigned long long)(g_spu_interp_calls - ic0));
+        if (r == 0) {   /* the job's DMAs against the record's, in order */
+            int k = 0, same = 0, first_bad = -1; char why[160] = "";
+            for (int i = 0; i < n; i++) if (ch[i].tag == 2 || ch[i].tag == 3) {
+                const int put = ch[i].tag == 3;
+                if (k < s_ndma && s_dma[k].put == put && s_dma[k].ea == ch[i].b && s_dma[k].size == ch[i].size &&
+                    (!put || !memcmp(s_dma[k].data, ch[i].data, ch[i].size))) same++;
+                else if (first_bad < 0) {
+                    first_bad = k;
+                    if (k < s_ndma) snprintf(why, sizeof why, " first: rec %s ea=%08X+%X, replay %s ea=%08X+%X",
+                        put ? "PUT" : "GET", ch[i].b, ch[i].size, s_dma[k].put ? "PUT" : "GET", s_dma[k].ea, s_dma[k].size);
+                    else snprintf(why, sizeof why, " first: rec %s ea=%08X+%X, replay none", put ? "PUT" : "GET", ch[i].b, ch[i].size);
+                }
+                k++;
+            }
+            fprintf(stderr, "[jobreplay]   dma: record %d, replay %d, same %d%s\n", gets + puts, s_ndma, same, why);
+        }
+        if (r == 0 && end && end->size == st_size) {
+            const uint8_t* els = end->data + sizeof ctx->gpr;
+            for (uint32_t o = 0; o < SPU_LS_SIZE; o++) {
+                if (ctx->ls[o] != els[o]) {
+                    ls_diff++;
+                    if (first_ranges < 6 && (o == 0 || ctx->ls[o - 1] == els[o - 1])) {
+                        uint32_t e2 = o; while (e2 < SPU_LS_SIZE && ctx->ls[e2] != els[e2]) e2++;
+                        const size_t l = strlen(ranges);
+                        snprintf(ranges + l, sizeof ranges - l, " %05X+%X", o, e2 - o);
+                        first_ranges++;
+                    }
+                }
+            }
+            const u128* eg = (const u128*)end->data;
+            for (int k = 0; k < 128; k++) if (memcmp(&ctx->gpr[k], &eg[k], 16)) reg_diff++;
+            /* PUTs: the last write to each byte, as left in guest memory */
+            for (int i = 0; i < n; i++) if (ch[i].tag == 3) {
+                for (uint32_t o = 0; o < ch[i].size; o++) {
+                    int later = 0;
+                    for (int j = i + 1; j < n && !later; j++)
+                        if (ch[j].tag == 3 && ch[i].b + o >= ch[j].b && ch[i].b + o < ch[j].b + ch[j].size) later = 1;
+                    if (!later && vm_base[ch[i].b + o] != ch[i].data[o]) put_diff++;
+                }
+            }
+        }
+    }
+    if (!rc) {
+        qsort(t, reps, sizeof(double), jr_cmp_d);
+        const double med = t[reps / 2];
+        const int diff = end && (ls_diff || reg_diff || put_diff);
+        fprintf(stderr, "[jobreplay] %s: %s%s gets=%d puts=%d ls_diff=%d%s regs=%d put_bytes=%d  %.2f us (min %.2f p90 %.2f max %.2f)\n",
+                path, !end ? "NOEND" : diff ? "DIFF" : "ok", incomplete ? " (incomplete)" : "",
+                gets, puts, ls_diff, ranges, reg_diff, put_diff, med, t[0], t[(reps * 9) / 10], t[reps - 1]);
+        if (diff) (*ndiff)++;
+        *tsum += med; (*njobs)++;
+        rc = diff;
+    }
+    free(t); free(ctx); free(ls0);
+out:
+    for (int i = 0; i < n; i++) free(ch[i].data);
+    free(ch);
+    return rc;
+}
+
+int spu_jobreplay_main(void)
+{
+    const char* e = getenv("SPU_JOBREPLAY");
+    if (!e || !*e) return -1;
+    char dir[480]; int reps = 10, first = 0, count = 100000;
+    { char tmp[600]; strncpy(tmp, e, sizeof tmp - 1); tmp[sizeof tmp - 1] = 0;
+      char* p = strchr(tmp, ','); if (p) { *p++ = 0; reps = atoi(p);
+        char* q = strchr(p, ','); if (q) { *q++ = 0; first = atoi(q);
+          char* s = strchr(q, ','); if (s) count = atoi(s + 1); } }
+      strncpy(dir, tmp, sizeof dir - 1); dir[sizeof dir - 1] = 0; }
+    if (reps < 1) reps = 1;
+    int ndiff = 0, njobs = 0; double tsum = 0;
+    for (int k = first; k < first + count; k++) {
+        char path[600]; snprintf(path, sizeof path, "%s/job_%05d.gjc", dir, k);
+        const int r = jr_job(path, reps, &ndiff, &tsum, &njobs);
+        if (r < 0) break;
+    }
+    fprintf(stderr, "[jobreplay] %d jobs, %d differ, mean %.2f us a job\n", njobs, ndiff, njobs ? tsum / njobs : 0.0);
+    return ndiff ? 1 : 0;
+}
+
diff --git a/runtime/spu/spu_workload.c b/runtime/spu/spu_workload.c
index 3ce8d0d6..e0ce995c 100644
--- a/runtime/spu/spu_workload.c
+++ b/runtime/spu/spu_workload.c
@@ -1292,6 +1292,33 @@ static void spu_signalled_update(uint32_t taskset_ea, uint32_t taskId, int set)
     spu_lockline_unlock();
 }
 
+/* Test-and-clear a task's `signalled` bit in one lock-line section: the waiter
+ * consumes the signal at the moment it sees it, as the SPURS kernel does when it
+ * resumes a signalled task. Seeing the bit and clearing it later lost every
+ * signal that landed in between -- God of War III's five MLAA tasks signal one
+ * another several times a frame, and two of them skipped their share of a frame
+ * that way, so its completion counter never reached zero. Returns 1 if a signal
+ * was pending. Must not be called with s_sig_lock held (lock order). */
+static int spu_signalled_take(uint32_t taskset_ea, uint32_t taskId)
+{
+    extern void spu_lockline_lock(void); extern void spu_lockline_unlock(void);
+    extern void spu_coh_notify_write(uint32_t);
+    extern uint8_t* vm_base;
+    const uint32_t word = taskset_ea + CSTS_SIGNALLED + (taskId / 32u) * 4u;
+    const uint32_t mask = (1u << 31) >> (taskId % 32u);
+    uint8_t* p = vm_base + word;
+    spu_lockline_lock();
+    uint32_t v = ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+    const int had = (v & mask) != 0;
+    if (had) {
+        v &= ~mask;
+        p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+        spu_coh_notify_write(word);
+    }
+    spu_lockline_unlock();
+    return had;
+}
+
 /* Wake WAIT_SIGNAL sleepers when the signalled line is written, including by
  * guest SPU/PPU atomics that bypass spu_taskset_signal_task. Coherence calls
  * this with lock-line held; the guest bit remains the only predicate. */
@@ -1443,9 +1470,15 @@ int spu_taskset_wait_signal(uint32_t taskset_ea, uint32_t taskId)
     spu_coh_watch_add(&watch, taskset_ea + CSTS_SIGNALLED, spu_taskset_wake_written, NULL);
     spu_lockline_unlock();
 #ifdef _WIN32
-    AcquireSRWLockExclusive(&s_sig_lock);
-    while (!spurs_bitset_test(taskset_ea + CSTS_SIGNALLED, taskId)) {
-        if (!SleepConditionVariableSRW(&s_sig_cv, &s_sig_lock, 1000, 0)) {
+    /* Take the signal (test-and-clear under the lock-line) outside s_sig_lock; sleep
+     * only after re-testing under it, so a set + broadcast cannot slip between. */
+    while (!spu_signalled_take(taskset_ea, taskId)) {
+        AcquireSRWLockExclusive(&s_sig_lock);
+        int slept = 1;
+        if (!spurs_bitset_test(taskset_ea + CSTS_SIGNALLED, taskId))
+            slept = SleepConditionVariableSRW(&s_sig_cv, &s_sig_lock, 1000, 0);
+        ReleaseSRWLockExclusive(&s_sig_lock);
+        if (!slept) {
