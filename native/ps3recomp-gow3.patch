index 00000000..b2047997
--- /dev/null
+++ b/tools/spu_float_inputs.py
@@ -0,0 +1,302 @@
+#!/usr/bin/env python3
+"""Mark the float-op operands that need the extended-range clamp (spu_helpers.h SPU_AX_CLAMP).
+
+In SPU_AX_CLAMP the approximate fa/fs/fm/fma/fms/fnms clamp their result to +-FLT_MAX (a host Inf or
+NaN never leaves them) and clamp an operand only where the lifted source wraps it in SPU_AXI(): an
+operand that is the result of another of those ops is already in range, and clamping it again is
+two instructions on the critical path of every fma chain. This pass wraps every other operand.
+
+It works on lifted C (spu_lifter.py output, with or without spu_reg_locals.py) one function at a time,
+line by line, and knows a register is "in range" only from an earlier line of the same straight run:
+a label, a call, a branch out or any line it does not recognise forgets everything, so a value that
+arrives by another path is always clamped. Outside SPU_AX_CLAMP, SPU_AXI(x) is x.
+"""
+from __future__ import annotations
+
+import re
+import sys
+
+_REG = r"(?:r_\d+|ctx->gpr\[\d+\])"
+_FOPS = ("spu_fa", "spu_fs", "spu_fm", "spu_fma", "spu_fms", "spu_fnms")
+_FLOAT_ASSIGN = re.compile(rf"^(\s*)({_REG}) = ({'|'.join(_FOPS)})\(({_REG}(?:, {_REG})*)\);\s*$")
+# Producers whose result is a finite float the clamp would leave alone (integer -> float conversions).
+_SANE_ASSIGN = re.compile(rf"^\s*({_REG}) = (?:spu_cuflt|spu_csflt)\(")
+_ASSIGN = re.compile(rf"^\s*({_REG}) = [^;]*;\s*$")
+_CALLISH = re.compile(r"\b(?:SPU_DIRECT|SPU_RET|SPU_RET_REG|spu_indirect_branch|spu_drain_call|spu_stop|spu_halt|"
+                      r"spu_wrch|spu_rdch|spu_rchcnt|return|goto)\b|g_spu_trampoline_fn")
+_LABEL = re.compile(r"^\s*\w+:\s*$")
+_IFGOTO = re.compile(r"^if \([^{};]*\) goto \w+;$")   # a plain conditional branch, nothing else on the line
+_FUNC = re.compile(r"^\w[\w\s\*]*\(spu_context\* ctx\)\s*\{\s*$")
+
+
+def mark_body(lines: list[str]) -> tuple[list[str], int]:
+    sane: set[str] = set()
+    out, wrapped = [], 0
+    for raw in lines:
+        s = raw.strip()
+        m = _FLOAT_ASSIGN.match(raw)
+        if m:
+            ind, dst, op, args = m.groups()
+            new = []
+            for a in args.split(", "):
+                if a in sane:
+                    new.append(a)
+                else:
+                    new.append(f"SPU_AXI({a})"); wrapped += 1
+            out.append(f"{ind}{dst} = {op}({', '.join(new)});")
+            sane.add(dst)
+            continue
+        out.append(raw)
+        if not s or s.startswith("/*") and s.endswith("*/;") or s.startswith("SPU_LSW("):
+            continue                                   # comment / store: no register changes
+        if _IFGOTO.match(s):
+            continue                                   # a branch out of the run changes nothing here
+        if _LABEL.match(raw) or _CALLISH.search(s) or "{" in s or "}" in s:
+            sane.clear()
+            continue
+        m2 = _SANE_ASSIGN.match(raw)
+        if m2:
+            sane.add(m2.group(1)); continue
+        m3 = _ASSIGN.match(raw)
+        if m3:
+            sane.discard(m3.group(1)); continue
+        sane.clear()                                   # anything else: forget
+    return out, wrapped
+
+
+_LOCAL = re.compile(r"\br_(\d+)\b")
+_LOCAL_FLOAT = re.compile(rf"^(\s*)r_(\d+) = ({'|'.join(_FOPS)})\(((?:SPU_AX[IL]\()?r_\d+\)?(?:, (?:SPU_AX[IL]\()?r_\d+\)?)*)\);\s*$")
+_LOCAL_ASSIGN = re.compile(r"^\s*r_(\d+) = [^;{}]*;\s*$")
+_GOTO = re.compile(r"^goto (\w+);$")
+_IFGOTO_L = re.compile(r"^if \(([^{};]*)\) goto (\w+);$")
+_ALL = "*"
+
+
+def _node(raw: str):
+    """(written local or None, locals read as float operands, other locals read or _ALL, jump label,
+    falls through)."""
+    s = raw.strip()
+    if not s or s.startswith("/*") and s.endswith("*/;") or _LABEL.match(raw):
+        return None, (), (), None, True
+    m = _LOCAL_FLOAT.match(raw)
+    if m:
+        return int(m.group(2)), tuple(int(x) for x in _LOCAL.findall(m.group(4))), (), None, True
+    g = _GOTO.match(s)
+    if g:
+        return None, (), (), g.group(1), False
+    g = _IFGOTO_L.match(s)
+    if g and "ctx" not in g.group(1):
+        return None, (), tuple(int(x) for x in _LOCAL.findall(g.group(1))), g.group(2), True
+    if "ctx->gpr" in s or _CALLISH.search(s) or "{" in s or "}" in s:
+        return None, (), _ALL, None, True        # a store-back, call or leaving block reads everything
+    if s.startswith("SPU_LSW("):
+        return None, (), tuple(int(x) for x in _LOCAL.findall(s)), None, True
+    m = _LOCAL_ASSIGN.match(raw)
+    if m:
+        return int(m.group(1)), (), tuple(int(x) for x in _LOCAL.findall(s.split("=", 1)[1])), None, True
+    return None, (), _ALL, None, True
+
+
+def unclamp_chains(lines: list[str]) -> tuple[list[str], int]:
+    """In a function on register locals (spu_reg_locals.py), use the unclamped form (spu_fma_u ...) of a
+    float op whose result, on every path until the register is written again, is read only as an operand
+    of another of these ops. That op clamps its own result, so only an intermediate that overflowed to
+    +-Inf (or became NaN) on the host can differ from the clamped chain, and it still leaves the chain as
+    +-FLT_MAX (a NaN as -FLT_MAX). The two clamp instructions were on the critical path of every fma
+    chain. A store-back, call, branch out or unrecognised line counts as reading every register."""
+    if not lines or "u128 r_" not in lines[0]:
+        return lines, 0
+    nodes = [_node(l) for l in lines]
+    nodes[0] = (None, (), (), None, True)        # the entry loads
+    labels = {l.strip()[:-1]: k for k, l in enumerate(lines) if _LABEL.match(l)}
+    succ = []
+    for _, _, _, jl, ft in nodes:
+        if jl is not None and jl not in labels:
+            succ.append(None)                     # a jump this pass cannot follow
+            continue
+        succ.append(([len(succ) + 1] if ft else []) + ([labels[jl]] if jl is not None else []))
+
+    def float_only(k0: int, reg: int) -> bool:
+        seen, stack = set(), [k0 + 1]
+        while stack:
+            k = stack.pop()
+            if k in seen:
+                continue
+            seen.add(k)
+            if k >= len(nodes) or succ[k] is None:
+                return False                      # falls off the end / unknown jump
+            d, _, other, _, _ = nodes[k]
+            if other == _ALL or reg in other:
+                return False
+            if d == reg:
+                continue                          # written again (its operands are read first)
+            stack.extend(succ[k])
+        return True
+
+    out, n = list(lines), 0
+    for k, (d, fops, _, _, _) in enumerate(nodes):
+        if d is not None and fops and float_only(k, d):
+            m = _LOCAL_FLOAT.match(lines[k])
+            out[k] = lines[k].replace(f"= {m.group(3)}(", f"= {m.group(3)}_u(", 1)
+            n += 1
+    return out, n
+
+
+_COPY = re.compile(r"^\s*r_(\d+) = spu_(?:ori|shlqbyi|rotqbyi|shlqbii|rotqbii)\(r_(\d+), 0\);\s*$")
+_ASSIGNED = re.compile(r"\br_(\d+) = ")
+_GOTO_ANY = re.compile(r"\bgoto (\w+);")
+_NOFALL = re.compile(r"^(?:goto \w+;|SPU_RET(?:_REG)?\(.*\);|\{ SPU_DIRECT\(.*\); \}|SPU_DIRECT\(.*\);|return;)$")
+
+
+_CONST = re.compile(r"^\s*r_(\d+) = spu_(il|ilh|ilhu|fsmbi)\((-?(?:0x)?[0-9A-Fa-f]+)\);\s*$")
+_CLEARS = re.compile(r"^\s*r_(\d+) = spu_(and|andc)\(r_(\d+), r_(\d+)\);\s*$")
+_MOVES = re.compile(r"^\s*r_(\d+) = spu_(shufb|selb|rotqbyi|shlqbyi|rotqby|shlqby|rotqbybi|shlqbybi)\(r_(\d+(?:, r_\d+)*)(?:, -?\d+)?\);\s*$")
+
+
+def _const_in_range(op: str, v: str) -> bool:
+    """The constant's words have a biased exponent below 255 (in range for the float ops)."""
+    x = int(v, 0)
+    if op == "il":
+        w = x & 0xFFFFFFFF
+    elif op == "ilh":
+        w = ((x & 0xFFFF) << 16) | (x & 0xFFFF)
+    elif op == "ilhu":
+        w = (x & 0xFFFF) << 16
+    else:   # fsmbi: a byte of 0xFF per mask bit; a word is out of range only with its two high bytes 0xFF
+        return all(((x >> (14 - 4 * k)) & 3) != 3 for k in range(4))
+    return ((w >> 23) & 0xFF) != 0xFF
+
+
+_LSLOAD = re.compile(r"^\s*r_(\d+) = SPU_LSR\(ctx, _ls, [^;]*\);\s*$")
+
+
+def mark_body_flow(lines: list[str], ls_assumed: bool = False) -> tuple[list[str], int]:
+    """mark_body for a function on register locals (spu_reg_locals.py), across labels and copies: a register
+    is in range at a line when it is on every path from the entry (forward dataflow, meet = intersection).
+    A local only changes where the C source assigns it, so a call, store-back or block line only forgets the
+    locals it assigns (a reload after a call); a copy (ori/shlqbyi/rotqbyi by 0) keeps its source's state.
+    The loop-carried values of the software-pipelined EDGE loops (copied with shlqbyi at the bottom, read
+    after the loop label) were all clamped again by mark_body."""
+    n = len(lines)
+    labels = {l.strip()[:-1]: k for k, l in enumerate(lines) if _LABEL.match(l)}
+    if "&r_" in "\n".join(lines):
+        return mark_body(lines)
+    info = []
+    for raw in lines:
+        s = raw.strip()
+        m = _FLOAT_ASSIGN.match(raw)
+        if m and m.group(2).startswith("r_"):
+            info.append(("f", int(m.group(2)[2:]), None)); continue
+        m = _COPY.match(raw)
+        if m:
+            info.append(("c", int(m.group(1)), int(m.group(2)))); continue
+        m = _SANE_ASSIGN.match(raw)
+        if m and m.group(1).startswith("r_"):
+            info.append(("f", int(m.group(1)[2:]), None)); continue
+        m = _LSLOAD.match(raw)
+        if m and ls_assumed:
+            info.append(("l", int(m.group(1)), None)); continue
+        m = _CONST.match(raw)
+        if m:
+            info.append(("f" if _const_in_range(m.group(2), m.group(3)) else "k",
+                         int(m.group(1)) if _const_in_range(m.group(2), m.group(3)) else (int(m.group(1)),), None)); continue
+        m = _CLEARS.match(raw)
+        if m:   # and / andc only clear bits of their first operand (and also of the second): exact
+            d, op, a, b = int(m.group(1)), m.group(2), int(m.group(3)), int(m.group(4))
+            info.append(("a", d, (a, b) if op == "and" else (a,))); continue
+        m = _MOVES.match(raw)
+        if m and ls_assumed:   # moves words of in-range inputs around: assumed (the control is not known)
+            d = int(m.group(1)); srcs = tuple(int(x) for x in m.group(3).split(", r_"))
+            info.append(("m", d, srcs[:2] if m.group(2) in ("shufb", "selb") else srcs[:1])); continue
+        info.append(("k", tuple(int(x) for x in _ASSIGNED.findall(s)), None))
+    succ = []
+    for k, raw in enumerate(lines):
+        s = raw.strip()
+        tg = [labels[g] for g in _GOTO_ANY.findall(s) if g in labels]
+        fall = not _NOFALL.match(s) and k + 1 < n
+        succ.append(tg + ([k + 1] if fall else []))
+    # The state is a pair: (in range on every path, in range or straight from an LS load on every path).
+    # The second set only matters with ls_assumed: an operand in it but not in the first gets SPU_AXL(), the
+    # mark of "a value loaded from LS, assumed in range" (spu_helpers.h decides what it does).
+    full = None                                   # "top" (not reached yet)
+    state_in = [full] * n
+    state_in[0] = (frozenset(), frozenset())
+    work = [0]
+
+    def one(st, kind, d, src, ls):
+        if kind == "f":
+            return st | {d}
+        if kind == "l":
+            return (st | {d}) if ls else (st - {d})
+        if kind == "a":
+            return (st | {d}) if any(x in st for x in src) else (st - {d})
+        if kind == "m":
+            return (st | {d}) if ls and all(x in st for x in src) else (st - {d})
+        if kind == "c":
+            return (st | {d}) if src in st else (st - {d})
+        return st - set(d) if d else st
+
+    def transfer(k, st):
+        kind, d, src = info[k]
+        return (one(st[0], kind, d, src, False), one(st[1], kind, d, src, True))
+
+    while work:
+        k = work.pop()
+        out = transfer(k, state_in[k])
+        for j in succ[k]:
+            old = state_in[j]
+            new = out if old is None else (old[0] & out[0], old[1] & out[1])
+            if old is None or new != old:
+                state_in[j] = (frozenset(new[0]), frozenset(new[1]))
+                work.append(j)
+    res, wrapped = [], 0
+    for k, raw in enumerate(lines):
+        m = _FLOAT_ASSIGN.match(raw)
+        if not m:
+            res.append(raw); continue
+        ind, dst, op, args = m.groups()
+        st, stl = state_in[k] or (frozenset(), frozenset())
+        new = []
+        for a in args.split(", "):
+            if a.startswith("r_") and int(a[2:]) in st:
+                new.append(a)
+            elif a.startswith("r_") and int(a[2:]) in stl:
+                new.append(f"SPU_AXL({a})")
+            else:
+                new.append(f"SPU_AXI({a})"); wrapped += 1
+        res.append(f"{ind}{dst} = {op}({', '.join(new)});")
+    return res, wrapped
+
+
+def mark_float_inputs(src: str, chains: bool = False, flow: bool = False, ls_assumed: bool = False) -> tuple[str, int]:
+    """Whole translation unit: returns the rewritten source and how many operands were wrapped.
+    chains=True also applies unclamp_chains to every function. (Leaving every result unclamped, only the
+    SPU_AXI operands clamped, was measured slower in God of War III: 44.7 us per EDGE job against 42.3.)"""
+    lines = src.split("\n")
+    out, total, i = [], 0, 0
+    while i < len(lines):
+        out.append(lines[i])
+        if _FUNC.match(lines[i]):
+            j = i + 1
+            while j < len(lines) and lines[j] != "}":
+                j += 1
+            body = lines[i + 1:j]
+            if flow and body and "u128 r_" in body[0]:
+                body, n = mark_body_flow(body, ls_assumed)
+            else:
+                body, n = mark_body(body)
+            if chains:
+                body, _ = unclamp_chains(body)
+            out.extend(body); total += n
+            i = j
+            continue
+        i += 1
+    return "\n".join(out), total
+
+if __name__ == "__main__":
+    for p in sys.argv[1:]:
+        with open(p, encoding="utf-8") as f:
+            text, n = mark_float_inputs(f.read())
+        with open(p, "w", encoding="utf-8", newline="\n") as f:
+            f.write(text)
+        print(f"{p}: {n} operands wrapped")
