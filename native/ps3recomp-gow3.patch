+++ b/tools/spu_reg_locals.py
@@ -0,0 +1,245 @@
+#!/usr/bin/env python3
+"""
+Keep SPU registers in C locals inside each lifted function (spu_lifter.py
+--reg-locals, or standalone on an already generated spu_recomp.c).
+
+The lifter writes every guest register access as ``ctx->gpr[N]``. ctx->gpr is
+a u128 union in memory, and clang gives union accesses char ("may alias
+anything") TBAA, so every result is stored and every operand reloaded: a
+vertex-transform loop of fm/fma/shufb becomes a stream of 16-byte loads and
+stores. This pass rewrites a function body to work on ``u128 r_N`` locals:
+
+  * entry: ``u128 r_N = ctx->gpr[N];`` for every register the body touches
+    (the compiler drops the ones overwritten before being read);
+  * pure lines (register arithmetic, LS loads/stores, branches inside the
+    function) use the locals, and LS accesses a cached ctx->ls (SPU_LSR/SPU_LSW);
+  * an escape line -- anything else that touches ctx (calls, channels, stop,
+    dispatch, tail branches, SPU_RET...) or returns -- is kept verbatim on
+    ctx->gpr: the written locals are stored back before it and every local is
+    reloaded after it (the callee may change any register);
+  * ``if (cond) { ... }`` whose block always leaves the function (conditional
+    tail branch or return) stores back inside the block only, so the not-taken
+    path of a loop costs nothing.
+
+A known-target branch (SPU_DIRECT) to an address whose label is in this body
+-- the function's own entry (the lifter starts a new function at a loop header
+that is also a function entry, so the back edge is a tail call to itself) or
+the entry of a chunk spu_inline_fallthrough.py fused in -- becomes a goto while
+SPU_DIRECT_LOCAL_OK holds (the same per-hop checks SPU_DIRECT makes before its
+tail call); otherwise it stores back and takes SPU_DIRECT as before. Each pass
+of such a loop then keeps its registers in the locals instead of storing and
+reloading all of them.
+
+Labels stay where they are; gotos only jump inside the function, where the
+locals are the registers. LS debug probes that log ctx->gpr[0] can see a stale
+value while a function runs; nothing else reads ctx->gpr behind the code.
+"""
+
+import re
+import sys
+
+_GPR = re.compile(r"ctx->gpr\[(\d+)\]")
+_SIG = re.compile(r"^void \w*?(?:_spu_func_([0-9A-Fa-f]{8}))?\(spu_context\* ctx\) \{$")
+_ASSIGN = re.compile(r"ctx->gpr\[(\d+)\] = ")
+# Accesses that only read/write LS bytes, never ctx->gpr or control flow.
+_SAFE_CTX = re.compile(r"ctx->gpr\[\d+\]|spu_ls_read128\(ctx,|spu_ls_write128\(ctx,")
+_LEAVES = ("SPU_DIRECT(", "SPU_RET(", "SPU_RET_REG(", "SPU_TAILCALL(")
+
+
+def _is_escape(stmt: str) -> bool:
+    rest = _SAFE_CTX.sub("", stmt)
+    return (re.search(r"\bctx\b", rest) is not None or "return" in rest
+            or "jmp" in rest)
+
+
+def _calls(expr: str) -> bool:
+    """A condition that calls something (reads of ctx fields are fine)."""
+    return re.search(r"\w\s*\(", _SAFE_CTX.sub("", expr)) is not None
+
+
+def _local(stmt: str) -> str:
+    stmt = _GPR.sub(lambda m: f"r_{m.group(1)}", stmt)
+    # LS accesses on the cached LS pointer (SPU_LSR/SPU_LSW, spu_context.h): a byte store may alias
+    # ctx->ls, so through ctx it is reloaded after every stqd.
+    return (stmt.replace("spu_ls_read128(ctx, ", "SPU_LSR(ctx, _ls, ")
+                .replace("spu_ls_write128(ctx, ", "SPU_LSW(ctx, _ls, "))
+
+
+_DIRECT = re.compile(r"^\{?\s*SPU_DIRECT\(ctx, 0x([0-9A-Fa-f]+), \w+\);\s*\}?$")
+_LABEL = re.compile(r"^loc_([0-9A-Fa-f]{8}):$")
+
+
+def _local_direct(stmt: str, labels: set[int]):
+    """The target of `{ SPU_DIRECT(ctx, PC, FN); }` when PC has a label in this body."""
+    m = _DIRECT.match(stmt.strip())
+    if m and int(m.group(1), 16) in labels:
+        return int(m.group(1), 16)
+    return None
+
+
+def _always_leaves(block: str) -> bool:
+    """True when a `{ ... }` block body ends by leaving the function."""
+    b = block.strip()
+    if b.startswith("{") and b.endswith("}"):
+        b = b[1:-1].strip()
+    last = b.rstrip("; ").rsplit(";", 1)[-1].strip() if b else ""
+    if last.startswith("{"):              # `{ SPU_DIRECT(...); }`
+        return _always_leaves(last)
+    return (b.endswith("return;") or any(last.startswith(k) for k in _LEAVES))
+
+
+def _split_if(stmt: str):
+    """`if (cond) { block }` -> (cond, block) when the statement is exactly that."""
+    if not stmt.startswith("if (") or not stmt.endswith("}"):
+        return None
+    depth = 0
+    for i in range(3, len(stmt)):
+        c = stmt[i]
+        if c == "(":
+            depth += 1
+        elif c == ")":
+            depth -= 1
+            if depth == 0:
+                cond, rest = stmt[4:i], stmt[i + 1:].strip()
+                if not rest.startswith("{"):
+                    return None
+                # the block must be one brace group spanning to the end
+                d = 0
+                for j, ch in enumerate(rest):
+                    d += ch == "{"
+                    d -= ch == "}"
+                    if d == 0 and j != len(rest) - 1:
+                        return None
+                return cond, rest
+    return None
+
+
+# Big functions with many calls in the middle hurt more than they gain: every
+# fall-through escape reloads all the locals, and clang's optimizer goes
+# super-linear on long bodies full of u128 locals and gotos (whole job modules
+# took over 30 minutes each). Hot SPU loops are short and call nothing.
+MAX_LINES = 600
+MAX_ESCAPES = 8
+
+
+def localize_body(body: list[str], indent: str = "    ",
+                  max_lines: int = MAX_LINES, max_escapes: int = MAX_ESCAPES,
+                  entry: int | None = None) -> list[str]:
+    """Rewrite one function body (lines without the signature / closing brace).
+
+    entry is the function's SPU address: a branch back to it becomes a loop.
+    Returned unchanged when it is longer than max_lines or has more than
+    max_escapes fall-through escapes (0 = no limit)."""
+    if max_lines and len(body) > max_lines:
+        return body
+    labels = {int(m.group(1), 16) for m in (_LABEL.match(b.strip()) for b in body) if m}
+    entry_label = None
+    if entry is not None and entry not in labels:
+        labels.add(entry)
+        entry_label = f"loc_{entry:08X}:"
+    used: set[int] = set()
+    written: set[int] = set()
+    plan = []        # (kind, text)
+    for raw in body:
+        s = raw.strip()
+        if not s or s.endswith(":") and not s.startswith(("if", "{")) and " " not in s:
+            plan.append(("label", raw))
+            continue
+        if not _is_escape(s):
+            used.update(int(n) for n in _GPR.findall(s))
+            written.update(int(n) for n in _ASSIGN.findall(s))
+            plan.append(("pure", s))
+            continue
+        tgt = _local_direct(s, labels)
+        if tgt is not None:
+            plan.append(("direct", (tgt, s)))
+            continue
+        sp = _split_if(s)
+        if sp and _always_leaves(sp[1]) and not _calls(sp[0]):
+            used.update(int(n) for n in _GPR.findall(sp[0]))
+            plan.append(("ifleave", sp))
+            continue
+        plan.append(("escape", s))
+    if not used:
+        return body
+    if max_escapes and sum(k == "escape" for k, _ in plan) > max_escapes:
+        return body
+    if entry_label and not any(k == "direct" and t[0] == entry or
+                               k == "ifleave" and _local_direct(t[1].strip()[1:-1], labels) == entry
+                               for k, t in plan):
+        entry_label = None
+    regs = sorted(used)
+    wr = sorted(written)
+    flush = " ".join(f"ctx->gpr[{n}] = r_{n};" for n in wr)
+    uses_ls = any(k == "pure" and "spu_ls_" in s for k, s in plan)
+    reload = " ".join(f"r_{n} = ctx->gpr[{n}];" for n in regs) + (" _ls = ctx->ls;" if uses_ls else "")
+    out = [indent + " ".join(f"u128 r_{n} = ctx->gpr[{n}];" for n in regs)
+           + (" uint8_t* _ls = ctx->ls;" if uses_ls else "")]
+    if entry_label:
+        out.append(entry_label)
+    for kind, t in plan:
+        if kind == "label":
+            out.append(t)
+        elif kind == "pure":
+            out.append(indent + _local(t))
+        elif kind == "direct":
+            tgt, stmt = t
+            out.append(f"{indent}if (SPU_DIRECT_LOCAL_OK(ctx, 0x{tgt:X})) goto loc_{tgt:08X};")
+            if flush:
+                out.append(indent + flush)
+            out.append(indent + stmt)
+            out.append(indent + reload)
+        elif kind == "ifleave":
+            cond, block = t
+            inner = block.strip()[1:-1].strip()
+            tgt = _local_direct(inner, labels)
+            hop = f"if (SPU_DIRECT_LOCAL_OK(ctx, 0x{tgt:X})) goto loc_{tgt:08X}; " if tgt is not None else ""
+            out.append(f"{indent}if ({_local(cond)}) {{ {hop}{flush} {inner} }}")
+        else:
+            if flush:
+                out.append(indent + flush)
+            out.append(indent + t)
+            out.append(indent + reload)
+    return out
+
+
+def localize_source(text: str, max_lines: int = MAX_LINES, max_escapes: int = MAX_ESCAPES) -> str:
+    """Apply localize_body to every lifted function of a generated spu_recomp.c."""
+    lines = text.split("\n")
+    out = []
+    i = 0
+    while i < len(lines):
+        line = lines[i]
+        sig = _SIG.match(line)
+        if sig:
+            j = i + 1
+            while j < len(lines) and lines[j] != "}":
+                j += 1
+            body = lines[i + 1:j]
+            ind = "    "
+            for b in body:
+                if b.strip() and not b.strip().endswith(":"):
+                    ind = b[:len(b) - len(b.lstrip())]
+                    break
+            out.append(line)
+            out.extend(localize_body(body, ind, max_lines=max_lines, max_escapes=max_escapes,
+                                     entry=int(sig.group(1), 16) if sig.group(1) else None))
+            out.append("}")
+            i = j + 1
+            continue
+        out.append(line)
+        i += 1
+    return "\n".join(out)
+
+
+def main() -> None:
+    if len(sys.argv) != 3:
+        sys.exit("uso: spu_reg_locals.py <entrada.c> <saida.c>")
+    with open(sys.argv[1], encoding="utf-8") as f:
+        text = f.read()
+    with open(sys.argv[2], "w", encoding="utf-8", newline="\n") as f:
+        f.write(localize_source(text))
+
+
+if __name__ == "__main__":
+    main()
