@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""spu_inline_fallthrough.py: which SPU_DIRECT hops get the next chunk's body."""
+import unittest
+
+from spu_inline_fallthrough import inline_fallthrough
+
+
+def fn(addr, body):
+    return f"void m_spu_func_{addr:08X}(spu_context* ctx) {{\n" + "\n".join(body) + "\n}\n"
+
+
+def hop(addr):
+    return f"        {{ SPU_DIRECT(ctx, 0x{addr:X}, m_spu_func_{addr:08X}); }}"
+
+
+class InlineFallthrough(unittest.TestCase):
+    def test_preamble_gets_the_loop(self):
+        src = (fn(0x100, ["        ctx->gpr[3] = spu_il(1);", hop(0x110)]) +
+               fn(0x110, ["loc_00000110:", "        ctx->gpr[3] = spu_ai(ctx->gpr[3], -1);",
+                          "        if (ctx->gpr[3]._u32[0] != 0) goto loc_00000110;", hop(0x200)]) +
+               fn(0x200, ["        SPU_RET(ctx);"]))
+        out, n = inline_fallthrough(src)
+        first = out.split("void m_spu_func_00000110")[0]
+        self.assertIn("loc_00000110:", first)                  # the loop is in the preamble's function
+        self.assertIn("goto loc_00000110;", first)
+        self.assertIn("SPU_RET(ctx);", first)                 # and the next fall-through after it
+        self.assertIn("void m_spu_func_00000110", out)         # the loop keeps its own entry
+        self.assertEqual(n, 3)                                # 100<-110, 100<-200, 110<-200
+        self.assertIn("loc_00000200:", first)                  # inlined chunks keep their entry label
+        self.assertEqual(first.count("loc_00000110:"), 1)      # not doubled when the chunk has it
+
+    def test_jump_elsewhere_is_left_alone(self):
+        src = fn(0x100, [hop(0x300)]) + fn(0x110, ["        SPU_RET(ctx);"]) + fn(0x300, ["        SPU_RET(ctx);"])
+        out, n = inline_fallthrough(src)
+        self.assertEqual(n, 0)
+        self.assertEqual(out, src)
+
+    def test_limits(self):
+        big = ["        ctx->gpr[3] = spu_il(1);"] * 50
+        src = fn(0x100, big + [hop(0x110)]) + fn(0x110, big + [hop(0x120)]) + fn(0x120, ["        SPU_RET(ctx);"])
+        out, n = inline_fallthrough(src, max_lines=60)
+        self.assertNotIn("loc_", out.split("void m_spu_func_00000110")[0])
+        self.assertEqual(out.split("void m_spu_func_00000110")[0].count("SPU_DIRECT"), 1)
+        out, n = inline_fallthrough(src, max_depth=1)
+        self.assertEqual(out.split("void m_spu_func_00000110")[0].count("SPU_DIRECT(ctx, 0x120"), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
