+namespace rsx
+{
+	class thread;
+
+	static inline std::string_view location_tostring(u32 location)
+	{
+		constexpr const char* location_names[2] = { "CELL_GCM_LOCATION_LOCAL", "CELL_GCM_LOCATION_MAIN" };
+		return ::at32(location_names, location);
