+			}
+		}
+
+		bool has_compatible_format(vk::image* tex) const
+		{
+			return vram_texture->info.format == tex->info.format;
+		}
+
+		bool is_depth_texture() const
+		{
+			return !!(vram_texture->aspect() & VK_IMAGE_ASPECT_DEPTH_BIT);
+		}
+	};
