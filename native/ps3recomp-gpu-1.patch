+		{
+			site = site ? site : "other";
+			for (int i = 0; i < 8; i++)
+			{
+				if (!s_zs_site_names[i])
+					s_zs_site_names[i] = site;
+				if (s_zs_site_names[i] == site)
+				{
+					s_zs_site_count[i]++;
+					return;
+				}
+			}
+		}
