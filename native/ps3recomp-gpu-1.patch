diff --git a/gpu/rsx/Emu/RSX/NV47/HW/nv47_sync.hpp b/gpu/rsx/Emu/RSX/NV47/HW/nv47_sync.hpp
new file mode 100644
index 00000000..43ddc390
--- /dev/null
+++ b/gpu/rsx/Emu/RSX/NV47/HW/nv47_sync.hpp
@@ -0,0 +1,120 @@
+#pragma once
+
+#include "util/types.hpp"
+#include "Emu/RSX/RSXThread.h"
+#include "Emu/RSX/Host/MM.h"
+
+#include "context_accessors.define.h"
+
+// ps3recomp: told of every label the RSX writes to guest memory, so that a
+// host whose SPUs wait on lock-line reservations can wake them (gpu/bridge).
+extern void (*g_ps3recomp_rsx_write_hook)(u32 address, u32 size);
+// ps3recomp: before a GET_REPORT of a non-zcull type, the RSX waits (still
+// serving its flush requests) while this returns true.
+extern bool (*g_ps3recomp_rsx_report_hold)(u32 arg, u64 waited_us);
+// ps3recomp: just before the RSX writes a report. `awaited` when its last
+// word is nonzero: an SPU barrier waits for the RSX to zero it.
+extern void (*g_ps3recomp_rsx_report_hook)(u32 address, bool awaited);
+// ps3recomp: names the method behind an RSX sync for PS3_RSX_ZCULL_STATS (RSXZCULL.cpp)
+extern thread_local const char* g_ps3recomp_sync_site;
+// ps3recomp: the report hold's idle (gpu/bridge/ps3rsx_thread.cpp, PS3_RSX_HOLD_WAIT)
+extern "C" void ps3rsx_hold_kick(void);
+extern "C" unsigned long long ps3rsx_hold_seq(void);
+extern "C" void ps3rsx_hold_idle(unsigned long long seq, unsigned long long waited_us);
+// ps3recomp: RSX_FIFO_TIMELOG (gpu/bridge/ps3rsx_thread.cpp)
+extern "C" int ps3rsx_fifo_timelog_on(void);
+extern "C" void ps3rsx_fifo_timelog(const char* what, unsigned a, unsigned b, unsigned long long d_us);
+
+namespace rsx
+{
+	namespace util
+	{
+		template <bool FlushDMA, bool FlushPipe>
+		static void write_gcm_label(context* ctx, u32 type, u32 address, u32 data)
+		{
+			// Ensure atomic seq-cst memory ordering for FIFO GET updates
+			atomic_fence_seq_cst();
+
+			const bool is_flip_sema = (address == (RSX(ctx)->label_addr + 0x10) || address == (RSX(ctx)->device_addr + 0x30));
+			if (is_flip_sema && RSX(ctx)->defer_label(address, data, false))
+			{
+				// ps3recomp: behind a held label (ZCULL_control::defer_label)
+				return;
+			}
+
+			if (!is_flip_sema)
+			{
+				// First, queue the GPU work. If it flushes the queue for us, the following routines will be faster.
+				const bool handled = RSX(ctx)->get_backend_config().supports_host_gpu_labels && RSX(ctx)->release_GCM_label(type, address, data);
+
+				// ps3recomp: PS3_RSX_ZCULL_DEFER_LABEL=1 -- held until the ZCULL reports queued
+				// before it are written, instead of the RSX thread waiting on the GPU for them
+				if (!handled && RSX(ctx)->defer_label(address, data, FlushPipe && !g_ps3recomp_skip_zcull_sync))
+				{
+					if constexpr (FlushDMA)
+					{
+						rsx::mm_flush();
+						g_fxo->get<rsx::dma_manager>().sync();
+					}
+
+					if constexpr (FlushPipe)
+					{
+						RSX(ctx)->m_graphics_state |= rsx::pipeline_state::fragment_program_needs_rehash;
+
+						// The rest of the sync point, without the ZCULL wait
+						const bool skip = std::exchange(g_ps3recomp_skip_zcull_sync, true);
+						RSX(ctx)->sync();
+						g_ps3recomp_skip_zcull_sync = skip;
+					}
+
+					return;
+				}
+
+				if (vm::_ref<RsxSemaphore>(address) == data)
+				{
+					// It's a no-op to write the same value (although there is a delay in real-hw so it's more accurate to allow GPU label in this case)
+					// There is no possible way for the guest to know that the label has been processed so we can skip MM sync here.
+					return;
+				}
+
+				if constexpr (FlushDMA || FlushPipe)
+				{
+					if constexpr (FlushDMA)
+					{
+						// Release op must be acoompanied by MM flush.
+						// FlushPipe implicitly does a MM flush but FlushDMA does not. Trigger the flush here
+						rsx::mm_flush();
+
+						// If the backend handled the request, this call will basically be a NOP
+						g_fxo->get<rsx::dma_manager>().sync();
+					}
+
+					if constexpr (FlushPipe)
+					{
+						// Syncronization point, may be associated with memory changes without actually changing addresses
+						RSX(ctx)->m_graphics_state |= rsx::pipeline_state::fragment_program_needs_rehash;
+
+						// Manually flush the pipeline.
+						// It is possible to stream report writes using the host GPU, but that generates too much submit traffic.
+						g_ps3recomp_sync_site = "label";
+						RSX(ctx)->sync();
+						g_ps3recomp_sync_site = nullptr;
+					}
+				}
+
+				if (handled)
+				{
+					// Backend will handle it, nothing to write.
+					return;
+				}
+			}
+
+			vm::write<atomic_t<RsxSemaphore>>(address, data);
+
+			if (g_ps3recomp_rsx_write_hook) // ps3recomp
+				g_ps3recomp_rsx_write_hook(address, 4);
+		}
+	}
+}
+
+#include "context_accessors.undef.h"
