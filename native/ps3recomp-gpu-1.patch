+		{
+			VkColorComponentFlags mask = 0;
+			if (a) mask |= VK_COLOR_COMPONENT_A_BIT;
+			if (b) mask |= VK_COLOR_COMPONENT_B_BIT;
+			if (g) mask |= VK_COLOR_COMPONENT_G_BIT;
+			if (r) mask |= VK_COLOR_COMPONENT_R_BIT;
