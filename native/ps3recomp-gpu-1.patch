+	virtual void ProgressBarInc(u32 progressBarIndex, u32 delta) = 0;
+	virtual void ProgressBarSetValue(u32 progressBarIndex, u32 value) = 0;
+	virtual void ProgressBarSetLimit(u32 index, u32 limit) = 0;
