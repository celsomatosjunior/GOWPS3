+			glPixelStorei(GL_PACK_SKIP_IMAGES, m_skip_images);
+			glPixelStorei(GL_PACK_ALIGNMENT, m_alignment);
+		}
+
+		pixel_pack_settings& swap_bytes(bool value = true)
+		{
+			m_swap_bytes = value;
+			return *this;
