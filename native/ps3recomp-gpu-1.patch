+	void cs_resolve_base::build(const std::string& format_prefix, bool unresolve, bool bgra_swap)
+	{
+		create();
+
+		switch (optimal_group_size)
+		{
+		default:
+		case 64:
+			cs_wave_x = 8;
+			cs_wave_y = 8;
+			break;
