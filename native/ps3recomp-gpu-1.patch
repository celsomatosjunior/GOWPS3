+				return "rgba32f";
+			case VK_FORMAT_A1R5G5B5_UNORM_PACK16:
+				return "r16";
+			case VK_FORMAT_R8_UNORM:
+				return "r8";
+			case VK_FORMAT_R8G8_UNORM:
+				return "rg8";
+			case VK_FORMAT_R32_SFLOAT:
+				return "r32f";
+			default:
+				fmt::throw_exception("Unhandled VkFormat 0x%x", u32(format));
+		}
+	}
