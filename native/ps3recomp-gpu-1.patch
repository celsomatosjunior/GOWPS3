diff --git a/gpu/rsx/Emu/RSX/VK/vkutils/unique_resource.h b/gpu/rsx/Emu/RSX/VK/vkutils/unique_resource.h
new file mode 100644
index 00000000..9f1c9d25
--- /dev/null
+++ b/gpu/rsx/Emu/RSX/VK/vkutils/unique_resource.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <util/types.hpp>
+
+namespace vk
+{
+	u64 gen_uid();
+
+	class unique_resource
+	{
+	public:
+		unique_resource()
+			: m_uid(gen_uid())
