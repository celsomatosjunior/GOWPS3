+		result->memory_usage_flags = rsx::surface_usage_flags::attachment;
+		result->state_flags = rsx::surface_state_flags::erase_bkgnd;
+		result->sample_layout = sample_layout;
+		result->queue_tag(address);
+		result->add_ref();
