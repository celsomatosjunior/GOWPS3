+			{
+				set_vertex_data_impl<NV4097_SET_VERTEX_DATA_SCALED4S_M, index, 4, 4, s16>(ctx, arg);
+			}
+		};
+
+		struct set_transform_constant
+		{
+			// Helper for write commands
+			struct write_range
+			{
+				u32 first_word = 0;
+				u32 word_count = 0;
+			};
+
+			// Only constants [0, 467] are writable. Hardware ignores writes beyond that.
