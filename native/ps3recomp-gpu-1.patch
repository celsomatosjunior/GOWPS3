diff --git a/gpu/rsx/Emu/RSX/Capture/rsx_draw_dump.cpp b/gpu/rsx/Emu/RSX/Capture/rsx_draw_dump.cpp
new file mode 100644
index 00000000..94742971
--- /dev/null
+++ b/gpu/rsx/Emu/RSX/Capture/rsx_draw_dump.cpp
@@ -0,0 +1,215 @@
+// ps3recomp: RSX_DRAW_DUMP=<dir>[:<max>] -- every indexed draw's inputs to
+// files, for the 3D profile (ascension-online SPEC S9.5: the warrior's UVs and
+// textures, which the RSX reads straight from the model and never pass the
+// SPUs). Per draw, <dir>/draw_<n>.json (primitive, index ranges, the enabled
+// vertex attributes and fragment textures) and <dir>/draw_<n>.bin (the indices,
+// then each attribute's vertices from the lowest to the highest index used,
+// all as the guest has them: big-endian); each texture once, all its levels,
+// as <dir>/tex/<address>_<format>_<w>x<h>.bin. The draws are a ring of <max>
+// files (default 4000): the last ones before the game closed stay (newest by
+// file time). RSX_DRAW_DUMP_STRIDES=54,46 keeps only the draws whose attribute 0
+// has one of those strides (a character's colour pass), so the ring spans many
+// more frames. ascension tools/draw_dump_to_glb.py reads them.
+#include "stdafx.h"
+#include "Emu/RSX/Common/BufferUtils.h"
+#include "Emu/RSX/Common/TextureUtils.h"
+#include "Emu/RSX/GCM.h"
+#include "Emu/RSX/RSXThread.h"
+#include "Emu/Memory/vm.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <mutex>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+namespace rsx
+{
+	namespace
+	{
+		struct draw_dump_cfg
+		{
+			std::string dir;
+			u32 max = 4000;
+			bool on = false;
+			std::vector<u32> strides; // RSX_DRAW_DUMP_STRIDES: only draws whose attribute 0 has one of these strides
+
+		};
+
+		const draw_dump_cfg& cfg()
+		{
+			static const draw_dump_cfg c = []
+			{
+				draw_dump_cfg r;
+				const char* e = std::getenv("RSX_DRAW_DUMP");
+				if (!e || !*e)
+					return r;
+				r.dir = e;
+				const auto colon = r.dir.rfind(':');
+				if (colon != std::string::npos && colon + 1 < r.dir.size() && r.dir[colon + 1] >= '0' && r.dir[colon + 1] <= '9')
+				{
+					r.max = static_cast<u32>(std::atoi(r.dir.c_str() + colon + 1));
+					r.dir.resize(colon);
+				}
+				if (!r.max)
+					r.max = 1;
+				if (const char* st = std::getenv("RSX_DRAW_DUMP_STRIDES"))
+				{
+					for (const char* p = st; *p;)
+					{
+						char* end = nullptr;
+						const unsigned long v = std::strtoul(p, &end, 10);
+						if (end == p)
+							break;
+						r.strides.push_back(static_cast<u32>(v));
+						p = *end ? end + 1 : end;
+					}
+				}
+				std::error_code ec;
+				std::filesystem::create_directories(r.dir + "/tex", ec);
+				r.on = true;
+				return r;
+			}();
+			return c;
+		}
+
+		void write_file(const std::string& path, const void* data, usz size)
+		{
+			if (FILE* f = std::fopen(path.c_str(), "wb"))
+			{
+				if (size)
+					std::fwrite(data, 1, size, f);
+				std::fclose(f);
+			}
+		}
+
+		void append(std::vector<u8>& bin, u32 addr, usz size)
+		{
+			const usz at = bin.size();
+			bin.resize(at + size);
+			std::memcpy(bin.data() + at, vm::base(addr), size);
+		}
+	}
+
+	bool draw_dump_on()
+	{
+		return cfg().on;
+	}
+
+	void draw_dump(thread* /*rsx*/)
+	{
+		const draw_dump_cfg& c = cfg();
+		auto& clause = method_registers.current_draw_clause;
+		if (!c.on || clause.command != draw_command::indexed)
+			return;
+		if (!c.strides.empty())
+		{
+			// A character's colour pass (stride 54/46 in Ascension): the ring then holds many more frames.
+			const auto& a0 = method_registers.vertex_arrays_info[0];
+			if (!(method_registers.vertex_attrib_input_mask() & 1u) || !a0.size() ||
+				std::find(c.strides.begin(), c.strides.end(), u32{a0.stride()}) == c.strides.end())
+				return;
+		}
+
+		const u32 index_offset = method_registers.index_array_address();
+		const u32 index_location = method_registers.index_array_location();
+		const auto index_type = method_registers.index_type();
+		const u32 type_size = get_index_type_size(index_type);
+		const u32 index_base = get_address(index_offset, index_location) & (0 - type_size);
+		const bool restart = method_registers.restart_index_enabled();
+		const u32 restart_index = method_registers.restart_index();
+		const u32 base_index = method_registers.vertex_data_base_index();
+
+		std::vector<u8> bin;
+		std::string ranges;
+		u32 min_index = 0xFFFFFFFF, max_index = 0, index_count = 0;
+		clause.begin();
+		do
+		{
+			const auto& range = clause.get_range();
+			const u32 addr = index_base + range.first * type_size;
+			append(bin, addr, usz{range.count} * type_size);
+			ranges += fmt::format("%s[%u,%u]", ranges.empty() ? "" : ",", range.first, range.count);
+			index_count += range.count;
+			for (u32 i = 0; i < range.count; i++)
+			{
+				u32 index = index_type == index_array_type::u16 ? u32{vm::_ref<be_t<u16>>(addr + 2 * i)} : u32{vm::_ref<be_t<u32>>(addr + 4 * i)};
+				if (restart && index == restart_index)
+					continue;
+				index = get_index_from_base(index, base_index);
+				min_index = std::min(index, min_index);
+				max_index = std::max(index, max_index);
+			}
+		}
+		while (clause.next());
+		if (min_index > max_index || max_index - min_index > 0x100000)
+			return;
+
+		std::string json = fmt::format(
+			"{\"primitive\":%u,\"index_type\":%u,\"index_offset\":%u,\"index_location\":%u,\"base_index\":%u,"
+			"\"restart\":%d,\"restart_index\":%u,\"ranges\":[%s],\"index_count\":%u,\"min_index\":%u,\"max_index\":%u,\"attributes\":[",
+			static_cast<u32>(clause.primitive), static_cast<u32>(index_type), index_offset, index_location, base_index,
+			restart ? 1 : 0, restart_index, ranges, index_count, min_index, max_index);
+
+		const u32 input_mask = method_registers.vertex_attrib_input_mask();
+		bool first = true;
+		for (u8 a = 0; a < limits::vertex_count; ++a)
+		{
+			if (!(input_mask & (1u << a)))
+				continue;
+			const auto& info = method_registers.vertex_arrays_info[a];
+			if (!info.size())
+				continue;
+			const u32 stride = info.stride();
+			const u32 offset = get_vertex_offset_from_base(method_registers.vertex_data_base_offset(), info.offset() & 0x7fffffff);
+			const u32 location = info.offset() >> 31;
+			const u32 vsize = get_vertex_type_size_on_host(info.type(), info.size());
+			const u32 addr = get_address(offset, location);
+			// a stride of 0 is one value for every vertex
+			const usz size = stride ? usz{stride} * (max_index - min_index) + vsize : vsize;
+			const usz at = bin.size();
+			append(bin, addr + (stride ? min_index * stride : 0), size);
+			json += fmt::format("%s{\"index\":%u,\"type\":%u,\"size\":%u,\"stride\":%u,\"frequency\":%u,\"offset\":%u,\"location\":%u,\"bin\":%u,\"bytes\":%u}",
+				first ? "" : ",", a, static_cast<u32>(info.type()), info.size(), stride, info.frequency(), offset, location, at, size);
+			first = false;
+		}
+		json += "],\"textures\":[";
+
+		static std::mutex s_tex_lock;
+		static std::unordered_set<std::string> s_tex_done;
+		first = true;
+		for (u8 t = 0; t < method_registers.fragment_textures.size(); ++t)
+		{
+			const auto& tex = method_registers.fragment_textures[t];
+			if (!tex.enabled())
+				continue;
+			const u32 addr = get_address(tex.offset(), tex.location());
+			const std::string name = fmt::format("%08X_%02X_%ux%u.bin", addr, tex.format(), tex.width(), tex.height());
+			json += fmt::format("%s{\"unit\":%u,\"offset\":%u,\"location\":%u,\"format\":%u,\"width\":%u,\"height\":%u,\"depth\":%u,\"pitch\":%u,"
+				"\"mipmap\":%u,\"dimension\":%u,\"remap\":%u,\"file\":\"tex/%s\"}",
+				first ? "" : ",", t, tex.offset(), tex.location(), tex.format(), tex.width(), tex.height(), tex.depth(), tex.pitch(),
+				tex.mipmap(), static_cast<u32>(tex.dimension()), tex.remap(), name);
+			first = false;
+
+			std::lock_guard lock(s_tex_lock);
+			if (!s_tex_done.insert(name).second)
+				continue;
+			usz size = 0;
+			for (const auto& l : get_subresources_layout(tex))
+				size += l.data.size();
+			if (size && size < 64 * 1024 * 1024)
+				write_file(c.dir + "/tex/" + name, vm::base(addr), size);
+		}
+		json += "]}\n";
+
+		static std::atomic<u32> s_n{0};
+		const u32 k = s_n++ % c.max;
+		const std::string base = fmt::format("%s/draw_%05u", c.dir, k);
+		write_file(base + ".bin", bin.data(), bin.size());
+		write_file(base + ".json", json.data(), json.size());
+	}
+}
diff --git a/gpu/rsx/Emu/RSX/Capture/rsx_replay.h b/gpu/rsx/Emu/RSX/Capture/rsx_replay.h
new file mode 100644
index 00000000..f11f2e08
--- /dev/null
+++ b/gpu/rsx/Emu/RSX/Capture/rsx_replay.h
@@ -0,0 +1,201 @@
+#pragma once
+
+#include "Emu/CPU/CPUThread.h"
+#include "Emu/RSX/rsx_methods.h"
+
+#include <unordered_map>
+#include <unordered_set>
+
+namespace rsx
+{
+	enum : u32
+	{
+		c_fc_magic = "RRC"_u32,
+		c_fc_version = 0x6,
+	};
+
+	struct frame_capture_data
+	{
+		struct memory_block_data
+		{
+			std::vector<u8> data{};
+		};
+
+		// simple block to hold ps3 address and data
+		struct memory_block
+		{
+			ENABLE_BITWISE_SERIALIZATION;
+
+			u32 offset; // Offset in rsx address space
+			u32 location; // rsx memory location of the block
+			u64 data_state;
+		};
+
+		struct replay_command
+		{
+			std::pair<u32, u32> rsx_command{};      // fifo command
+			std::unordered_set<u64> memory_state{}; // index into memory_map for the various memory blocks that need applying before this command can run
+			u64 tile_state{0};                      // tile state for this command
+			u64 display_buffer_state{0};
+		};
+
+		struct tile_info
+		{
+			ENABLE_BITWISE_SERIALIZATION;
+
+			u32 tile;
+			u32 limit;
+			u32 pitch;
+			u32 format;
+		};
+
+		struct zcull_info
+		{
+			ENABLE_BITWISE_SERIALIZATION;
+
+			u32 region;
+			u32 size;
+			u32 start;
+			u32 offset;
+			u32 status0;
+			u32 status1;
+		};
+
+		// bleh, may need to break these out, might be unnecessary to do both always
+		struct tile_state
+		{
+			ENABLE_BITWISE_SERIALIZATION;
+
+			tile_info tiles[15]{};
+			zcull_info zculls[8]{};
+		};
+
+		struct buffer_state
+		{
+			ENABLE_BITWISE_SERIALIZATION;
+
+			u32 width{0};
+			u32 height{0};
+			u32 pitch{0};
+			u32 offset{0};
+		};
+
+		struct display_buffers_state
+		{
+			ENABLE_BITWISE_SERIALIZATION;
+
+			std::array<buffer_state, 8> buffers{};
+			u32 count{0};
+		};
+
+		u32 magic = c_fc_magic;
+		u32 version = c_fc_version;
+		u32 LE_format = std::endian::little == std::endian::native;
+
+		struct bitwise_hasher
+		{
+			template <typename T>
+			usz operator()(const T& key) const noexcept
+			{
+				if constexpr (!!(requires (const T& a) { a.data[0]; }))
+				{
+					return std::hash<std::string_view>{}(std::string_view{ reinterpret_cast<const char*>(key.data.data()), key.data.size() * sizeof(key.data[0]) });
+				}
+
+				return std::hash<std::string_view>{}(std::string_view{ reinterpret_cast<const char*>(&key), sizeof(key) });
+			}
+
+			template <typename T>
+			bool operator()(const T& keya, const T& keyb) const noexcept
+			{
+				if constexpr (!!(requires (const T& a) { a.data[0]; }))
+				{
+					if (keya.data.size() != keyb.data.size())
+					{
+						return false;
+					}
+
+					return std::equal(keya.data.begin(), keya.data.end(), keyb.data.begin());
+				}
+
+				return std::equal(reinterpret_cast<const char*>(&keya), reinterpret_cast<const char*>(&keya) + sizeof(T), reinterpret_cast<const char*>(&keyb));
+			}
+		};
+
+		template <typename T, typename V>
+		using uno_bit_map = std::unordered_map<T, V, bitwise_hasher, bitwise_hasher>;
+
+		// Hashmap of holding various states for tile
+		uno_bit_map<tile_state, u64> tile_map;
+
+		// Hashmap of various memory 'changes' that can be applied to ps3 memory
+		uno_bit_map<memory_block, u64> memory_map;
+
+		// Hashmap of memory blocks that can be applied, this is split from above for size decrease
+		uno_bit_map<memory_block_data, u64> memory_data_map;
+
+		// Display buffer state map
+		uno_bit_map<display_buffers_state, u64> display_buffers_map;
+
+		// Actual command queue to hold everything above
+		std::vector<replay_command> replay_commands;
+
+		// Initial registers state at the beginning of the capture
+		rsx::rsx_state reg_state;
+
+		// Indexer for memory blocks
+		u64 memory_indexer = 0x1234;
+
+		void reset()
+		{
+			magic = c_fc_magic;
+			version = c_fc_version;
+			tile_map.clear();
+			memory_map.clear();
+			replay_commands.clear();
+			reg_state = method_registers;
+		}
+	};
+
+
+	class rsx_replay_thread : public cpu_thread
+	{
+		struct rsx_context
+		{
+			be_t<u32> user_addr;
+			be_t<u64> dev_addr;
+			be_t<u32> mem_handle;
+			be_t<u32> context_id;
+			be_t<u64> mem_addr;
+			be_t<u64> dma_addr;
+			be_t<u64> reports_addr;
+			be_t<u64> driver_info;
+		};
+
+		struct current_state
+		{
+			u64 tile_hash{0};
+			u64 display_buffer_hash{0};
+			frame_capture_data::display_buffers_state buffer_state{};
+			frame_capture_data::tile_state tile_state{};
+		};
+
+		u32 user_mem_addr{};
+		current_state cs{};
+		std::unique_ptr<frame_capture_data> frame;
+
+	public:
+		rsx_replay_thread(std::unique_ptr<frame_capture_data>&& frame_data)
+			: cpu_thread(0)
+			, frame(std::move(frame_data))
+		{
+		}
+
+		using cpu_thread::operator=;
+		void cpu_task() override;
+	private:
+		be_t<u32> allocate_context();
+		std::vector<u32> alloc_write_fifo(be_t<u32> context_id) const;
+		void apply_frame_state(be_t<u32> context_id, const frame_capture_data::replay_command& replay_cmd);
+	};
+}
