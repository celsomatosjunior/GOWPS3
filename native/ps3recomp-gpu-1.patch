+#pragma once
+/* RPCS3 1b336f41f: the NSView's CAMetalLayer, for VK_EXT_metal_surface.
+ * ps3rsx_metal_view_size is local: client size in pixels. */
+#ifdef __cplusplus
+extern "C" {
+#endif
+void* GetCAMetalLayerFromMetalView(void* view);
+void ps3rsx_metal_view_size(void* view, int* width, int* height);
+/* The window binds its CAMetalLayer. Each flip reserves a drawable before
+ * MoltenVK submits: nextDrawable inside the queue lock never returns once the
+ * pool of 3 is full, because the present that would free one needs that lock. */
+void ps3rsx_bind_metal_layer(void* layer);
+void ps3rsx_prefetch_metal_drawable(void);
+#ifdef __cplusplus
+}
+#endif
diff --git a/gpu/rsx/Emu/RSX/VK/vkutils/metal_layer.mm b/gpu/rsx/Emu/RSX/VK/vkutils/metal_layer.mm
new file mode 100644
index 00000000..ce320b14
--- /dev/null
+++ b/gpu/rsx/Emu/RSX/VK/vkutils/metal_layer.mm
@@ -0,0 +1,82 @@
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wold-style-cast"
+#pragma GCC diagnostic ignored "-Wdeprecated-declarations"
+#pragma GCC diagnostic ignored "-Wmissing-declarations"
+#import <Foundation/Foundation.h>
+#import <AppKit/AppKit.h>
+#import <QuartzCore/QuartzCore.h>
+#import <objc/runtime.h>
+#include <math.h>
+#include <stdio.h>
+#include <unistd.h>
+#include "metal_layer.h"
+
+static CAMetalLayer* s_bound_layer;
+static id<CAMetalDrawable> s_ready;
+static IMP s_orig_next;
+
+static id hooked_next_drawable(id self, SEL cmd)
+{
+	if (self == (id)s_bound_layer && s_ready) {
+		id<CAMetalDrawable> drawable = s_ready;
+		s_ready = nil;
+		/* Hand our retain to the caller's autorelease pool so MoltenVK's
+		 * retain is the only one left after the pool drains. */
+		return [drawable autorelease];
+	}
+	return ((id (*)(id, SEL))s_orig_next)(self, cmd);
+}
+
+void ps3rsx_bind_metal_layer(void* layer)
+{
+	s_bound_layer = (CAMetalLayer*)layer;
+	static int installed = 0;
+	if (installed || !s_bound_layer) return;
+	installed = 1;
+	Method method = class_getInstanceMethod([CAMetalLayer class], @selector(nextDrawable));
+	s_orig_next = method_getImplementation(method);
+	method_setImplementation(method, (IMP)hooked_next_drawable);
+}
+
+void ps3rsx_prefetch_metal_drawable(void)
+{
+	if (!s_bound_layer || !s_orig_next || s_bound_layer.device == nil || s_ready)
+		return;
+	/* The layer's first commit has to land before the first nextDrawable.
+	 * Later calls are outside MoltenVK's queue lock, so a full pool can
+	 * actually recycle instead of sleeping forever. */
+	static int warmed = 0;
+	if (!warmed) {
+		warmed = 1;
+		usleep(200000);
+	}
+	@autoreleasepool {
+		id<CAMetalDrawable> drawable =
+			((id (*)(id, SEL))s_orig_next)(s_bound_layer, @selector(nextDrawable));
+		if (drawable) s_ready = [drawable retain];
+	}
+}
+
+void* GetCAMetalLayerFromMetalView(void* view) { return ((NSView*)view).layer; }
+
+void ps3rsx_metal_view_size(void* view, int* width, int* height)
+{
+	NSView* v = (NSView*)view;
+	__block int w = 1280, h = 720;
+	void (^work)(void) = ^{
+		NSRect b = v.bounds;
+		CGFloat scale = v.window ? v.window.backingScaleFactor : 1.0;
+		if (scale < 1.0) scale = 1.0;
+		w = (int)llround(b.size.width * scale);
+		h = (int)llround(b.size.height * scale);
+		if (w < 1) w = 1;
+		if (h < 1) h = 1;
+		if ([v.layer isKindOfClass:[CAMetalLayer class]])
+			((CAMetalLayer*)v.layer).drawableSize = CGSizeMake(w, h);
+	};
+	if ([NSThread isMainThread]) work();
+	else dispatch_sync(dispatch_get_main_queue(), work);
+	if (width) *width = w;
+	if (height) *height = h;
+}
+#pragma GCC diagnostic pop
