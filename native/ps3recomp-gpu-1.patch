+	static GLenum sizedfmt_to_ifmt(GLenum sized)
+	{
+		switch (sized)
+		{
+		case GL_BGRA8:
+			return GL_RGBA8;
+		case GL_BGR5_A1:
+			return GL_RGB5_A1;
+		default:
+			return sized;
+		}
+	}
+
+	static const char* gl_type_to_str(texture::type type)
