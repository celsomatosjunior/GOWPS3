+	std::unordered_map<VkFormat, std::unique_ptr<vk::cs_unresolve_task>> g_unresolve_helpers;
+	std::unique_ptr<vk::depthonly_resolve> g_depth_resolver;
+	std::unique_ptr<vk::depthonly_unresolve> g_depth_unresolver;
