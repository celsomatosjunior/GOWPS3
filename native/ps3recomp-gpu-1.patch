+			}
+			else if (m_datapoints.empty() || m_datapoint_count < m_datapoints.size())
+			{
+				std::copy(m_datapoints.begin() + m_datapoints.size() - m_datapoint_count, m_datapoints.end(), m_datapoints.begin());
+				m_datapoints.resize(m_datapoint_count);
