@@ -0,0 +1,283 @@
+#include "stdafx.h"
+#include "shader_loading_dialog.h"
+#include "Emu/emu_callbacks.h"
+#include "Emu/System.h"
+#include "Emu/Cell/Modules/cellMsgDialog.h"
+
+#include "util/asm.hpp"
+
+namespace rsx
+{
+	void shader_loading_dialog::create(const std::string& msg, const std::string& title)
+	{
+		dlg = g_emu_callbacks.get_msg_dialog();
+		if (dlg)
+		{
+			dlg->type.se_normal = true;
+			dlg->type.bg_invisible = true;
+			dlg->type.progress_bar_count = 2;
+			dlg->ProgressBarSetTaskbarIndex(-1); // -1 to combine all progressbars in the taskbar progress
+			dlg->on_close = [](s32 /*status*/)
+			{
+				Emu.CallFromMainThread([]()
+				{
+					rsx_log.notice("Aborted shader loading dialog");
+					Emu.Kill(false);
+				});
+			};
+
+			ref_cnt++;
+
+			Emu.CallFromMainThread([&]()
+			{
+				dlg->Create(msg, title);
+				ref_cnt--;
+			});
+		}
+
+		while (ref_cnt.load() && !Emu.IsStopped())
+		{
+			utils::pause();
+		}
+	}
+
+	void shader_loading_dialog::update_msg(u32 index, std::string msg)
+	{
+		if (!dlg)
+		{
+			return;
+		}
+
+		ref_cnt++;
+
+		Emu.CallFromMainThread([&, index, message = std::move(msg)]()
+		{
+			dlg->ProgressBarSetMsg(index, message);
+			ref_cnt--;
+		});
+	}
+
+	void shader_loading_dialog::inc_value(u32 index, u32 value)
+	{
+		if (!dlg)
+		{
+			return;
+		}
+
+		ref_cnt++;
+
+		Emu.CallFromMainThread([&, index, value]()
+		{
+			dlg->ProgressBarInc(index, value);
+			ref_cnt--;
+		});
+	}
+
+	void shader_loading_dialog::set_value(u32 index, u32 value)
+	{
+		if (!dlg)
+		{
+			return;
+		}
+
+		ref_cnt++;
+
+		Emu.CallFromMainThread([&, index, value]()
+		{
+			dlg->ProgressBarSetValue(index, value);
+			ref_cnt--;
+		});
+	}
+
+	void shader_loading_dialog::set_limit(u32 index, u32 limit)
+	{
+		if (!dlg)
+		{
+			return;
+		}
+
+		ref_cnt++;
+
+		Emu.CallFromMainThread([&, index, limit]()
+		{
+			dlg->ProgressBarSetLimit(index, limit);
+			ref_cnt--;
+		});
+	}
+
+	void shader_loading_dialog::refresh()
+	{
+	}
+
+	void shader_loading_dialog::close()
+	{
+		while (ref_cnt.load() && !Emu.IsStopped())
+		{
+			utils::pause();
+		}
+	}
+}
+
+#ifdef PS3RECOMP_RSX_ONLY
+#include "../overlay_manager.h"
+#include "Emu/RSX/RSXThread.h"
+#include "Emu/system_config.h"
+
+#include <cstdlib>
+
+namespace rsx
+{
+	namespace overlays
+	{
+		// "#RRGGBB" or "#RRGGBBAA" as the performance overlay's settings hold them.
+		static color4f shader_loading_color(const std::string& hex, color4f fallback)
+		{
+			const std::string digits = !hex.empty() && hex[0] == '#' ? hex.substr(1) : hex;
+			if (digits.size() != 6 && digits.size() != 8)
+				return fallback;
+			const u32 v = static_cast<u32>(std::strtoul(digits.c_str(), nullptr, 16));
+			const u32 rgba = digits.size() == 6 ? (v << 8) | 0xFFu : v;
+			return color4f(((rgba >> 24) & 0xFF) / 255.f, ((rgba >> 16) & 0xFF) / 255.f,
+			               ((rgba >> 8) & 0xFF) / 255.f, (rgba & 0xFF) / 255.f);
+		}
+
+		struct shader_loading_view final : overlay
+		{
+			overlay_element background;
+			label title;
+			label status;
+			overlay_element track;
+			overlay_element fill;
+
+			shader_loading_view()
+			{
+				const std::string font = std::getenv("PS3_OVERLAY_FONT") ? g_cfg.video.perf_overlay.font.to_string() : std::string();
+				const color4f accent = shader_loading_color(g_cfg.video.perf_overlay.color_title.to_string(), color4f(0.95f, 0.42f, 0.14f, 1.f));
+				const color4f body = shader_loading_color(g_cfg.video.perf_overlay.color_body.to_string(), color4f(1.f, 1.f, 1.f, 1.f));
+
+				background.set_size(virtual_width, virtual_height);
+				background.back_color = color4f(0.f, 0.f, 0.f, 1.f);
+
+				title.set_font(28, font);
+				title.set_size(virtual_width, 48);
+				title.set_pos(0, 300);
+				title.align_text(overlay_element::text_align::center);
+				title.fore_color = accent;
+				title.back_color.a = 0.f;
+
+				status.set_font(16, font);
+				status.set_size(virtual_width, 28);
+				status.set_pos(0, 400);
+				status.align_text(overlay_element::text_align::center);
+				status.fore_color = body;
+				status.back_color.a = 0.f;
+
+				track.set_size(640, 6);
+				track.set_pos(320, 370);
+				track.back_color = color4f(accent.r, accent.g, accent.b, 0.25f);
+
+				fill.set_size(0, 6);
+				fill.set_pos(320, 370);
+				fill.back_color = accent;
+			}
+
+			compiled_resource get_compiled() override
+			{
+				if (!visible)
+					return {};
+
+				compiled_resource result;
+				result.add(background.get_compiled());
+				result.add(title.get_compiled());
+				result.add(track.get_compiled());
+				result.add(fill.get_compiled());
+				result.add(status.get_compiled());
+				return result;
+			}
+		};
+	}
+
+	// "<title>|<reading>|<compiling>", each part optional.
+	static std::string shader_loading_text(u32 part)
+	{
+		static const char* const defaults[3] = { "Preparing shaders", "Reading", "Compiling" };
+		std::string all;
+		if (const char* e = std::getenv("PS3_SHADER_LOADING_TEXT"))
+			all = e;
+		for (u32 i = 0; i < part && !all.empty(); i++)
+		{
+			const auto bar = all.find('|');
+			all = bar == std::string::npos ? std::string() : all.substr(bar + 1);
+		}
+		const std::string text = all.substr(0, all.find('|'));
+		return text.empty() ? defaults[part] : text;
+	}
+
+	shader_loading_screen::shader_loading_screen(rsx::thread* ptr)
+		: owner(ptr)
+	{
+	}
+
+	shader_loading_screen::~shader_loading_screen()
+	{
+		close();
+	}
+
+	void shader_loading_screen::create(const std::string& /*msg*/, const std::string& /*title*/)
+	{
+		view = g_fxo->get<overlays::display_manager>().create<overlays::shader_loading_view>();
+		view->title.set_text(shader_loading_text(0));
+		view->visible = true;
+		redraw();
+	}
+
+	void shader_loading_screen::update_msg(u32 index, std::string /*msg*/)
+	{
+		step = std::min<u32>(index, 1);
+	}
+
+	void shader_loading_screen::inc_value(u32 index, u32 value)
+	{
+		set_value(index, values[std::min<u32>(index, 1)] + value);
+	}
+
+	void shader_loading_screen::set_value(u32 index, u32 value)
+	{
+		step = std::min<u32>(index, 1);
+		values[step] = value;
+		redraw();
+	}
+
+	void shader_loading_screen::set_limit(u32 index, u32 limit)
+	{
+		limits[std::min<u32>(index, 1)] = limit;
+	}
+
+	void shader_loading_screen::refresh()
+	{
+		redraw();
+	}
+
+	void shader_loading_screen::close()
+	{
+		if (!view)
+			return;
+		view->visible = false;
+		g_fxo->get<overlays::display_manager>().remove(view->uid);
+		view.reset();
+	}
+
+	// Reading the files is quick, compiling is most of the wait: 15% and 85%.
+	void shader_loading_screen::redraw()
+	{
+		if (!view)
+			return;
+
+		const auto part = [this](u32 i) { return limits[i] ? std::min(1.f, static_cast<f32>(values[i]) / limits[i]) : 0.f; };
+		const f32 done = 0.15f * part(0) + 0.85f * part(1);
+		view->fill.set_size(static_cast<u16>(view->track.w * done), view->track.h);
+		view->status.set_text(fmt::format("%s  %u / %u", shader_loading_text(1 + step), values[step], limits[step]));
+		owner->flip({});
+	}
+}
+#endif
diff --git a/gpu/rsx/Emu/RSX/Overlays/Shaders/shader_loading_dialog.h b/gpu/rsx/Emu/RSX/Overlays/Shaders/shader_loading_dialog.h
