+	static inline auto to_comparison_function(u32 in)
+	{
+		auto func = gcm_enum_cast<
+			comparison_function,
+			CELL_GCM_NEVER,
+			CELL_GCM_ALWAYS>(in | 0x200);
+		// ps3recomp: a desynced FIFO can leave a depth/stencil/alpha/texture
+		// compare value no function has; dereferencing the failed cast killed
+		// the RSX thread ("Verification failed" in expected.hpp, God of War:
+		// Ascension's first level on 4 cores, 1 run of 20). Always passes.
+		if (!func)
+			return decltype(func)(comparison_function::always);
+		return func;
+	}
