+    snprintf(g_ld_cap_dir, sizeof g_ld_cap_dir, "%s\\cap_%06u", base, g_ld_frames);
+    CreateDirectoryA(g_ld_cap_dir, NULL);
+    char path[MAX_PATH * 2];
+    snprintf(path, sizeof path, "%s\\capture.txt", g_ld_cap_dir);
+    g_ld_cap_log = fopen(path, "w");
+    g_ld_cap_draws = 0;
+    g_ld_cap_nkeys = 0;
+    g_ld_cap_active = g_ld_cap_log != NULL;
+    char full[MAX_PATH];
+    if (!GetFullPathNameA(g_ld_cap_dir, sizeof full, full, NULL)) snprintf(full, sizeof full, "%s", g_ld_cap_dir);
+    fprintf(stderr, "[capture] F12: capturing frame %u into %s\n", g_ld_frames, full);
+}
