+                     g.surfaces[i].location, g.surfaces[i].offset, g.surfaces[i].w, g.surfaces[i].h);
+            ld_dump_surface_ppm(path, &g.surfaces[i]);
+            /* and what guest memory holds there (A R G B bytes), for buffers
+             * the CPU or SPUs fill */
+            if (g.surfaces[i].fmt == DXGI_FORMAT_R8G8B8A8_UNORM) {
+                const u32 gw = g.surfaces[i].w, gh = g.surfaces[i].h;
+                const u8* gm = guest_ptr(g.surfaces[i].location, g.surfaces[i].offset, gw * 4u * gh);
+                snprintf(path, sizeof(path), "%s\\guest_%02u_%u_%08X_%ux%u.ppm", g_ld_cap_dir, i,
+                         g.surfaces[i].location, g.surfaces[i].offset, gw, gh);
+                FILE* gf = gm ? fopen(path, "wb") : NULL;
+                if (gf) {
+                    fprintf(gf, "P6\n%u %u\n255\n", gw, gh);
+                    for (u32 p = 0; p < gw * gh; p++) fwrite(gm + (size_t)p * 4u + 1u, 1, 3, gf);
+                    fclose(gf);
+                }
+            }
+        }
+        /* The transform constants as they stand (512 x vec4, host u32 bit
+         * patterns): an RPCS3 .rrc only carries the constants its frame
+         * uploads, and rrc_replay --vpconst seeds the rest from this. */
+        { char path[MAX_PATH * 2];
+          snprintf(path, sizeof(path), "%s\\vp_constants.bin", g_ld_cap_dir);
+          FILE* cf = fopen(path, "wb");
+          if (cf) { fwrite(g.rsx.constants, 1, sizeof(g.rsx.constants), cf); fclose(cf); } }
+        if (g_ld_cap_log) {
+            fprintf(g_ld_cap_log, "[capture] %u draws, %u programs, %u surfaces\n",
+                    g_ld_cap_draws, g_ld_cap_nkeys, g.n_surfaces);
+            fclose(g_ld_cap_log);
+            g_ld_cap_log = NULL;
+        }
