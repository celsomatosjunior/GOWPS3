+static void ld_capture_poll(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_CAPTURE_KEY"); on = !(e && e[0] == '0'); }
+    if (!on || g_ld_cap_active) return;    /* a capture ends by draw count (bind trace) */
+    const SHORT k = GetAsyncKeyState(VK_F12);
+    static int was_down = 0;
+    const int down = (k & 0x8000) != 0;
+    const int pressed = down && !was_down;
+    was_down = down;
+    if (!pressed) return;
