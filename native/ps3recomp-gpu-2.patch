+			cmp_and_old.d()->refs++;
+
+			// Dereference if still the same pointer
+			const auto [_, did_deref] = m_val.fetch_op([_val](fat_ptr& val)
+			{
+				if (val.ptr == _val.ptr)
+				{
+					val.ref_ctr--;
+					return true;
+				}
+
+				return false;
+			});
