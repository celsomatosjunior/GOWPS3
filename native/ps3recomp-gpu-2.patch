+	// A trophy cup around c, r its half size: the bowl, its two handles, the stem and the base; filled or outlined.
+	void cup(ImDrawList* dl, ImVec2 c, float r, ImU32 col, float th, bool filled)
+	{
+		const ImVec2 b0(c.x - r * 0.62f, c.y - r * 0.85f), b1(c.x + r * 0.62f, c.y + r * 0.05f);
+		if (filled) dl->AddRectFilled(b0, b1, col, r * 0.55f, ImDrawFlags_RoundCornersBottom);
+		else dl->AddRect(b0, b1, col, r * 0.55f, ImDrawFlags_RoundCornersBottom, th);
+		dl->AddBezierCubic(ImVec2(b0.x, c.y - r * 0.70f), ImVec2(c.x - r * 1.15f, c.y - r * 0.70f), ImVec2(c.x - r * 1.05f, c.y - r * 0.05f),
+		                   ImVec2(c.x - r * 0.45f, c.y - r * 0.08f), col, th);
+		dl->AddBezierCubic(ImVec2(b1.x, c.y - r * 0.70f), ImVec2(c.x + r * 1.15f, c.y - r * 0.70f), ImVec2(c.x + r * 1.05f, c.y - r * 0.05f),
+		                   ImVec2(c.x + r * 0.45f, c.y - r * 0.08f), col, th);
+		dl->AddLine(ImVec2(c.x, c.y + r * 0.05f), ImVec2(c.x, c.y + r * 0.55f), col, th * 1.4f);
+		if (filled) dl->AddRectFilled(ImVec2(c.x - r * 0.45f, c.y + r * 0.55f), ImVec2(c.x + r * 0.45f, c.y + r * 0.85f), col, r * 0.08f);
+		else dl->AddRect(ImVec2(c.x - r * 0.45f, c.y + r * 0.55f), ImVec2(c.x + r * 0.45f, c.y + r * 0.85f), col, r * 0.08f, 0, th);
+	}
