+		template <typename T> requires FastRandomAccess<T> && ListAlike<T> && (!TupleAlike<typename T::value_type>)
+		bool serialize(T& obj)
+		{
+			if (is_writing())
+			{
+				serialize_vle(obj.size());
+
+				if constexpr (Bitcopy<typename std::remove_reference_t<T>::value_type>)
