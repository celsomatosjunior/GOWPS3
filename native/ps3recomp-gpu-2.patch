diff --git a/gpu/shim/image_scale.cpp b/gpu/shim/image_scale.cpp
new file mode 100644
index 00000000..783eceb5
--- /dev/null
+++ b/gpu/shim/image_scale.cpp
@@ -0,0 +1,89 @@
+// ps3recomp shim: rsx::convert_scale_image without FFmpeg's swscale. RPCS3's
+// CPU blit path (nv3089.cpp) scales between two formats only, ARGB and
+// RGB565BE, and asks for point or bilinear filtering; source and destination
+// always share the format there. GPL-2.0, like RPCS3.
+#include "stdafx.h"
+#include "Emu/RSX/Utils/image_utils.hpp"
+
+#include <algorithm>
+
+namespace rsx
+{
+    namespace
+    {
+        // Bytes per pixel of the two formats.
+        int bpp(AVPixelFormat f) { return f == AV_PIX_FMT_RGB565BE ? 2 : 4; }
+
+        // 565 big-endian <-> 8-bit channels, for the bilinear blend.
+        void unpack565(const u8* p, int c[4])
+        {
+            const u16 v = static_cast<u16>(p[0] << 8 | p[1]);
+            c[0] = 0;
+            c[1] = (v >> 11) & 31;
+            c[2] = (v >> 5) & 63;
+            c[3] = v & 31;
+        }
+
+        void pack565(u8* p, const int c[4])
+        {
+            const u16 v = static_cast<u16>((c[1] & 31) << 11 | (c[2] & 63) << 5 | (c[3] & 31));
+            p[0] = static_cast<u8>(v >> 8);
+            p[1] = static_cast<u8>(v);
+        }
+    }
+
+    void convert_scale_image(u8* dst, AVPixelFormat dst_format, int dst_width, int dst_height, int dst_pitch,
+        const u8* src, AVPixelFormat src_format, int src_width, int src_height, int src_pitch, int src_slice_h, bool bilinear)
+    {
+        ensure(dst_format == src_format);
+        const int bytes = bpp(src_format);
+        const int sh = std::max(1, std::min(src_height, src_slice_h));
+        if (dst_width <= 0 || dst_height <= 0 || src_width <= 0)
+            return;
+
+        for (int y = 0; y < dst_height; y++)
+        {
+            u8* out = dst + y * dst_pitch;
+            // Sample centres, as swscale does.
+            const float fy = std::max(0.f, (y + 0.5f) * sh / dst_height - 0.5f);
+            const int y0 = std::min(static_cast<int>(fy), sh - 1), y1 = std::min(y0 + 1, sh - 1);
+            const float wy = fy - y0;
+            for (int x = 0; x < dst_width; x++)
+            {
+                const float fx = std::max(0.f, (x + 0.5f) * src_width / dst_width - 0.5f);
+                const int x0 = std::min(static_cast<int>(fx), src_width - 1), x1 = std::min(x0 + 1, src_width - 1);
+                if (!bilinear)
+                {
+                    const int sx = std::min(x * src_width / dst_width, src_width - 1);
+                    const int sy = std::min(y * sh / dst_height, sh - 1);
+                    std::memcpy(out + x * bytes, src + sy * src_pitch + sx * bytes, bytes);
+                    continue;
+                }
+                const float wx = fx - x0;
+                const u8* p00 = src + y0 * src_pitch + x0 * bytes;
+                const u8* p01 = src + y0 * src_pitch + x1 * bytes;
+                const u8* p10 = src + y1 * src_pitch + x0 * bytes;
+                const u8* p11 = src + y1 * src_pitch + x1 * bytes;
+                int c00[4], c01[4], c10[4], c11[4], r[4];
+                if (bytes == 2)
+                {
+                    unpack565(p00, c00); unpack565(p01, c01); unpack565(p10, c10); unpack565(p11, c11);
+                }
+                else
+                {
+                    for (int i = 0; i < 4; i++) { c00[i] = p00[i]; c01[i] = p01[i]; c10[i] = p10[i]; c11[i] = p11[i]; }
+                }
+                for (int i = 0; i < 4; i++)
+                {
+                    const float top = c00[i] + (c01[i] - c00[i]) * wx;
+                    const float bot = c10[i] + (c11[i] - c10[i]) * wx;
+                    r[i] = static_cast<int>(top + (bot - top) * wy + 0.5f);
+                }
+                if (bytes == 2)
+                    pack565(out + x * bytes, r);
+                else
+                    for (int i = 0; i < 4; i++) out[x * bytes + i] = static_cast<u8>(r[i]);
+            }
+        }
+    }
+}
