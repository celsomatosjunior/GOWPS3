+cpu_thread::cpu_thread(u32 id)
+    : id(id)
+{
+    if (Emu.IsStopped())
+    {
+        state += cpu_flag::exit;
+    }
+
+    g_threads_created++;
+}
+
+cpu_thread::~cpu_thread()
+{
+}
+
+void cpu_thread::operator()()
+{
+    g_tls_this_thread = this;
+
+    while (!(state & cpu_flag::exit) && thread_ctrl::state() != thread_state::aborting)
+    {
+        const auto state0 = +state;
+
+        if (is_stopped(state0 - cpu_flag::stop))
+        {
+            break;
+        }
+
+        if (!(state0 & cpu_flag::stop))
+        {
+            cpu_task();
+            state += cpu_flag::wait;
+
+            if (state & cpu_flag::ret && state.test_and_reset(cpu_flag::ret))
+            {
+                cpu_return();
+            }
+
+            continue;
+        }
+
+        state.wait(state0);
+
+        if (state & cpu_flag::ret && state.test_and_reset(cpu_flag::ret))
+        {
+            cpu_return();
+        }
+    }
+
+    if (auto ptr = vm::g_tls_locked)
+    {
+        ptr->compare_and_swap(this, nullptr);
+    }
+
+    g_tls_this_thread = nullptr;
+    g_threads_deleted++;
+}
+
+void cpu_thread::cpu_wait(bs_t<cpu_flag> old)
+{
+    state.wait(old);
+}
+
+bool cpu_thread::check_state() noexcept
+{
+    bool cpu_memory_checked = false;
+    bool cpu_can_stop = true;
+
+    while (true)
+    {
+        bool escape = false, retval = false;
+        bs_t<cpu_flag> state1;
+        const auto state0 = state.fetch_op([&](bs_t<cpu_flag>& flags)
+        {
+            bool store = false;
+
+            if (flags & cpu_flag::temp)
+            {
+                // Sticky: check_state() may not return true this time
+                flags -= cpu_flag::temp;
+                cpu_can_stop = false;
+                store = true;
+            }
+
+            if (cpu_can_stop && flags & cpu_flag::signal)
+            {
+                flags -= cpu_flag::signal;
+                store = true;
+            }
+
+            if (flags & cpu_flag::notify)
+            {
+                flags -= cpu_flag::notify;
+                store = true;
+            }
+
+            if (flags & cpu_flag::req_exit)
+            {
+                flags -= cpu_flag::req_exit;
+                flags += cpu_flag::exit;
+                store = true;
+            }
+
+            if (!is_stopped(flags) && flags.none_of(cpu_flag::ret))
+            {
+                // Flags that hold the thread inside check_state()
+                if ((!cpu_memory_checked && flags & cpu_flag::memory) ||
+                    (cpu_can_stop && flags & (cpu_flag::dbg_global_pause + cpu_flag::dbg_pause + cpu_flag::suspend + cpu_flag::yield + cpu_flag::preempt)))
+                {
+                    if (!(flags & cpu_flag::wait))
+                    {
+                        flags += cpu_flag::wait;
+                        store = true;
+                    }
+
+                    if (flags & (cpu_flag::yield + cpu_flag::preempt) && cpu_can_stop)
+                    {
+                        flags -= (cpu_flag::yield + cpu_flag::preempt);
+                        store = true;
+                    }
+
+                    state1 = flags;
+                    return store;
+                }
+
+                if (flags & (cpu_flag::wait + cpu_flag::memory))
+                {
+                    flags -= (cpu_flag::wait + cpu_flag::memory);
+                    store = true;
+                }
+
+                retval = false;
+            }
+            else
+            {
+                if (flags & cpu_flag::wait)
+                {
+                    flags -= cpu_flag::wait;
+                    store = true;
+                }
+
+                retval = cpu_can_stop;
+            }
+
+            escape = true;
+            state1 = flags;
+            return store;
+        }).first;
+
+        if (escape)
+        {
+            if (vm::g_range_lock_bits[1] && vm::g_tls_locked && *vm::g_tls_locked == this)
+            {
+                state += cpu_flag::wait + cpu_flag::memory;
+                cpu_memory_checked = false;
+                continue;
+            }
+
+            if (cpu_can_stop && state0 & cpu_flag::pending)
+            {
+                cpu_work();
+
+                if ((state1 ^ state) - cpu_flag::pending)
+                {
+                    cpu_memory_checked = false;
+                    continue;
+                }
+            }
+
+            if (retval)
+            {
+                cpu_on_stop();
+            }
+
+            return retval;
+        }
+
+        if (state0 & (cpu_flag::suspend + cpu_flag::dbg_global_pause + cpu_flag::dbg_pause))
+        {
+            cpu_wait(state1);
+        }
+        else if (state0 & cpu_flag::memory)
+        {
+            vm::passive_lock(*this);
+            cpu_memory_checked = true;
+        }
+        else if (state0 & cpu_flag::yield)
+        {
+            std::this_thread::yield();
+        }
+    }
+}
+
+void cpu_thread::notify()
+{
+    state.notify_one();
+}
+
+cpu_thread& cpu_thread::operator=(thread_state)
+{
+    if (state & (cpu_flag::exit + cpu_flag::req_exit))
+    {
+        return *this;
+    }
+
+    const auto old = state.fetch_add(cpu_flag::req_exit);
+
+    if (old & cpu_flag::wait && old.none_of(cpu_flag::again + cpu_flag::exit))
+    {
+        state.notify_one();
+    }
+
+    return *this;
+}
+
+void cpu_thread::add_remove_flags(bs_t<cpu_flag> to_add, bs_t<cpu_flag> to_remove)
+{
+    bs_t<cpu_flag> result{};
+
+    if (!to_remove)
+    {
+        state.add_fetch(to_add);
+        return;
+    }
+    else if (!to_add)
+    {
+        result = state.sub_fetch(to_remove);
+    }
+    else
+    {
+        result = state.atomic_op([&](bs_t<cpu_flag>& v)
+        {
+            v += to_add;
+            v -= to_remove;
+            return v;
+        });
+    }
+
+    if (!::is_paused(to_remove) && !::is_stopped(to_remove))
+    {
+        return;
+    }
+
+    if (::is_paused(result) || ::is_stopped(result))
+    {
+        return;
+    }
+
+    state.notify_one();
+}
