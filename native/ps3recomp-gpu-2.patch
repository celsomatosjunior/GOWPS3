+	// The host's lines ("name\tvalue\tg|y|r", boot_main.cpp rpcs3_perf_guest_text): PPU, SPU, RSX, the process,
+	// SPU busy, hold, speed. Read twice a second.
+	struct guest_line { char name[24]; char value[40]; char colour; };
+	guest_line g_guest[12];
+	int g_guest_n;
+
+	void guest_read()
+	{
+		g_guest_n = 0;
+		if (!g_ps3recomp_perf_guest_text) return;
+		char buf[512];
+		const int n = g_ps3recomp_perf_guest_text(static_cast<float>(g_fps), buf, sizeof(buf));
+		if (n <= 0) return;
+		buf[std::min<int>(n, sizeof(buf) - 1)] = 0;
+		char* next = buf;
+		while (next && *next && g_guest_n < 12)
+		{
+			char* line = next;
+			next = std::strchr(line, '\n');
+			if (next) *next++ = 0;
+			char* v = std::strchr(line, '\t');
+			if (!v) continue;
+			*v++ = 0;
+			char* c = std::strchr(v, '\t');
+			if (c) *c++ = 0;
+			if (v[0] == '@') continue;   // the RSX side's own figure (RPCS3's overlay filled it in); the counter has it
+			guest_line& g = g_guest[g_guest_n++];
+			std::snprintf(g.name, sizeof(g.name), "%s", line);
+			std::snprintf(g.value, sizeof(g.value), "%s", v);
+			g.colour = c ? c[0] : 'g';
+		}
+	}
+
+	ImVec4 guest_colour(char c) { return c == 'r' ? DANGER : c == 'y' ? GOLD : OK_GREEN; }
