+				dl->AddRect(ImVec2(p.x - k * 2 * s, p.y - k * 2 * s), ImVec2(q.x + k * 2 * s, q.y + k * 2 * s), rgba(EMBER, (0.11f - k * 0.025f) * pulse),
+				            r + k * 2 * s, 0, 2 * s);
+			dl->AddRectFilled(p, q, rgba(EMBER, 0.12f), r);
+			dl->AddRect(p, q, rgba(EMBER, 0.55f), r, 0, 1.2f * s);
