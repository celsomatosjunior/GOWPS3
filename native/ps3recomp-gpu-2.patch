+extern "C" void ps3rsx_request_capture(void)
+{
+    const std::string dir = fs::get_config_dir() + "captures/";
+    fs::create_path(dir);
+    std::fprintf(stderr, "[ps3rsx] capturing the next frame into %s\n", dir.c_str());
+    g_user_asked_for_frame_capture = true;
+}
+
+extern "C" void ps3rsx_debug_dump(void)
+{
+    const auto render = rsx::get_current_renderer();
+    if (!render)
+    {
+        std::fprintf(stderr, "[ps3rsx] no RSX thread\n");
+        return;
+    }
+    const auto st = +render->state;
+    std::fprintf(stderr, "[ps3rsx] state=0x%x running=%d fifo_state=%d put=0x%x get=0x%x interrupt_lock=%u emu=%u fifo_pos=0x%x last_cmd=0x%x\n",
+                 static_cast<u32>(st), +render->rsx_thread_running, static_cast<int>(render->performance_counters.state),
+                 render->ctrl ? +render->ctrl->put : 0, render->ctrl ? +render->ctrl->get : 0,
+                 +render->external_interrupt_lock, static_cast<u32>(Emu.GetStatus()),
+                 render->fifo_ctrl ? render->fifo_ctrl->get_pos() : ~0u, render->fifo_ctrl ? render->fifo_ctrl->last_cmd() : ~0u);
+    std::fflush(stderr);
+}
+
+// ps3recomp: PS3_RSX_HOLD_WAIT=1[:<spin us>[:<max us>]] -- the RSX thread's
+// report hold (nv4097 get_report: God of War: Ascension's RSX waiting for the
+// SPU post-process round) spins with a yield, ~30 % of the thread in the menu,
+// taking a core from the SPUs it waits for when there are few. After <spin us>
+// (default 50) it sleeps instead until something it waits on moves: an SPU
+// reading a watched report or writing the round's label (the runtime, through
+// g_rsx_hold_kick), a flush request or a flip (the RSX), at most <max us>
+// (default 200) on a high-resolution timer. Only in the "on" windows of
+// CAUSAL_TOGGLE_S. Every 5 s, [hold-wait]: sleeps, woken by a kick or the
+// timer, and idles that found a kick already there.
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#endif
+#include <atomic>
+#include <chrono>
+#include <thread>
+
+extern int g_ps3rsx_causal_on;   // VKPresent.cpp
+// PS3_RSX_SPIN_KICK: the FIFO (RSXFIFO.cpp set_get) reports the EA of the
+// jump-to-self it starts spinning on; the runtime (boot_main.cpp) marks that
+// line so a PPU store or SPU PUT to it kicks this thread's idle sleep.
+extern "C" { void (*g_ps3rsx_spin_watch)(unsigned ea) = nullptr; }
+// The hold and idle waits are on by default (Ascension's defaults): with
+// CAUSAL_KEEP_DEFAULTS=1 they stay on in every CAUSAL_TOGGLE_S window, as the
+// runtime's default-on waits do (perf_threads.c g_causal_dflt_on), so an A/B
+// toggles only the switch under test. Without it they follow the windows: on
+// 4 cores that alone made "on" windows ~2 ms shorter in a null A/B.
+static int rsx_causal_dflt_on()
+{
+    static const int keep = [] { const char* e = std::getenv("CAUSAL_KEEP_DEFAULTS"); return e && *e == '1'; }();
+    return keep || g_ps3rsx_causal_on;
+}
+
+static std::atomic<unsigned long long> s_hold_seq{0};
+static std::atomic<int> s_hold_waiting{0};
+#ifdef _WIN32
+static HANDLE s_hold_event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+#endif
+
+// ps3recomp: RSX_FIFO_TIMELOG=<from s>[:<for s>] -- where the RSX thread's
+// time goes, as timestamped [rsx-fifo] lines (ps3_qpc_us, the clock of the
+// [wid-time] and [rsx-report] lines) for <for s> seconds (default 15) starting
+// <from s> seconds after the first event (the RSX thread's start): FIFO idle
+// begin ("empty", "nop", "spin": a=get b=put) and end ("run": d=idle us),
+// waits inside commands ("sema": a SEMAPHORE_ACQUIRE, a=address b=value;
+// "hold": a GET_REPORT the host held, a=its argument; "zsync": ZCULL sync in
+// a sync point; "flip": the flip, frame limiter included), each logged at its
+// end with d=us, and the FIFO's put moving ("put": a=get b=put, seen through
+// the put line's kick, so only with PS3_RSX_IDLE_WAIT on). The time between
+// events not in a wait is the thread drawing. tools/frame_timeline.py
+// (ascension) splits the gap between EDGE passes with it.
+// The same clock as ps3_qpc_us (cellGcmSys.c), kept here: ps3rsx links
+// without the runtime (ps3rsx_flip_smoke).
+static unsigned long long rsx_qpc_us(void)
+{
+#ifdef _WIN32
+    static LARGE_INTEGER f; if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    LARGE_INTEGER n; QueryPerformanceCounter(&n);
+    return (unsigned long long)(n.QuadPart / (f.QuadPart / 1000000));
+#else
+    return (unsigned long long)std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+#endif
+}
+static std::atomic<unsigned long long> s_ftl_from, s_ftl_to;   // 0: not read yet; ~0: off
+extern "C" int ps3rsx_fifo_timelog_on(void)
+{
+    unsigned long long to = s_ftl_to.load(std::memory_order_relaxed);
+    if (!to) {
+        const char* e = std::getenv("RSX_FIFO_TIMELOG");
+        unsigned long long from = ~0ull, end = ~0ull;
+        if (e && *e) {
+            char* c = nullptr;
+            const double a = std::strtod(e, &c);
+            const double b = c && *c == ':' ? std::strtod(c + 1, nullptr) : 15.0;
+            const unsigned long long now = rsx_qpc_us();
+            from = now + (unsigned long long)(a * 1e6);
+            end = from + (unsigned long long)(b * 1e6);
+            std::fprintf(stderr, "[rsx-fifo] window t=%lluus..%lluus%c", from, end, 10);
+        }
+        unsigned long long expect = 0;
+        if (s_ftl_to.compare_exchange_strong(expect, end)) s_ftl_from.store(from);
+        to = s_ftl_to.load();
+    }
+    if (to == ~0ull) return 0;
+    const unsigned long long now = rsx_qpc_us();
+    return now >= s_ftl_from.load(std::memory_order_relaxed) && now < to;
+}
+extern "C" void ps3rsx_fifo_timelog(const char* what, unsigned a, unsigned b, unsigned long long d_us)
+{
+    std::fprintf(stderr, "[rsx-fifo] t=%lluus %s a=0x%08X b=0x%08X d=%lluus%c", rsx_qpc_us(), what, a, b, d_us, 10);
+}
+
+extern "C" void ps3rsx_hold_kick(void)
+{
+    if (ps3rsx_fifo_timelog_on() && g_ps3rsx_put_ea) {
+        static std::atomic<unsigned> s_last_put{ ~0u };
+        const unsigned put = vm::read32(g_ps3rsx_put_ea);
+        if (s_last_put.exchange(put, std::memory_order_relaxed) != put)
+            ps3rsx_fifo_timelog("put", vm::read32(g_ps3rsx_put_ea + 4), put, 0);
+    }
+    s_hold_seq.fetch_add(1, std::memory_order_seq_cst);
+#ifdef _WIN32
+    if (s_hold_waiting.load(std::memory_order_seq_cst))
+        SetEvent(s_hold_event);
+#endif
+}
+
+extern "C" unsigned long long ps3rsx_hold_seq(void)
+{
+    return s_hold_seq.load(std::memory_order_seq_cst);
+}
+
+extern "C" void ps3rsx_hold_idle(unsigned long long seq, unsigned long long waited_us)
+{
+#ifdef _WIN32
+    static long s_mode = -1, s_spin_us, s_max_us;
+    if (s_mode < 0) {
+        const char* e = std::getenv("PS3_RSX_HOLD_WAIT");
+        char* c = nullptr;
+        s_mode = e ? std::strtol(e, &c, 10) : 0;
+        s_spin_us = c && *c == ':' ? std::strtol(c + 1, &c, 10) : 50;
+        s_max_us = c && *c == ':' ? std::strtol(c + 1, &c, 10) : 200;
+        if (s_mode)
+            std::fprintf(stderr, "[hold-wait] the RSX report hold sleeps after %ld us, %ld us at most\n", s_spin_us, s_max_us);
+    }
+    if (!s_mode || !rsx_causal_dflt_on() || waited_us < (unsigned long long)s_spin_us || !s_hold_event) {
+        std::this_thread::yield();
+        return;
+    }
+
+    static HANDLE t_timer = CreateWaitableTimerExW(nullptr, nullptr, 0x00000002 /* HIGH_RESOLUTION */, TIMER_ALL_ACCESS);
+    static unsigned long long s_n, s_kicked, s_timed, s_skipped, s_us, s_last;
+    const auto now_us = [] {
+        return (unsigned long long)std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    };
+    const unsigned long long t0 = now_us();
+
+    s_hold_waiting.store(1, std::memory_order_seq_cst);
+    if (s_hold_seq.load(std::memory_order_seq_cst) != seq || !t_timer) {
+        s_skipped++;
+    } else {
+        LARGE_INTEGER due;
+        due.QuadPart = -((LONGLONG)s_max_us * 10);
+        SetWaitableTimer(t_timer, &due, 0, nullptr, nullptr, FALSE);
+        HANDLE h[2] = { s_hold_event, t_timer };
+        const DWORD r = WaitForMultipleObjects(2, h, FALSE, INFINITE);
+        CancelWaitableTimer(t_timer);
+        s_n++;
+        if (r == WAIT_OBJECT_0) s_kicked++; else s_timed++;
+    }
+    s_hold_waiting.store(0, std::memory_order_seq_cst);
+
+    const unsigned long long t1 = now_us();
+    s_us += t1 - t0;
+    if (!s_last) s_last = t1;
+    else if (t1 - s_last >= 5000000ull) {
+        std::fprintf(stderr, "[hold-wait] 5 s: %llu sleeps, %.1f us avg; woken by a kick %llu, by the timer %llu; %llu idles found a kick first\n",
+                     s_n, s_n ? (double)s_us / (double)s_n : 0.0, s_kicked, s_timed, s_skipped);
+        s_n = s_kicked = s_timed = s_skipped = s_us = 0;
+        s_last = t1;
+    }
+#else
+    (void)seq; (void)waited_us;
+    std::this_thread::yield();
+#endif
+}
+
+// ps3recomp: PS3_RSX_IDLE_WAIT=1[:<spin us>[:<max us>]] -- the RSX thread on an
+// empty FIFO yields in a loop (half its samples in the first level with 8
+// logical CPUs), taking a core from the SPU and PPU threads that fill it.
+// After <spin us> of that (default 100) it sleeps instead, on the report
+// hold's event, until a write to the FIFO control register's line (the PPU's
+// stores through the coherency bitmap, the SPUs' PUTs), a flush request or a
+// flip kicks it, at most <max us> (default 200) on a high-resolution timer.
+// Only in the "on" windows of CAUSAL_TOGGLE_S. Every 5 s, [idle-wait]: sleeps,
+// woken by a kick or the timer, and timer wakes that found the put moved (a
+// writer that does not kick).
+extern "C" void ps3rsx_fifo_idle(unsigned long long seq, unsigned long long idle_us)
+{
+#ifdef _WIN32
+    static long s_mode = -1, s_spin_us, s_max_us;
+    if (s_mode < 0) {
+        const char* e = std::getenv("PS3_RSX_IDLE_WAIT");
+        char* c = nullptr;
+        s_mode = e ? std::strtol(e, &c, 10) : 0;
+        s_spin_us = c && *c == ':' ? std::strtol(c + 1, &c, 10) : 100;
+        s_max_us = c && *c == ':' ? std::strtol(c + 1, &c, 10) : 200;
+        if (s_mode)
+            std::fprintf(stderr, "[idle-wait] the RSX sleeps on an empty FIFO after %ld us, %ld us at most\n", s_spin_us, s_max_us);
+    }
+    if (!s_mode || !rsx_causal_dflt_on() || idle_us < (unsigned long long)s_spin_us || !s_hold_event || !g_ps3rsx_put_ea) {
+        std::this_thread::yield();
+        return;
+    }
+
+    static HANDLE t_timer = CreateWaitableTimerExW(nullptr, nullptr, 0x00000002 /* HIGH_RESOLUTION */, TIMER_ALL_ACCESS);
+    static unsigned long long s_n, s_kicked, s_timed, s_missed, s_skipped, s_us, s_last;
+    const auto now_us = [] {
+        return (unsigned long long)std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    };
+    const auto put = [] { return vm::read32(g_ps3rsx_put_ea); };
+    const unsigned long long t0 = now_us();
+    const u32 put0 = put();
+
+    s_hold_waiting.store(1, std::memory_order_seq_cst);
+    if (s_hold_seq.load(std::memory_order_seq_cst) != seq || !t_timer) {
+        s_skipped++;
+    } else {
+        LARGE_INTEGER due;
+        due.QuadPart = -((LONGLONG)s_max_us * 10);
+        SetWaitableTimer(t_timer, &due, 0, nullptr, nullptr, FALSE);
+        HANDLE h[2] = { s_hold_event, t_timer };
+        const DWORD r = WaitForMultipleObjects(2, h, FALSE, INFINITE);
+        CancelWaitableTimer(t_timer);
+        s_n++;
+        if (r == WAIT_OBJECT_0) s_kicked++;
+        else { s_timed++; if (put() != put0) s_missed++; }
+    }
+    s_hold_waiting.store(0, std::memory_order_seq_cst);
+
+    const unsigned long long t1 = now_us();
+    s_us += t1 - t0;
+    if (!s_last) s_last = t1;
+    else if (t1 - s_last >= 5000000ull) {
