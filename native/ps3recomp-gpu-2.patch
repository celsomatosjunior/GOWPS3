+	// The notice at an unlock: from the top, centred, one at a time (4.5 s each): the cup in its grade's colour,
+	// "Trophy unlocked", the name.
+	void draw_trophy_toast(float s, float dt)
+	{
+		static float a;
+		static double until;
+		static ps3rsx_trophy cur{};
+		static bool showing;
+		if (!showing && a <= 0)   // the previous one gone: the next
+		{
+			int id = -1;
+			{
+				std::lock_guard lock(g_mu);
+				if (!g_trophy_queue.empty())
+				{
+					id = g_trophy_queue.front();
+					g_trophy_queue.erase(g_trophy_queue.begin());
+				}
+			}
+			if (id >= 0 && g_trophy_get && g_trophy_get(id, &cur) == 0)
+			{
+				showing = true;
+				until = g_time + 4.5;
+			}
+		}
+		if (showing && g_time > until) showing = false;
+		const bool on = showing;
+		a = on ? std::min(1.0f, a + dt / 0.35f) : std::max(0.0f, a - dt / 0.5f);
+		{
+			std::lock_guard lock(g_mu);
+			g_trophy_live = a > 0 || on || !g_trophy_queue.empty();
+		}
+		if (a <= 0) return;
+		// as the console's, in the top right (under the counter when it is there): slides in from the right edge;
+		// the icon framed in the grade's colour, "you earned a trophy", the name, the grade
+		const ImGuiIO& io = ImGui::GetIO();
+		const float k = ease(a), pad = 18 * s, w = 380 * s, h = 84 * s;
+		const float top = pad + (g_counter.load() != COUNTER_OFF && g_corner.load() == 1 && g_open <= 0 ? g_counter_h + 8 * s : 0);
+		const ImVec2 p0(io.DisplaySize.x - pad - w + (1 - k) * (w + pad), top), p1(p0.x + w, p0.y + h);
+		const ImVec4 gc = grade_colour(cur.grade);
+		ImGui::SetNextWindowPos(p0);
+		ImGui::SetNextWindowSize(ImVec2(w, h));
+		ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0, 0));
+		ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 0);
+		ImGui::Begin("##trophy", nullptr, ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoBackground |
+		             ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoMove);
+		ImDrawList* dl = ImGui::GetWindowDrawList();
+		const float r = 10 * s, glow = 0.6f + 0.4f * std::sin(static_cast<float>(g_time) * 2.6f);
+		for (int i = 1; i <= 4; i++)   // the shadow
+			dl->AddRectFilled(ImVec2(p0.x - i * 2 * s, p0.y - i * s), ImVec2(p1.x + i * 2 * s, p1.y + i * 3 * s), IM_COL32(0, 0, 0, 22), r + i * 2 * s);
+		dl->AddRectFilled(p0, p1, ImGui::GetColorU32(ImVec4(0.067f, 0.031f, 0.022f, 0.95f)), r);
+		dl->AddRectFilledMultiColor(ImVec2(p0.x + r, p0.y), ImVec2(p1.x - r, p0.y + h * 0.5f), rgba(EMBER, 0.10f), rgba(EMBER, 0.02f),
+		                            rgba(EMBER, 0), rgba(EMBER, 0));
+		dl->AddRect(p0, p1, rgba(GOLD, 0.45f), r, 0, 1.2f * s);
+		dl->AddRectFilled(ImVec2(p0.x, p0.y + r), ImVec2(p0.x + 3 * s, p1.y - r), rgba(gc, 0.9f));   // the grade's edge
+		// the icon, framed and glowing in the grade's colour
+		const float ic = h - 22 * s;
+		const ImVec2 i0(p0.x + 14 * s, p0.y + 11 * s), i1(i0.x + ic, i0.y + ic);
+		dl->AddRect(ImVec2(i0.x - 3 * s, i0.y - 3 * s), ImVec2(i1.x + 3 * s, i1.y + 3 * s), rgba(gc, 0.25f * glow), 8 * s, 0, 5 * s);
+		if (!icon(dl, cur.id, i0, i1, IM_COL32_WHITE, 6 * s))
+			cup(dl, ImVec2((i0.x + i1.x) / 2, (i0.y + i1.y) / 2), ic * 0.32f, ImGui::GetColorU32(gc), 1.8f * s, true);
+		dl->AddRect(i0, i1, rgba(gc, 0.9f), 6 * s, 0, 1.4f * s);
+		// the text
+		const float tx = i1.x + 14 * s;
+		float ty = p0.y + 12 * s;
+		dl->AddText(f_small, f_small->FontSize, ImVec2(tx, ty), rgba(GOLD, 0.95f), L("Você ganhou um troféu!", "You earned a trophy!"));
+		ty += f_small->FontSize + 4 * s;
+		const char* name = cur.name ? cur.name : "";
+		dl->AddText(f_body, f_body->FontSize, ImVec2(tx, ty), ImGui::GetColorU32(CREAM), name, nullptr);
+		ty += f_body->FontSize + 5 * s;
+		cup(dl, ImVec2(tx + 6 * s, ty + f_small->FontSize * 0.5f), 6 * s, ImGui::GetColorU32(gc), 1.2f * s, true);
+		dl->AddText(f_small, f_small->FontSize, ImVec2(tx + 16 * s, ty), ImGui::GetColorU32(gc), grade_name(cur.grade));
+		ImGui::End();
+		ImGui::PopStyleVar(2);
+	}
