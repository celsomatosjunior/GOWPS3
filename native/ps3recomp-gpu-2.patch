diff --git a/gpu/shim/lv2_rsx.cpp b/gpu/shim/lv2_rsx.cpp
new file mode 100644
index 00000000..b78fda9e
--- /dev/null
+++ b/gpu/shim/lv2_rsx.cpp
@@ -0,0 +1,227 @@
+// ps3recomp shim: the part of RPCS3's sys_rsx (Emu/Cell/lv2/sys_rsx.cpp) that
+// the RSX itself calls back into. Under RPCS3 with an LLE libgcm the RSX
+// reports flips, queued flips, vblanks and user commands through
+// sys_rsx_context_attribute and lv2 event ports; here there is no lv2, and
+// rsx::thread::send_event hands the events to the host (gpu/bridge). The
+// context itself is set up by the bridge (ps3rsx_start), not by syscalls.
+// The bodies follow RPCS3's. GPL-2.0, like RPCS3.
+#include "stdafx.h"
+#include "Emu/Cell/lv2/sys_rsx.h"
+#include "Emu/Cell/ErrorCodes.h"
+#include "Emu/Cell/timers.hpp"
+#include "Emu/RSX/RSXThread.h"
+
+LOG_CHANNEL(sys_rsx);
+
+// Set by the host (gpu/bridge/ps3rsx_thread.cpp).
+void (*g_ps3recomp_rsx_event_hook)(u64 data1, u64 event_flags, u64 data3) = nullptr;
+void (*g_ps3recomp_rsx_write_hook)(u32 address, u32 size) = nullptr;
+bool (*g_ps3recomp_rsx_report_hold)(u32 arg, u64 waited_us) = nullptr;
+void (*g_ps3recomp_rsx_report_hook)(u32 address, bool awaited) = nullptr;
+int (*g_ps3recomp_perf_guest_text)(float fps, char* buf, unsigned size) = nullptr;
+
+// Unknown error code returned by sys_rsx_context_attribute
+enum sys_rsx_error : s32
+{
+    LV1_ILLEGAL_PARAMETER_VALUE = -17
+};
+
+template <>
+void fmt_class_string<sys_rsx_error>::format(std::string& out, u64 arg)
+{
+    format_enum(out, arg, [](auto error)
+    {
+        switch (error)
+        {
+            STR_CASE(LV1_ILLEGAL_PARAMETER_VALUE);
+        }
+
+        return unknown;
+    });
+}
+
+static u64 rsx_timeStamp()
+{
+    return get_timebased_time();
+}
+
+bool rsx::thread::send_event(u64 data1, u64 event_flags, u64 data3)
+{
+    if (g_ps3recomp_rsx_event_hook)
+    {
+        g_ps3recomp_rsx_event_hook(data1, event_flags, data3);
+    }
+
+    return true;
+}
+
+error_code sys_rsx_context_attribute(u32 context_id, u32 package_id, u64 a3, u64 a4, u64 a5, u64 a6)
+{
+    if (auto cpu = get_current_cpu_thread())
+    {
+        cpu->state += cpu_flag::wait;
+    }
+
+    const auto render = rsx::get_current_renderer();
+
+    if (!render->dma_address)
+    {
+        return {CELL_EINVAL, "dma_address is 0"};
+    }
+
+    if (context_id != 0x55555555)
+    {
+        return {CELL_EINVAL, "context_id is 0x%x", context_id};
+    }
+
+    auto& driverInfo = *vm::_ptr<RsxDriverInfo>(render->driver_info);
+
+    switch (package_id)
+    {
+    case 0x101: // Display sync set, cellGcmSetFlipMode
+        render->requested_vsync.store(a4 == 2);
+        break;
+
+    case 0x102: // Display flip (GCM_FLIP_HEAD in the command stream)
+    {
+        u32 flip_idx = ~0u;
+
+        if ((a4 & 0x80000000) != 0)
+        {
+            ensure(a3 < 2);
+
+            // Flip the buffer queued last (0x103)
+            const u8 idx_check = a4 & 0xf;
+            flip_idx = idx_check > 7 ? +driverInfo.head[a3].lastQueuedBufferId : idx_check;
+        }
+        else
+        {
+            // Flip the display buffer at this offset
+            for (u32 i = 0; i < render->display_buffers_count; ++i)
+            {
+                if (render->display_buffers[i].offset == a4)
+                {
+                    flip_idx = i;
+                    break;
+                }
+            }
+
+            if (flip_idx == ~0u)
+            {
+                sys_rsx.error("Display Flip: Couldn't find display buffer offset, flipping 0. Offset: 0x%x", a4);
+                flip_idx = 0;
+            }
+        }
+
+        if (!render->request_emu_flip(flip_idx))
+        {
+            if (auto cpu = get_current_cpu_thread())
+            {
+                cpu->state += cpu_flag::exit;
+                cpu->state += cpu_flag::again;
+            }
+
+            return {};
+        }
+
+        break;
+    }
+
+    case 0x103: // Display queue (GCM_DRIVER_QUEUE)
+    {
+        ensure(a3 < 2);
+
+        driverInfo.head[a3].lastQueuedBufferId = static_cast<u32>(a4);
+        driverInfo.head[a3].flipFlags |= 0x40000000 | (1 << a4);
+
+        render->on_frame_end(static_cast<u32>(a4));
+        render->send_event(0, SYS_RSX_EVENT_QUEUE_BASE << a3, 0);
+        break;
+    }
+
+    case 0x104: // Display buffer
+    {
+        const u8 id = a3 & 0xFF;
+
+        if (id > 7)
+        {
+            return LV1_ILLEGAL_PARAMETER_VALUE;
+        }
+
+        std::lock_guard lock(render->sys_rsx_mtx);
+
+        render->display_buffers[id].width = static_cast<u32>(a4 >> 32);
+        render->display_buffers[id].height = static_cast<u32>(a4);
+        render->display_buffers[id].pitch = static_cast<u32>(a5 >> 32);
+        render->display_buffers[id].offset = static_cast<u32>(a5);
+        render->display_buffers_count = std::max<u32>(id + 1, render->display_buffers_count);
+        break;
+    }
+
+    case 0x10a: // Flip status (cellGcmResetFlipStatus)
+    {
+        if (a3 > 7)
+        {
+            return LV1_ILLEGAL_PARAMETER_VALUE;
+        }
+
+        ensure(a3 < 2);
+
+        driverInfo.head[a3].flipFlags.atomic_op([&](be_t<u32>& flipStatus)
+        {
+            flipStatus = (flipStatus & static_cast<u32>(a4)) | static_cast<u32>(a5);
+        });
+
+        break;
+    }
+
+    case 0xFEC: // Flip shown
+    {
+        driverInfo.head[1].flipFlags |= 0x80000000;
+        driverInfo.head[1].lastFlipTime = rsx_timeStamp();
+        driverInfo.head[1].flipBufferId = static_cast<u32>(a3);
+
+        // Flip label (label 1) cleared
+        vm::_ptr<atomic_t<u128>>(render->label_addr + 0x10)->store(u128{});
+        render->send_event(0, SYS_RSX_EVENT_FLIP_BASE << 1, 0);
+        break;
+    }
+
+    case 0xFED: // VBlank (the RSX's vblank thread)
+    {
+        ensure(a3 < 2);
+
+        driverInfo.head[a3].lastSecondVTime.atomic_op([&](be_t<u64>& time)
+        {
+            a4 = std::max<u64>(a4, time + 1);
+            time = a4;
+        });
+
+        const u64 current_time = rsx_timeStamp();
+        driverInfo.head[a3].lastVTimeLow = static_cast<u32>(current_time);
+        driverInfo.head[a3].lastVTimeHigh = static_cast<u32>(current_time >> 32);
+        driverInfo.head[a3].vBlankCount++;
+
+        u64 event_flags = SYS_RSX_EVENT_VBLANK;
+
+        if (render->enable_second_vhandler)
+        {
+            event_flags |= SYS_RSX_EVENT_SECOND_VBLANK_BASE << a3;
+        }
+
+        render->send_event(0, event_flags, 0);
+        break;
+    }
+
+    case 0xFEF: // User command (GCM_SET_USER_COMMAND)
+        driverInfo.userCmdParam = static_cast<u32>(a4);
+        render->send_event(0, SYS_RSX_EVENT_USER_CMD, 0);
+        break;
+
+    default:
+        sys_rsx.todo("sys_rsx_context_attribute(package_id=0x%x, a3=0x%llx, a4=0x%llx, a5=0x%llx, a6=0x%llx)", package_id, a3, a4, a5, a6);
+        return {CELL_EINVAL, "unsupported package id %d", package_id};
+    }
+
+    return CELL_OK;
+}
