+			using unsigned_type = std::make_unsigned_t<T>;
+			unsigned_type result{};
+			constexpr u32 bit_width = MaxBits ? MaxBits : (sizeof(T) * 8);
+			value = {};
+
+			for (u32 i = 0;; i += 7)
+			{
+				u8 byte_data = 0;
+
+				if (!raw_serialize(&byte_data, 1))
+				{
+					return false;
+				}
+
+				const unsigned_type payload = static_cast<unsigned_type>(byte_data % 0x80);
+
+				if (i >= bit_width || payload > (~unsigned_type{} >> i))
+				{
+					return false;
+				}
+
+				result |= payload << i;
+
+				if (!(byte_data & 0x80))
+				{
+					value = static_cast<T>(result);
+					break;
+				}
+
+				if (i > bit_width - 7)
+				{
+					return false;
+				}
+			}
+
+			return true;
+		}
+
+		// (De)serialization function
+		template <typename T>
+		bool serialize(T& obj)
