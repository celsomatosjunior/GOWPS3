+#!/usr/bin/env python3
+"""Copy the part of RPCS3 that ps3recomp's GPU backend builds into gpu/rsx.
+
+    vendor_rpcs3.py <rpcs3 checkout> [--manifest gpu/rsx/MANIFEST.txt] [--refresh]
+
+The manifest lists paths relative to the RPCS3 checkout, one per line (# for
+comments). A line ending in /** takes a whole directory. RPCS3 keeps most of
+its code one level down, in rpcs3/; that level is dropped in the copy, so
+rpcs3/Emu/RSX lands in gpu/rsx/Emu/RSX next to Utilities/ and 3rdparty/.
+Files are copied as they are; ps3recomp's own changes are made in gpu/rsx
+afterwards, each marked `ps3recomp:`, and are re-applied by hand when the copy
+is refreshed (see gpu/rsx/VENDOR.txt). Only files not in gpu/rsx yet are
+copied, so those local changes survive adding to the manifest; --refresh
+overwrites every file
+(a refresh from upstream, after which the `ps3recomp:` changes are redone).
+Files the manifest no longer lists are not deleted.
+"""
+import argparse
+import os
+import shutil
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+GPU = os.path.dirname(HERE)
+
+
+def entries(manifest):
+    for line in open(manifest, encoding='utf-8'):
+        line = line.split('#', 1)[0].strip()
+        if line:
+            yield line
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('rpcs3')
+    ap.add_argument('--manifest', default=os.path.join(GPU, 'rsx', 'MANIFEST.txt'))
+    ap.add_argument('--refresh', action='store_true', help='overwrite files already copied')
+    args = ap.parse_args()
+    dst_root = os.path.join(GPU, 'rsx')
+    copied = 0
+    for e in entries(args.manifest):
+        if e.endswith('/**'):
+            base = os.path.join(args.rpcs3, e[:-3])
+            files = [os.path.relpath(os.path.join(dp, f), args.rpcs3)
+                     for dp, _, fs in os.walk(base) for f in fs]
+        else:
+            files = [e]
+        for rel in files:
+            src = os.path.join(args.rpcs3, rel)
+            if not os.path.isfile(src):
+                print(f'missing in the checkout: {rel}', file=sys.stderr)
+                continue
+            out = rel.replace(os.sep, '/')
+            if out.startswith('rpcs3/'):
+                out = out[len('rpcs3/'):]
+            dst = os.path.join(dst_root, out)
+            if os.path.exists(dst) and not args.refresh:
+                continue
+            os.makedirs(os.path.dirname(dst), exist_ok=True)
+            shutil.copy2(src, dst)
+            copied += 1
+    print(f'{copied} files copied into {dst_root}')
+
+
+if __name__ == '__main__':
+    main()
