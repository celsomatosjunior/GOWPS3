diff --git a/gpu/CMakeLists.txt b/gpu/CMakeLists.txt
new file mode 100644
index 00000000..b0fc4ea2
--- /dev/null
+++ b/gpu/CMakeLists.txt
@@ -0,0 +1,185 @@
+# ps3rsx: RPCS3's RSX as a ps3recomp GPU backend, built from the part of RPCS3
+# copied into rsx/ (see rsx/VENDOR.txt) plus shim/ for what that part
+# expects from the rest of RPCS3.
+#
+#   Windows: MSVC (cl). clang-cl does not build RPCS3's code.
+#   macOS:   Apple clang, Vulkan through MoltenVK (brew install molten-vk vulkan-loader vulkan-headers).
+#   Linux:   gcc or clang, the Vulkan loader and OpenGL.
+#   Android: the NDK's clang (its toolchain file), Vulkan only, arm64.
+#
+#   cmake -S ps3recomp/gpu -B work/gpu-build -G Ninja -DCMAKE_BUILD_TYPE=Release
+#   ninja -C work/gpu-build
+#
+# GPL-2.0, like RPCS3.
+cmake_minimum_required(VERSION 3.24)
+project(ps3rsx C CXX)
+if(APPLE)
+    enable_language(OBJCXX)
+endif()
+
+if(MSVC AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
+    message(FATAL_ERROR "ps3rsx does not build with clang-cl; use cl.exe on Windows")
+endif()
+if(NOT MSVC AND NOT APPLE AND NOT ANDROID AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    message(FATAL_ERROR "ps3rsx builds on Windows (MSVC), macOS, Linux and Android")
+endif()
+
+set(CMAKE_CXX_STANDARD 23)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+if(MSVC)
+    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreadedDLL")
+endif()
+
+find_package(Vulkan REQUIRED)
+
+set(RPCS3 ${CMAKE_CURRENT_SOURCE_DIR}/rsx)
+
+# The two libraries the RSX links, as git submodules at the commits RPCS3
+# 1b336f41f uses, built with RPCS3's options (its 3rdparty/CMakeLists.txt):
+# glslang compiles the RSX's GLSL to SPIR-V for Vulkan, asmjit builds its SIMD
+# helpers at run time. ENABLE_HLSL departs from RPCS3: the runtime's own
+# Vulkan RSX backend (libs/video/rsx_shader_spirv.cpp) translates the guest's
+# programs from HLSL with this same glslang, and one copy in a binary is the
+# only safe number -- two leave the linker to pick each symbol from either.
+set(ENABLE_PCH OFF CACHE BOOL "" FORCE)
+set(BUILD_EXTERNAL OFF CACHE BOOL "" FORCE)
+set(SKIP_GLSLANG_INSTALL ON CACHE BOOL "" FORCE)
+set(ENABLE_SPVREMAPPER OFF CACHE BOOL "" FORCE)
+set(ENABLE_GLSLANG_BINARIES OFF CACHE BOOL "" FORCE)
+set(ENABLE_HLSL ON CACHE BOOL "" FORCE)
+set(ENABLE_OPT OFF CACHE BOOL "" FORCE)
+set(ENABLE_CTEST OFF CACHE BOOL "" FORCE)
+set(GLSLANG_TESTS OFF CACHE BOOL "" FORCE)
+add_subdirectory(third_party/glslang EXCLUDE_FROM_ALL)
+
+set(ASMJIT_EMBED TRUE)
+set(ASMJIT_STATIC TRUE)
+set(ASMJIT_BUILD_X86 TRUE)
+set(ASMJIT_BUILD_ARM FALSE)
+set(ASMJIT_BUILD_TEST FALSE)
+set(ASMJIT_NO_DEPRECATED TRUE)
+set(ASMJIT_DIR ${CMAKE_CURRENT_SOURCE_DIR}/third_party/asmjit)
+include(${ASMJIT_DIR}/CMakeLists.txt)
+add_library(asmjit STATIC ${ASMJIT_SRC})
+target_include_directories(asmjit SYSTEM PUBLIC ${ASMJIT_DIR}/src)
+target_link_libraries(asmjit PRIVATE ${ASMJIT_DEPS})
+
+file(GLOB_RECURSE PS3RSX_RPCS3_SOURCES CONFIGURE_DEPENDS ${RPCS3}/*.cpp)
+file(GLOB PS3RSX_SHIM_SOURCES CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/shim/*.cpp)
+# The GL backend is WGL. On macOS the present path is Vulkan through MoltenVK,
+# on Android Vulkan on the window's ANativeWindow.
+if(APPLE OR ANDROID)
+    list(FILTER PS3RSX_RPCS3_SOURCES EXCLUDE REGEX "/Emu/RSX/GL/")
+endif()
+if(APPLE)
+    list(APPEND PS3RSX_RPCS3_SOURCES ${RPCS3}/Emu/RSX/VK/vkutils/metal_layer.mm)
+endif()
+
+# The in-game panel (F1): Dear ImGui (third_party/imgui, MIT) with its Vulkan and
+# OpenGL 3 backends, drawn by the renderers over RPCS3's overlays.
+set(PS3RSX_OVERLAY_SOURCES
+    bridge/ps3rsx_overlay.cpp
+    bridge/ps3rsx_overlay_vk.cpp
+    third_party/imgui/imgui.cpp
+    third_party/imgui/imgui_draw.cpp
+    third_party/imgui/imgui_tables.cpp
+    third_party/imgui/imgui_widgets.cpp
+    third_party/imgui/imgui_impl_vulkan.cpp
+)
+if(NOT (APPLE OR ANDROID))
+    list(APPEND PS3RSX_OVERLAY_SOURCES
+        bridge/ps3rsx_overlay_gl.cpp
+        third_party/imgui/imgui_impl_opengl3.cpp)
+endif()
+
+add_library(ps3rsx STATIC
+    ${PS3RSX_RPCS3_SOURCES}
+    ${PS3RSX_SHIM_SOURCES}
+    bridge/ps3rsx_memory.cpp
+    bridge/ps3rsx_thread.cpp
+    bridge/ps3rsx_interp.cpp
+    ${PS3RSX_OVERLAY_SOURCES}
+)
+target_include_directories(ps3rsx
+    PUBLIC bridge
+    PRIVATE
+        shim
+        ${RPCS3}
+        ${RPCS3}/Emu
+        ${RPCS3}/3rdparty/GL
+        ${RPCS3}/3rdparty/stblib/stb
+        ${RPCS3}/3rdparty/GPUOpen/VulkanMemoryAllocator/include
+        third_party/glslang
+        third_party/imgui
+)
+target_link_libraries(ps3rsx PUBLIC Vulkan::Vulkan)
+# RPCS3's own flags for its emulator library (rpcs3/Emu/CMakeLists.txt and
+# buildfiles/cmake/ConfigureCompiler.cmake).
+target_compile_definitions(ps3rsx PRIVATE PS3RECOMP_RSX_ONLY HAVE_VULKAN ASMJIT_STATIC)
+if(MSVC)
+    target_compile_definitions(ps3rsx PRIVATE
+        NOMINMAX UNICODE _UNICODE _WIN32_WINNT=0x0A00
+        _CRT_SECURE_NO_DEPRECATE=1 _CRT_NON_CONFORMING_SWPRINTFS=1 _SCL_SECURE_NO_WARNINGS=1
+        _ENABLE_EXTENDED_ALIGNED_STORAGE=1 _HAS_EXCEPTIONS=0
+        _SILENCE_CXX17_ITERATOR_BASE_CLASS_DEPRECATION_WARNING=1)
+    target_compile_options(ps3rsx PRIVATE
+        /EHsc /utf-8 /Zc:throwingNew- /constexpr:steps16777216 /MP
+        /wd4530 /wd4805 /wd4804 /wd4200
+        /std:c++latest)
+    target_link_libraries(ps3rsx PUBLIC opengl32 pdh dbghelp bcrypt)
+elseif(APPLE)
+    foreach(prefix /opt/homebrew /usr/local)
+        if(EXISTS "${prefix}/include/MoltenVK/mvk_vulkan.h")
+            target_include_directories(ps3rsx PRIVATE "${prefix}/include")
+        endif()
+    endforeach()
+    target_compile_definitions(ps3rsx PRIVATE WITHOUT_OPENGL)
+    target_compile_options(ps3rsx PRIVATE
+        -fexceptions -fno-strict-aliasing
+        -Wno-unused-parameter -Wno-unused-variable -Wno-unused-function
+        -Wno-reorder -Wno-missing-field-initializers -Wno-deprecated-declarations
+        -Wno-sign-compare -Wno-unknown-pragmas -Wno-unused-but-set-variable)
+    target_link_libraries(ps3rsx PUBLIC
+        "-framework Metal" "-framework QuartzCore" "-framework Foundation"
+        "-framework AppKit" "-framework IOKit" "-framework CoreFoundation")
+elseif(ANDROID)
+    target_compile_definitions(ps3rsx PRIVATE WITHOUT_OPENGL VK_USE_PLATFORM_ANDROID_KHR)
+    # ARMv8.2: RPCS3's atomics (util/asm.hpp) use the LSE instructions, which
+    # every arm64 Android device of recent years has.
+    target_compile_options(ps3rsx PRIVATE
+        -march=armv8.2-a
+        -fexceptions -fno-strict-aliasing
+        -Wno-unused-parameter -Wno-unused-variable -Wno-unused-function
+        -Wno-reorder -Wno-missing-field-initializers -Wno-deprecated-declarations
+        -Wno-sign-compare -Wno-unknown-pragmas -Wno-unused-but-set-variable)
+    target_link_libraries(ps3rsx PUBLIC android log)
+else()
+    find_package(OpenGL REQUIRED)
+    find_package(X11)
+    target_compile_options(ps3rsx PRIVATE
+        -fexceptions -fno-strict-aliasing
+        -Wno-unused-parameter -Wno-unused-variable -Wno-unused-function
+        -Wno-reorder -Wno-missing-field-initializers -Wno-deprecated-declarations
+        -Wno-sign-compare)
+    target_link_libraries(ps3rsx PUBLIC OpenGL::GL)
+    target_link_libraries(ps3rsx PUBLIC ${CMAKE_DL_LIBS})   # the panel's OpenGL loader (imgui_impl_opengl3)
+    if(X11_FOUND)
+        target_compile_definitions(ps3rsx PRIVATE HAVE_X11)
+        target_link_libraries(ps3rsx PUBLIC X11::X11)
+    endif()
+endif()
+set_target_properties(ps3rsx PROPERTIES CXX_STANDARD 23)
+
+# glslang-default-resource-limits: the runtime's translator asks for glslang's
+# default limits (GetDefaultResources); RPCS3 keeps its own.
+target_link_libraries(ps3rsx PUBLIC SPIRV glslang glslang-default-resource-limits asmjit)
+
+if(WIN32)
+    add_executable(ps3rsx_flip_smoke tests/ps3rsx_flip_smoke.c)
+    target_link_libraries(ps3rsx_flip_smoke PRIVATE ps3rsx)
+    target_link_options(ps3rsx_flip_smoke PRIVATE /MAP /STACK:8388608)
+else()
+    # Carries the link line ps3rsx.cmake reads back. The flip smoke test needs an HWND.
+    add_executable(ps3rsx_link_probe tests/ps3rsx_link_probe.c)
+    target_link_libraries(ps3rsx_link_probe PRIVATE ps3rsx)
+endif()
diff --git a/gpu/README.md b/gpu/README.md
new file mode 100644
index 00000000..6d15f693
--- /dev/null
+++ b/gpu/README.md
@@ -0,0 +1,77 @@
+# gpu: RPCS3's RSX renderer for ps3recomp
+
+Work in progress on the `ascension-v2` branch: RPCS3's RSX (its NV4097 state machine, shader decompilers and Vulkan/OpenGL backends) draws a title in place of live draw, selected at run time with `PS3_RSX=rpcs3`. Windows uses MSVC and the Vulkan SDK. macOS uses Apple clang and MoltenVK (`scripts/mac/build-gpu.sh`, then `RPCS3=1 scripts/mac/build.sh`); OpenGL stays off there because that backend is WGL. Linux uses gcc or clang. Live draw stays the default.
+
+The layout follows the God of War III PC port (`FelipePrado0/gow3_pc`, which does the same with shadPS4's GPU): only the emulator's GPU code is copied in, and a shim stands in for the rest of the emulator.
+
+## Licence
+
+RPCS3 is GPL-2.0. This folder, and any build that links it, is GPL-2.0; the rest of ps3recomp stays MIT when built without it.
+
+## Layout
+
+- `rsx/`: the part of RPCS3 the RSX builds from (RPCS3 1b336f41f): `Emu/RSX` (the GPU), `Emu/Memory`, `Utilities`, `util`, the headers they include and a few header-only libraries. `MANIFEST.txt` lists the files, `VENDOR.txt` the origin and every local change (marked `ps3recomp:`, removed code guarded by `PS3RECOMP_RSX_ONLY`).
+- `shim/`: what the copied code expects from the rest of RPCS3: the `Emulator` object, `cpu_thread` for a process whose only RPCS3 thread is the RSX, the part of `sys_rsx` the RSX calls back into (flips, vblanks, user commands; GCM events go to the host), and stubs.
+- `bridge/`: ps3recomp's side: guest memory on RPCS3's `vm` (`ps3rsx_init_memory`), the RSX thread on a host-chosen GCM context (`ps3rsx_start`), the IO map, display buffers and flips, faults on pages the RSX protects, and a C interface for the runtime (`ps3rsx.h`).
+- `third_party/`: glslang and asmjit, git submodules at the commits RPCS3 1b336f41f uses (`git submodule update --init --depth 1`).
+- `tests/ps3rsx_flip_smoke.c`: the RSX without a game: a FIFO that clears display buffer 0 and flips it; passes when the FIFO is consumed and the flip reported. `SMOKE_STACKS=1` prints every thread's stack (resolve with `ps3rsx_flip_smoke.map`).
+- `tools/vendor_rpcs3.py`: copies the manifest's files from an RPCS3 checkout (only missing ones; `--refresh` overwrites).
+- `ps3rsx.cmake`: `ps3rsx_link(<target> <build dir> SOURCES ...)` links a port (which may be built by clang-cl) against the library built here, and links it with 8 MB thread stacks, as RPCS3 does.
+
+## Building
+
+With MSVC (`cl`; RPCS3's code does not build with clang-cl), from an x64 Native Tools prompt:
+
+    git submodule update --init --depth 1 gpu/third_party/glslang gpu/third_party/asmjit
+    cmake -S ps3recomp/gpu -B work/gpu-build -G Ninja -DCMAKE_C_COMPILER=cl -DCMAKE_CXX_COMPILER=cl -DCMAKE_BUILD_TYPE=Release
+    ninja -C work/gpu-build ps3rsx_flip_smoke
+
+A first build takes a few minutes (the RSX's ~160 sources plus glslang). Ascension links it with `-DASCENSION_RPCS3_RSX=ON` (`ASCENSION_RPCS3_BUILD` defaults to `work/gpu-build`).
+
+## Running a title on RPCS3's RSX
+
+With the port's option on and `PS3_RSX=rpcs3`, `boot_main.cpp` takes guest memory from `ps3rsx_init_memory()` and registers `CellGcmRsxHooks` with cellGcmSys: `cellGcmInit` starts the RSX with its context at `CELL_GCM_RSX_CONTEXT` (0x2E000000; the control register, labels and reports move there), the IO map and display buffers are mirrored into it, flips go into the command stream as the GCM driver's flip method (0xE920), and flip and user-command events come back through `cellGcm_rsx_event`. The runtime's FIFO walker and live draw stay off; the host ticker only opens the window, pumps its messages and beats vblank. Faults on pages the RSX's texture cache protects go to it from the runtime's exception handler (`ps3rsx_handle_fault`, which also retries when the page's own permissions allow the access, as RPCS3 does). `vm_commit` accepts a range that is already read-write (RPCS3's memory is mapped views, allocated up front).
+
+Options: `PS3_RSX_RENDERER=opengl` for OpenGL; `PS3_RSX_DRAW=0` keeps live draw on RPCS3's memory. Diagnostics: `PS3RSX_DUMP=1` (the RSX's state every 5 s), `GCM_RSX_EVDBG=1`, `GCM_HOLD_LOG=1`, `PS3RSX_LOG=<level>` (RPCS3's log, 0 fatal .. 7 trace; default 5).
+
+What RPCS3 needed for God of War: Ascension (in `rsx/` and the bridge): label and report writes reported to the host (`g_ps3recomp_rsx_write_hook`) so SPU lock-line reservations on them are lost as on a PPU store; the title's type-255 report at offset 0xFFFFFF written without the 16-byte atomic (it is unaligned); and a hold before that report (`g_ps3recomp_rsx_report_hold`, while serving the RSX's flush requests): the title's SPU RsxSync job turns it into its post-process round's signal, and RPCS3's RSX reaches the next frame's fence before the round has run, which loses the signal and leaves the frame's semaphore (0x510/0x520) unreleased. The hold waits for the tasks to start (20 ms) and finish (100 ms).
+
+State, 2026-10-19: boots to the first level, with the menu around 28 FPS and the level around 9 FPS, limited by the recompiled SPUs. No shader cache on disk or shader-loading screen yet (planned: our own screen, through `rsx::shader_loading_dialog` and the host's message dialog).
+
+### Native SPU writes and FIFO coherence
+
+RPCS3's atomic FIFO fetch takes an exclusive IO-map reservation lock while it
+copies command bytes. Its own SPU DMA takes the corresponding shared lock.
+Native SPU PUTs must participate in that protocol as well: a plain host memcpy
+could expose a partially replaced command block to the reader. In Ascension,
+the first-error trace saw a float (`C129EAD0`) at IO `00597610`, followed almost
+immediately by a valid semaphore header (`00041D6C`) at that same location.
+Both cached and direct fetch modes encountered malformed command streams.
+
+`ps3rsx_dma_put` now copies host SPU PUTs under `reservation_lock<false, 1>`,
+matching RPCS3's SPU DMA side. The boot harness installs it through
+`g_spu_dma_put_copy_hook`; SPU-to-SPU reservation notifications stay in their
+existing order. Local GPU-memory copies and direct FIFO mode retain the normal
+copy path. The synchronized path is enabled by default for this backend;
+`PS3_RSX_DMA_LOCK=0` disables it for diagnosis.
+
+FIFO recovery had a separate packet-boundary bug: after a method called
+`recover_fifo`/`set_get`, the old packet's `read_unsafe` drain advanced past the
+new header and interpreted its argument as a command. It now preserves the
+new position when it is already the next command entry. The headless regression
+`tests/test_fifo_recovery.py` extracts the production methods and exercises
+normal packet completion in both fetch modes, empty queues, handler recovery
+and fetch-error recovery. It reproduced the skipped header before the fix and
+passes after it. From the Ascension checkout: `scripts/windows/test-fifo.ps1`.
+
+Diagnostics: `PS3_RSX_FIFO=atomic` (default), `ordered` or `direct` selects the
+existing reader. `PS3_RSX_FIFO_DIAG=1` records 64 recent headers and dumps them
+with surrounding memory on the first recovery; the diagnostic is off by
+default. Direct mode was an A/B investigation, not a fix for this issue.
+
+Validation in Ascension: boot-to-level runs of 180 s (diagnostic enabled) and
+240 s (new default, diagnostic disabled) both completed without malformed
+methods, FIFO errors or a fatal RSX exception. Earlier unsynchronized runs
+produced those errors in both atomic and direct modes. This is a stability
+result, not evidence of an FPS gain; native-job performance needs a fresh A/B
+with the synchronized copy path enabled.
diff --git a/gpu/bridge/ps3rsx.h b/gpu/bridge/ps3rsx.h
new file mode 100644
index 00000000..47bc6063
--- /dev/null
+++ b/gpu/bridge/ps3rsx.h
@@ -0,0 +1,137 @@
+/* ps3rsx: RPCS3's RSX as a ps3recomp GPU backend (gpu/README.md).
+ *
+ * A plain C interface: the library behind it (ps3rsx.lib) is built with RPCS3,
+ * by MSVC, from gpu/rpcs3_build; ps3recomp's runtime calls it from any
+ * compiler. Selected at run time with PS3_RSX=rpcs3. GPL-2.0, like RPCS3. */
+#ifndef PS3RSX_H
+#define PS3RSX_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 1 when the environment asks for RPCS3's RSX (PS3_RSX=rpcs3). */
+int ps3rsx_requested(void);
+
+/* Guest memory on RPCS3's memory manager, so that its RSX sees the same
+ * bytes the recompiled code reads and writes: initialises RPCS3's vm and maps,
+ * fully allocated, every range ps3recomp's flat model touches. Returns the
+ * guest base (RPCS3's vm::g_base_addr), to become ps3recomp's vm_base, or 0
+ * when it could not be set up. Call once, before the ELF is loaded. */
+unsigned char* ps3rsx_init_memory(void);
+
+/* A guest-memory access fault at host_addr, from ps3recomp's exception
+ * handler. Returns 1 when RPCS3's RSX took it (a page its texture cache had
+ * protected; execution can continue), 0 otherwise. */
+int ps3rsx_handle_fault(const void* host_addr, int is_write);
+
+/* Copy a native SPU PUT under the IO-map lock used by the atomic FIFO
+ * fetcher. Returns 1 if copied; 0 when no locking/copy is required here. */
+int ps3rsx_dma_put(unsigned ea, const void* source, unsigned size);
+
+/* RPCS3's RSX thread. */
+enum { PS3RSX_VULKAN = 0, PS3RSX_OPENGL = 1 };
+
+/* GCM events the RSX raises, as bits of ps3rsx_event_fn's `events`. */
+enum
+{
+    PS3RSX_EVENT_FLIP   = 1,   /* a flip was shown */
+    PS3RSX_EVENT_VBLANK = 2,
+    PS3RSX_EVENT_QUEUE  = 4,   /* a flip was queued */
+    PS3RSX_EVENT_USER   = 8,   /* a user command; user_arg is its argument */
+};
+typedef void (*ps3rsx_event_fn)(unsigned events, unsigned user_arg);
+
+typedef struct ps3rsx_params
+{
+    void*           hwnd;          /* the window to present into (HWND) */
+    int             renderer;      /* PS3RSX_VULKAN or PS3RSX_OPENGL */
+    unsigned        context_addr;  /* 3 MB of guest memory for the RSX context:
+                                    * DMA control (put/get/ref at +0x40), driver
+                                    * info at +1 MB, labels and reports at +2 MB */
+    unsigned        local_size;    /* RSX local memory at 0xC0000000 */
+    ps3rsx_event_fn on_event;      /* called on the RSX's threads */
+    void (*on_guest_write)(unsigned ea, unsigned size);
+                                   /* a label the RSX wrote to guest memory
+                                    * (the host's SPUs may hold a reservation
+                                    * on it); called on the RSX thread */
+    int (*report_hold)(unsigned arg, unsigned long long waited_us);
+                                   /* before the RSX executes a GET_REPORT
+                                    * (arg: type << 24 | offset, read again
+                                    * from the FIFO each time) of a type other
+                                    * than the zcull counters it waits, serving
+                                    * its flushes, while this returns nonzero
+                                    * (RSX thread) */
+    void (*on_report)(unsigned ea, int awaited);
+                                   /* the RSX is about to write a report;
+                                    * awaited when its last word is nonzero
+                                    * (an SPU barrier waits for the RSX to
+                                    * zero it); RSX thread */
+    int perf_overlay;              /* the performance counter at start, top
+                                    * right (the in-game panel's, F3): 0 off,
+                                    * 1 the rate, 2 and up detailed */
+    int (*perf_guest_text)(float fps, char* buf, unsigned size);
+                                   /* the overlay's guest lines, one per line,
+                                    * each starting with a space; called at
+                                    * its refresh; returns the length */
+    void (*rsx_thread_started)(unsigned long native_tid);
+                                   /* the RSX thread's native id, once it runs
+                                    * (the host counts its CPU); may be null */
+} ps3rsx_params;
+
+/* Starts the RSX thread on guest memory set up by ps3rsx_init_memory. It then
+ * runs the FIFO whose control register is at context_addr + 0x40. 0 on success. */
+int ps3rsx_start(const ps3rsx_params* params);
+
+/* The IO map (1 MB pages), display buffers and an immediate flip, mirrored
+ * from cellGcmSys. */
+void ps3rsx_iomap(unsigned ea, unsigned io, unsigned size);
+void ps3rsx_iounmap(unsigned io, unsigned size);
+void ps3rsx_set_display_buffer(unsigned id, unsigned offset, unsigned pitch, unsigned width, unsigned height);
+int  ps3rsx_flip(unsigned id);
+
+/* The in-game panel (F1, ps3rsx_overlay.cpp): the host window's messages,
+ * Windows' (hwnd, msg, wParam, lParam), handed over before the window's own
+ * handling; returns 1 when the panel took the message. */
+int ps3rsx_overlay_message(void* hwnd, unsigned msg, unsigned long long wp, long long lp);
+/* 1 while the panel is open: the game's keyboard and mouse wait. */
+int ps3rsx_overlay_blocks_input(void);
+/* The counter in the corner at start: 0 off, 1 the rate, 2 detailed (F3 and
+ * the panel change it). */
+void ps3rsx_overlay_set_counter(int level);
+
+/* The game's trophies, for the panel's tab (the runtime's sceNpTrophy, read
+ * from the disc). Same layout as sce_np_trophy_host_info. */
+typedef struct ps3rsx_trophy
+{
+    int                id;
+    int                grade;        /* 1 platinum, 2 gold, 3 silver, 4 bronze */
+    int                hidden;
+    int                unlocked;
+    unsigned long long unlock_time;  /* UNIX seconds, 0 when locked */
+    const char*        name;         /* UTF-8 */
+    const char*        detail;
+} ps3rsx_trophy;
+void ps3rsx_overlay_set_trophies(int (*count)(void), int (*get)(int index, ps3rsx_trophy* out),
+                                 int (*icon)(int id, const unsigned char** png, unsigned long long* size));
+/* A trophy was just unlocked: the panel shows its notice (any thread). */
+void ps3rsx_overlay_trophy_unlocked(int id);
+
+/* One line on stderr: the RSX thread's state, FIFO state, put and get. */
+void ps3rsx_debug_dump(void);
+
+/* Captures the next whole frame as RPCS3 does (its Alt+C): every command,
+ * the memory and textures it reads, into <exe dir>/captures/*.rrc.gz
+ * (RPCS3_CONFIG_DIR moves it; written uncompressed despite the name). */
+void ps3rsx_request_capture(void);
+
+/* Releases guest memory (RPCS3's vm::close). RPCS3's blocks check, when the
+ * process tears its globals down, that they were unmapped: call this before
+ * exiting normally. */
+void ps3rsx_shutdown(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/gpu/bridge/ps3rsx_interp.cpp b/gpu/bridge/ps3rsx_interp.cpp
new file mode 100644
index 00000000..c2a6225f
--- /dev/null
+++ b/gpu/bridge/ps3rsx_interp.cpp
@@ -0,0 +1,380 @@
+// ps3rsx_interp.cpp: what a title's frames look like to the RSX, for frame
+// interpolation (drawing a frame between two of the title's, for 120 FPS from
+// a game that steps at 60).
+//
+// The plan is to run frame N's commands a second time with the vertex
+// constants (camera, object and bone matrices) halfway to frame N-1's, which
+// needs the draws of two frames to pair up and the motion to be in the
+// constants. PS3RSX_INTERP_STATS=1 measures that, every 5 s:
+//
+//   draws        draws per frame
+//   strict       draws paired with one of the last frame's by program, vertex
+//                and index arrays, render target and range
+//   loose        paired only once the array addresses are left out (geometry
+//                written anew each frame, at another address)
+//   vb-changed   strict pairs whose vertex data changed (vertices written by
+//                the CPU/SPU in place: their motion is not in the constants)
+//   const        strict pairs by how many vec4 constants differ from the last
+//                frame's: 0, 1-4, 5-16, 17-64, more (bones)
+//   uploads      vec4 constants changed between draws, per frame
+//
+// PS3RSX_INTERP_DUMP=<frame>: every method of that frame to
+// interp_methods_<frame>.txt, and every draw of the next one (its pair in
+// that frame, arrays, constants changed) to interp_draws_<frame>.txt (what follows the last
+// draw: labels, semaphores, the flip), in PS3RSX_INTERP_DIR (default .).
+#include "stdafx.h"
+#include "Emu/Memory/vm.h"
+#include "Emu/Cell/timers.hpp"
+#include "Emu/RSX/RSXThread.h"
+#include "Emu/RSX/rsx_methods.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace
+{
+	constexpr u32 kConsts = 512;   // rsx_state::transform_constants
+
+	struct draw_info
+	{
+		u64 strict = 0, loose = 0;
+		u64 vb_hash = 0;
+		u32 prim = 0, first = 0, count = 0;
+		u32 vp_start = 0, fp_addr = 0, surface = 0;
+		u32 changed = 0;            // vec4 constants written since the last draw
+		u32 const_off = 0;          // into frame::const_hashes (kConsts per draw)
+		s32 pair = -1;              // the last frame's draw it pairs with
+		bool strict_pair = false;
+		u32 arrays[16][2]{};        // offset, format register (0: off)
+		std::vector<u16> changed_slots;  // dump frames only
+	};
+
+	struct frame
+	{
+		std::vector<draw_info> draws;
+		std::vector<u32> const_hashes;
+		void clear() { draws.clear(); const_hashes.clear(); }
+	};
+
+	struct stats
+	{
+		u64 frames = 0, draws = 0, strict = 0, loose = 0, vb_changed = 0, uploads = 0;
+		u64 const_hist[5]{};
+	};
+
+	struct state
+	{
+		bool on = false;
+		s64 dump_frame = -1;
+		std::string dir = ".";
+		u64 frame_no = 0;
+		frame cur, prev;
+		u32 shadow[kConsts][4]{};
+		u32 hashes[kConsts]{};
+		stats acc;
+		u64 last_print_us = 0;
+		FILE* methods = nullptr;
+		bool dumping = false;
+	};
+
+	state& st()
+	{
+		static state s = []
+		{
+			state v;
+			const char* e = std::getenv("PS3RSX_INTERP_STATS");
+			const char* d = std::getenv("PS3RSX_INTERP_DUMP");
+			v.on = (e && e[0] && e[0] != '0') || (d && d[0]);
+			if (d && d[0]) v.dump_frame = std::atoll(d);
+			if (const char* p = std::getenv("PS3RSX_INTERP_DIR"); p && p[0]) v.dir = p;
+			return v;
+		}();
+		return s;
+	}
+
+	u64 mix(u64 h, u64 v)
+	{
+		h ^= v + 0x9e3779b97f4a7c15ull + (h << 6) + (h >> 2);
+		return h;
+	}
+
+	u32 hash_vec4(const u32* v)
+	{
+		u64 h = 0;
+		for (int i = 0; i < 4; i++) h = mix(h, v[i]);
+		return static_cast<u32>(h ^ (h >> 32));
+	}
+
+	// The guest address of an array offset (bit 31: main memory), or 0.
+	u32 array_address(rsx::thread* rsx, u32 offset, u32 size)
+	{
+		const u32 off = offset & 0x7fffffff;
+		if (offset >> 31)
+		{
+			const u32 ea = rsx->iomap_table.get_addr(off);
+			return ea != umax && vm::check_addr(ea, 0, size) ? ea : 0;
+		}
+		return off + size <= rsx->local_mem_size ? rsx::constants::local_mem_base + off : 0;
+	}
+
+	u64 hash_bytes(u32 addr, u32 size)
+	{
+		const u8* p = static_cast<const u8*>(vm::base(addr));
+		u64 h = 0;
+		for (u32 i = 0; i + 8 <= size; i += 8)
+		{
+			u64 v;
+			std::memcpy(&v, p + i, 8);
+			h = mix(h, v);
+		}
+		return h;
+	}
+
+	void on_draw(rsx::thread* rsx)
+	{
+		auto& s = st();
+		auto& regs = rsx::method_registers;
+		const auto& clause = regs.current_draw_clause;
+		if (clause.empty() || clause.command == rsx::draw_command::inlined_array)
+			return;
+
+		draw_info d;
+		d.prim = static_cast<u32>(clause.primitive);
+		d.first = clause.min_index();
+		d.count = clause.get_elements_count();
+		d.vp_start = regs.transform_program_start();
+		d.fp_addr = regs.registers[NV4097_SET_SHADER_PROGRAM];
+		d.surface = regs.registers[NV4097_SET_SURFACE_COLOR_AOFFSET];
+		const bool indexed = clause.command == rsx::draw_command::indexed;
+		const u32 index_addr = indexed ? regs.registers[NV4097_SET_INDEX_ARRAY_ADDRESS] : 0;
+
+		u64 strict = mix(mix(mix(mix(0, d.vp_start), d.fp_addr), d.surface), (u64(d.prim) << 32) | d.count);
+		strict = mix(strict, d.first);
+		u64 loose = strict;
+		strict = mix(strict, index_addr);
+		const u32 base = regs.vertex_data_base_offset();
+		for (u32 i = 0; i < 16; i++)
+		{
+			const auto& a = regs.vertex_arrays_info[i];
+			if (!a.size())
+				continue;
+			const u32 fmt = regs.registers[NV4097_SET_VERTEX_DATA_ARRAY_FORMAT + i];
+			d.arrays[i][0] = a.offset();
+			d.arrays[i][1] = fmt;
+			loose = mix(loose, (u64(i) << 32) | fmt);
+			strict = mix(strict, (u64(fmt) << 32) | a.offset());
+			if (const u32 stride = a.stride())
+			{
+				const u32 start = ((a.offset() & 0x7fffffff) + base) | (a.offset() & 0x80000000);
+				const u32 bytes = std::min<u32>(256, stride * std::max<u32>(d.count, 1));
+				if (const u32 ea = array_address(rsx, start + (indexed ? 0 : d.first * stride), bytes))
+					d.vb_hash = mix(d.vb_hash, hash_bytes(ea, bytes));
+			}
+		}
+		d.strict = strict;
+		d.loose = loose;
+
+		// The constants that changed since the last draw.
+		const bool dump = s.dumping || s.frame_no == static_cast<u64>(s.dump_frame + 1);
+		for (u32 i = 0; i < kConsts; i++)
+		{
+			const u32* c = regs.transform_constants[i];
+			if (std::memcmp(c, s.shadow[i], 16) == 0)
+				continue;
+			std::memcpy(s.shadow[i], c, 16);
+			s.hashes[i] = hash_vec4(c);
+			d.changed++;
+			if (dump) d.changed_slots.push_back(static_cast<u16>(i));
+		}
+		d.const_off = static_cast<u32>(s.cur.const_hashes.size());
+		s.cur.const_hashes.insert(s.cur.const_hashes.end(), s.hashes, s.hashes + kConsts);
+		s.cur.draws.push_back(std::move(d));
+	}
+
+	// Pair this frame's draws with the last frame's: by the strict key first,
+	// then the loose one, each in draw order.
+	void pair_draws(state& s)
+	{
+		std::unordered_map<u64, std::vector<s32>> strict, loose;
+		for (s32 i = static_cast<s32>(s.prev.draws.size()) - 1; i >= 0; i--)
+		{
+			strict[s.prev.draws[i].strict].push_back(i);
+		}
+		std::vector<bool> taken(s.prev.draws.size());
+		for (auto& d : s.cur.draws)
+		{
+			auto it = strict.find(d.strict);
+			if (it == strict.end() || it->second.empty())
+				continue;
+			d.pair = it->second.back();
+			d.strict_pair = true;
+			taken[d.pair] = true;
+			it->second.pop_back();
+		}
+		for (s32 i = static_cast<s32>(s.prev.draws.size()) - 1; i >= 0; i--)
+			if (!taken[i]) loose[s.prev.draws[i].loose].push_back(i);
+		for (auto& d : s.cur.draws)
+		{
+			if (d.pair >= 0)
+				continue;
+			auto it = loose.find(d.loose);
+			if (it == loose.end() || it->second.empty())
+				continue;
+			d.pair = it->second.back();
+			it->second.pop_back();
+		}
+	}
+
+	u32 const_diff(const state& s, const draw_info& d, std::vector<u16>* slots)
+	{
+		const u32* a = &s.cur.const_hashes[d.const_off];
+		const u32* b = &s.prev.const_hashes[s.prev.draws[d.pair].const_off];
+		u32 n = 0;
+		for (u32 i = 0; i < kConsts; i++)
+		{
+			if (a[i] == b[i])
+				continue;
+			n++;
+			if (slots) slots->push_back(static_cast<u16>(i));
+		}
+		return n;
+	}
+
+	void write_ranges(FILE* f, const std::vector<u16>& slots)
+	{
+		for (size_t i = 0; i < slots.size();)
+		{
+			size_t j = i;
+			while (j + 1 < slots.size() && slots[j + 1] == slots[j] + 1) j++;
+			if (j == i) std::fprintf(f, " %u", slots[i]);
+			else std::fprintf(f, " %u-%u", slots[i], slots[j]);
+			i = j + 1;
+		}
+	}
+
+	void dump_draws(const state& s)
+	{
+		const std::string path = s.dir + "/interp_draws_" + std::to_string(s.frame_no - 1) + ".txt";
+		FILE* f = std::fopen(path.c_str(), "w");
+		if (!f)
+			return;
+		std::fprintf(f, "frame %llu: %zu draws (the last frame: %zu)\n", static_cast<unsigned long long>(s.frame_no - 1), s.cur.draws.size(), s.prev.draws.size());
+		std::fprintf(f, "# idx prim first count vp fp surface pair(S strict, L loose) vb-hash | arrays (slot:offset/format) | changed: written since the last draw | diff: vec4 differing from the pair\n");
+		for (size_t k = 0; k < s.cur.draws.size(); k++)
+		{
+			const auto& d = s.cur.draws[k];
+			std::fprintf(f, "%4zu p%u %u %u vp%u fp%08x rt%08x %c%d %016llx |", k, d.prim, d.first, d.count, d.vp_start, d.fp_addr, d.surface,
+				d.pair < 0 ? '-' : d.strict_pair ? 'S' : 'L', d.pair, static_cast<unsigned long long>(d.vb_hash));
+			for (u32 i = 0; i < 16; i++)
+				if (d.arrays[i][1]) std::fprintf(f, " %u:%08x/%x", i, d.arrays[i][0], d.arrays[i][1]);
+			std::fprintf(f, " | changed %u:", d.changed);
+			write_ranges(f, d.changed_slots);
+			if (d.pair >= 0)
+			{
+				std::vector<u16> slots;
+				const u32 n = const_diff(s, d, &slots);
+				std::fprintf(f, " | diff %u:", n);
+				write_ranges(f, slots);
+			}
+			std::fputc('\n', f);
+		}
+		std::fclose(f);
+		std::fprintf(stderr, "[interp] wrote %s\n", path.c_str());
+	}
+
+	void print_stats(state& s)
+	{
+		auto& a = s.acc;
+		if (!a.frames)
+			return;
+		const double f = static_cast<double>(a.frames), dr = std::max<double>(1.0, static_cast<double>(a.draws));
+		const double pairs = std::max<double>(1.0, static_cast<double>(a.strict));
+		std::fprintf(stderr,
+			"[interp] %llu frames: %.0f draws, strict %.1f%%, loose %.1f%%, vb-changed %.1f%% of strict, "
+			"const 0:%.0f%% 1-4:%.0f%% 5-16:%.0f%% 17-64:%.0f%% >64:%.0f%%, uploads %.0f vec4/frame\n",
+			static_cast<unsigned long long>(a.frames), a.draws / f, 100.0 * a.strict / dr, 100.0 * a.loose / dr, 100.0 * a.vb_changed / pairs,
+			100.0 * a.const_hist[0] / pairs, 100.0 * a.const_hist[1] / pairs, 100.0 * a.const_hist[2] / pairs,
+			100.0 * a.const_hist[3] / pairs, 100.0 * a.const_hist[4] / pairs, a.uploads / f);
+		a = {};
+	}
+
+	void on_frame_end()
+	{
+		auto& s = st();
+		if (!s.prev.draws.empty())
+			pair_draws(s);
+		auto& a = s.acc;
+		a.frames++;
+		for (const auto& d : s.cur.draws)
+		{
+			a.draws++;
+			a.uploads += d.changed;
+			if (d.pair < 0)
+				continue;
+			if (!d.strict_pair)
+			{
+				a.loose++;
+				continue;
+			}
+			a.strict++;
+			if (d.vb_hash != s.prev.draws[d.pair].vb_hash) a.vb_changed++;
+			const u32 n = const_diff(s, d, nullptr);
+			a.const_hist[n == 0 ? 0 : n <= 4 ? 1 : n <= 16 ? 2 : n <= 64 ? 3 : 4]++;
+		}
+
+		if (s.dumping)
+		{
+			dump_draws(s);
+			s.dumping = false;
+		}
+		if (s.methods)
+		{
+			std::fclose(s.methods);
+			s.methods = nullptr;
+			s.dumping = true;  // and the next frame's draws, paired with this one
+		}
+		if (s.dump_frame >= 0 && s.frame_no + 1 == static_cast<u64>(s.dump_frame))
+		{
+			const std::string path = s.dir + "/interp_methods_" + std::to_string(s.dump_frame) + ".txt";
+			s.methods = std::fopen(path.c_str(), "w");
+		}
+
+		const u64 now = get_system_time();
+		if (!s.last_print_us) s.last_print_us = now;
+		if (now - s.last_print_us >= 5'000'000)
+		{
+			print_stats(s);
+			s.last_print_us = now;
+		}
+
+		std::swap(s.prev, s.cur);
+		s.cur.clear();
+		s.frame_no++;
+	}
+}
+
+// Called by the RSX thread for each method, before it runs (RSXFIFO.cpp), and
+// at each frame's end (RSXThread.cpp on_frame_end).
+void ps3rsx_interp_method(rsx::thread* rsx, u32 reg, u32 value)
+{
+	auto& s = st();
+	if (s.methods)
+		std::fprintf(s.methods, "%04x %08x\n", reg << 2, value);
+	if (reg == NV4097_SET_BEGIN_END && !(value & 0xff))
+		on_draw(rsx);
+}
+
+void ps3rsx_interp_frame_end()
+{
+	on_frame_end();
+}
+
+bool ps3rsx_interp_enabled()
+{
+	return st().on;
+}
diff --git a/gpu/bridge/ps3rsx_memory.cpp b/gpu/bridge/ps3rsx_memory.cpp
new file mode 100644
index 00000000..69fd95ae
--- /dev/null
+++ b/gpu/bridge/ps3rsx_memory.cpp
@@ -0,0 +1,168 @@
+// Guest memory for RPCS3's RSX (ps3rsx.h). Built with RPCS3 (MSVC), see
+// gpu/rpcs3_build. GPL-2.0, like RPCS3.
+#include "stdafx.h"
+#include <atomic>
+#include <chrono>
+#include "Emu/Memory/vm.h"
+
+#include "ps3rsx.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+
+// RSXThread.cpp: set while an RSX thread runs; its texture cache protects the
+// pages it has read and learns of guest writes through this.
+namespace rsx
+{
+    extern std::function<bool(u32 addr, bool is_writing)> g_access_violation_handler;
+}
+
+
+extern "C" int ps3rsx_requested(void)
+{
+    const char* e = std::getenv("PS3_RSX");
+    return e && std::strcmp(e, "rpcs3") == 0;
+}
+
+// ps3recomp's model is a flat 4 GB space where any address is memory: the
+// guest writes to page 0 (its null-object inits), its heap reaches about
+// 0x50000000 (its sys_mmapper heap up to 0xC0000000), the runtime places thread stacks in the stack region itself and
+// the raw-SPU problem state at 0xE0000000, and sys_vm sits at 0x60000000.
+// RPCS3's vm only lets pages inside mapped blocks be touched, so map each of
+// those ranges whole and allocated.
+extern "C" unsigned char* ps3rsx_init_memory(void)
+{
+    vm::init();
+
+    // A preallocated block is mapped with no access; its pages become usable
+    // only once allocated (falloc / alloc), which is also what marks them as
+    // memory for the RSX. Map page 0 through the heap as one block and
+    // allocate all of it.
+    bool ok = !!vm::map(0x00000000, 0x60000000, vm::block_size_64k | vm::preallocated);
+    // One allocation locks its whole range, and RPCS3 refuses 512 MB or more.
+    for (u32 a = 0; ok && a < 0x60000000; a += 0x10000000)
+        ok = vm::falloc(a, 0x10000000, vm::any);
+    if (!ok)
+    {
+        std::fprintf(stderr, "[ps3rsx] could not set up guest memory 0x00000000-0x60000000\n");
+        return nullptr;
+    }
+
+    // sys_vm's region (runtime/syscalls/sys_vm.h), free in RPCS3's layout.
+    if (!vm::map(0x60000000, 0x10000000, vm::block_size_64k | vm::preallocated) ||
+        !vm::falloc(0x60000000, 0x10000000, vm::any))
+    {
+        std::fprintf(stderr, "[ps3rsx] could not set up guest memory 0x60000000-0x70000000\n");
+        return nullptr;
+    }
+
+    // The rest of sys_mmapper's domain (runtime/syscalls/sys_memory.c,
+    // SYS_MAPPER_BASE..END is 0x40000000-0xC0000000): a title's RSX IO heap
+    // can come from there (God of War: Ascension's sits at 0x70000000), and
+    // the RSX reads its command buffers and vertex data through it.
+    ok = !!vm::map(0x70000000, 0x50000000, vm::block_size_64k | vm::preallocated);
+    for (u32 a = 0x70000000; ok && a < 0xC0000000; a += 0x10000000)
+        ok = vm::falloc(a, 0x10000000, vm::any);
+    if (!ok)
+    {
+        std::fprintf(stderr, "[ps3rsx] could not set up guest memory 0x70000000-0xC0000000\n");
+        return nullptr;
+    }
+
+    // RSX local memory (vm::init's video block). RPCS3 allocates it in
+    // sys_rsx when the title initialises gcm; ps3recomp writes it directly.
+    if (!vm::falloc(0xC0000000, 0x10000000, vm::video))
+    {
+        std::fprintf(stderr, "[ps3rsx] could not allocate RSX local memory\n");
+        return nullptr;
+    }
+
+    // The stack region: vm::init's block is guarded, so falloc refuses it and
+    // vm::unmap does not release it; one allocation from its start leaves a
+    // 4 KB guard at each end. ps3recomp places thread stacks there itself,
+    // upwards from 0xD0000000; 64 MB covers them (the whole 256 MB in 4 KB
+    // pages ran out of a Windows quota: ERROR_NOT_ENOUGH_QUOTA).
+    const auto stack = vm::get(vm::stack);
+    if (!stack || !stack->alloc(0x04000000 - 0x2000, nullptr, 0x1000))
+    {
+        std::fprintf(stderr, "[ps3rsx] could not allocate the stack region\n");
+        return nullptr;
+    }
+    // GOW3 (ps3recomp-gow3): our runtime keeps one guest stack per host thread for HLE -> guest callbacks in
+    // the top 16 MB of the stack region (VM_CB_STACK_BASE 0xDF000000, runtime/memory/vm.h). alloc() is first
+    // fit, so a filler up to 0xDF000000 puts the callback block there; the filler is released after. The
+    // block's guard rule wants two free pages below each allocation and keeps the last 8 KB below 0xE0000000:
+    // the callback block is 0xDF000000-0xDFFFE000 (the 64th slot's top 8 KB stay out; 64 live threads making
+    // callbacks at once never happen in GOW3).
+    {
+        const u32 filler = stack->alloc(0xDEFFE000u - 0xD4001000u, nullptr, 0x1000);
+        const u32 cb = filler ? stack->alloc(0xDFFFE000u - 0xDF000000u, nullptr, 0x1000) : 0;
+        if (filler) stack->dealloc(filler);
+        if (cb != 0xDF000000u)
+        {
+            std::fprintf(stderr, "[ps3rsx] could not allocate the callback stacks at 0xDF000000 (filler 0x%08X, got 0x%08X)\n", filler, cb);
+            return nullptr;
+        }
+    }
+
+    // The raw-SPU problem state windows (0xE0000000 + 0x100000 * n).
+    if (!vm::falloc(0xE0000000, 0x01000000, vm::spu))
+    {
+        std::fprintf(stderr, "[ps3rsx] could not allocate the SPU region\n");
+        return nullptr;
+    }
+
+    std::fprintf(stderr, "[ps3rsx] guest memory on RPCS3's vm at %p\n", static_cast<void*>(vm::g_base_addr));
+    return vm::g_base_addr;
+}
+
+// RPCS3's own exception handler forwards faults to the RSX only on its own
+// threads (thread_ctrl); ps3recomp's guest threads are plain host threads, so
+// the runtime's handler calls this instead.
+// PS3RSX_FAULT_STATS=1: the faults that reach here, every 5 s, by 1 MB of guest
+// memory (the busiest eight) and how many the RSX's handler took.
+static void fault_stats(u32 addr, int is_write, bool taken)
+{
+    static int s_on = -1;
+    if (s_on < 0) { const char* e = std::getenv("PS3RSX_FAULT_STATS"); s_on = e && *e == '1'; }
+    if (!s_on) return;
+    static std::atomic<long> s_mb[4096], s_n, s_w, s_taken;
+    static std::atomic<unsigned long long> s_t0;
+    s_mb[addr >> 20]++; s_n++; if (is_write) s_w++; if (taken) s_taken++;
+    const unsigned long long now = static_cast<unsigned long long>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+    unsigned long long t0 = s_t0.load();
+    if (!t0) { s_t0.compare_exchange_strong(t0, now); return; }
+    if (now - t0 < 5000 || !s_t0.compare_exchange_strong(t0, now)) return;
+    char line[512]; int k = std::snprintf(line, sizeof line, "[rsx-fault] 5 s: %ld faults (%ld writes, %ld taken by the RSX); by MB:",
+                                          s_n.exchange(0), s_w.exchange(0), s_taken.exchange(0));
+    for (int r = 0; r < 8; r++) {
+        int best = -1; long bn = 0;
+        for (int i = 0; i < 4096; i++) { const long v = s_mb[i].load(); if (v > bn) { bn = v; best = i; } }
+        if (best < 0) break;
+        k += std::snprintf(line + k, sizeof line - k, " 0x%03X=%ld", best, bn);
+        s_mb[best] = -bn;
+    }
+    for (int i = 0; i < 4096; i++) s_mb[i] = 0;
+    std::fprintf(stderr, "%s\n", line);
+}
+
+extern "C" int ps3rsx_handle_fault(const void* host_addr, int is_write)
+{
+    const auto [addr, ok] = vm::try_get_addr(host_addr);
+    if (!ok || !rsx::g_access_violation_handler)
+        return 0;
+    if (rsx::g_access_violation_handler(addr, is_write != 0)) { fault_stats(addr, is_write, true); return 1; }
+    fault_stats(addr, is_write, false);
+    // As RPCS3's handle_access_violation: when the page's own permissions
+    // allow the access, the protection that faulted has been lifted since
+    // (the RSX thread unprotected it in between); retry.
+    return vm::check_addr(addr, is_write ? vm::page_writable : vm::page_readable) ? 1 : 0;
+}
+
+extern "C" void ps3rsx_shutdown(void)
+{
+    vm::close();
+}
