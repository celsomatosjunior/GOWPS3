+		std::snprintf(sub, sizeof sub, "%s", L("ocupação do RSX do RPCS3", "RPCS3's RSX busy"));
+		card("##c_rsx", "RSX", v, fi.rsx_load > 90 ? DANGER : CREAM, sub, w, s);
+		ImGui::SameLine();
+		std::snprintf(v, sizeof v, "%.0f%%", std::max(g_cpu_proc, 0.0));
+		std::snprintf(sub, sizeof sub, L("sistema %.0f%%  ·  %d núcleos", "system %.0f%%  ·  %d cores"), std::max(g_cpu_sys, 0.0), g_cores);
+		card("##c_cpu", L("CPU (JOGO)", "CPU (GAME)"), v, CREAM, sub, w, s);
+		ImGui::PopStyleVar();
+
+		ImGui::Spacing();
+		stagger(2, s);
+		ImGui::PushFont(f_small);
+		ImGui::TextColored(MUTED, L("TEMPO DE FRAME  ·  ÚLTIMOS %d FRAMES", "FRAME TIME  ·  LAST %d FRAMES"), HIST);
+		ImGui::PopFont();
+		frame_graph(ImVec2(ImGui::GetContentRegionAvail().x, 120 * s), s);
+		ImGui::PopStyleVar();
+
+		ImGui::Spacing();
