+	int g_trophy_filter;   // 0 all, 1 unlocked, 2 locked
+
+	void tab_trophies(float s)
+	{
+		const auto list = trophies();
+		stagger(1, s);
+		if (list.empty())
+		{
+			ImGui::PushTextWrapPos(0);
+			hint(L("O jogo ainda não abriu os troféus (eles aparecem depois da tela inicial), ou o disco não tem o TROPHY.TRP.",
+			       "The game has not opened its trophies yet (they show after the title screen), or the disc has no TROPHY.TRP."));
+			ImGui::PopTextWrapPos();
+			ImGui::PopStyleVar();
+			return;
+		}
+		int got = 0, num[5] = {}, have[5] = {};
+		for (const auto& t : list)
+		{
+			const int g = std::clamp(t.grade, 0, 4);
+			num[g]++;
+			if (t.unlocked) { got++; have[g]++; }
+		}
+		// the progress: how many, the share, a bar; the four grades
+		const float w = ImGui::GetContentRegionAvail().x;
+		ImGui::BeginChild("##tr_sum", ImVec2(w, 104 * s), ImGuiChildFlags_Borders, ImGuiWindowFlags_NoScrollbar);
+		ImGui::PushFont(f_big);
+		ImGui::TextColored(GOLD_HI, "%d%%", static_cast<int>(got * 100 / list.size()));
+		ImGui::PopFont();
+		ImGui::SameLine();
+		ImGui::SetCursorPosY(ImGui::GetCursorPosY() + (f_big->FontSize - f_body->FontSize) * 0.5f);
+		ImGui::TextColored(CREAM, L("%d de %d desbloqueados", "%d of %d unlocked"), got, static_cast<int>(list.size()));
+		bar(static_cast<float>(got) / list.size(), ImGui::GetContentRegionAvail().x, s);
+		ImDrawList* dl = ImGui::GetWindowDrawList();
+		for (int g = 1; g <= 4; g++)
+		{
+			if (g > 1) ImGui::SameLine(0, 18 * s);
+			const ImVec2 p = ImGui::GetCursorScreenPos();
+			ImGui::Dummy(ImVec2(18 * s, f_body->FontSize));
+			cup(dl, ImVec2(p.x + 9 * s, p.y + f_body->FontSize * 0.5f), 7 * s, ImGui::GetColorU32(grade_colour(g)), 1.4f * s, true);
+			ImGui::SameLine(0, 4 * s);
+			ImGui::TextColored(MUTED, "%d/%d", have[g], num[g]);
+		}
+		ImGui::EndChild();
+		ImGui::PopStyleVar();
+
