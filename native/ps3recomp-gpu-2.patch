+void ImFontAtlasUpdateSourcesPointers(ImFontAtlas* atlas)
+{
+    for (ImFontConfig& src : atlas->Sources)
+    {
+        ImFont* font = src.DstFont;
+        if (!src.MergeMode)
+        {
+            font->Sources = &src;
+            font->SourcesCount = 0;
+        }
+        font->SourcesCount++;
+    }
+}
