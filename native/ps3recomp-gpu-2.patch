+			if (!g_icon_px[i].empty()) g_icon_rect[i] = a->AddCustomRectRegular(ICON, ICON);
+		unsigned char* px = nullptr;
+		int w = 0, h = 0;
+		a->GetTexDataAsRGBA32(&px, &w, &h);
+		for (size_t i = 0; i < g_icon_px.size(); i++)
+		{
+			if (g_icon_rect[i] < 0) continue;
+			const ImFontAtlasCustomRect* r = a->GetCustomRectByIndex(g_icon_rect[i]);
+			for (int y = 0; y < ICON; y++)
+				std::memcpy(px + ((r->Y + y) * w + r->X) * 4, &g_icon_px[i][y * ICON * 4], ICON * 4);
+		}
+	}
