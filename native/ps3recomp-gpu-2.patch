+		dl->AddRectFilled(p0, p1, ImGui::GetColorU32(ImVec4(1, 1, 1, 0.07f)), h / 2);
+		if (frac > 0)
+			dl->AddRectFilled(p0, ImVec2(p0.x + std::max(width * frac, h), p1.y), ImGui::GetColorU32(frac > 0.9f ? DANGER : frac > 0.75f ? GOLD : EMBER), h / 2);
