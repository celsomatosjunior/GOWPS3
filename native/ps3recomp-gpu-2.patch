+	return info.KP_FLAGS & P_TRACED;
+#else
+	char buf[4096];
+	fs::file status_fd("/proc/self/status");
+	if (!status_fd)
+	{
+		std::fprintf(stderr, "Failed to open /proc/self/status\n");
+		return false;
