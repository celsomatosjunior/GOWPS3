+	void memory_release(void* pointer, usz size)
+	{
+		if (!size)
+		{
+			return;
+		}
+
+#ifdef _WIN32
+		unmap_mappping_memory(reinterpret_cast<u64>(pointer), size);
+		ensure(::VirtualFree(pointer, 0, MEM_RELEASE));
+#else
+		ensure(::munmap(pointer, size) != -1);
