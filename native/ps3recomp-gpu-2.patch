+#ifdef _WIN32
+	unsigned long long ft64(const FILETIME& f) { return (static_cast<unsigned long long>(f.dwHighDateTime) << 32) | f.dwLowDateTime; }
+#endif
+
+	// Twice a second: the rate, the CPU and the memory; true when it read them.
+	bool sample(double dt)
+	{
+		static double acc;
+		static int frames;
+		acc += dt;
+		frames++;
+		if (acc < 0.5) return false;
+		g_fps = frames / acc;
+		acc = 0;
+		frames = 0;
+#ifdef _WIN32
+		static unsigned long long p_prev, idle_prev, total_prev, wall_prev;
+		FILETIME c, e, k, u, idle, kern, user;
+		SYSTEM_INFO si;
+		GetSystemInfo(&si);
+		g_cores = static_cast<int>(si.dwNumberOfProcessors);
+		FILETIME now;
+		GetSystemTimeAsFileTime(&now);
+		if (GetProcessTimes(GetCurrentProcess(), &c, &e, &k, &u) && GetSystemTimes(&idle, &kern, &user))
+		{
+			const unsigned long long p = ft64(k) + ft64(u), wall = ft64(now), id = ft64(idle), total = ft64(kern) + ft64(user);
+			if (wall_prev && wall > wall_prev && total > total_prev)
+			{
+				g_cpu_proc = 100.0 * static_cast<double>(p - p_prev) / static_cast<double>((wall - wall_prev) * std::max(g_cores, 1));
+				g_cpu_sys = 100.0 * (1.0 - static_cast<double>(id - idle_prev) / static_cast<double>(total - total_prev));
+			}
+			p_prev = p; wall_prev = wall; idle_prev = id; total_prev = total;
+		}
+		MEMORYSTATUSEX ms{sizeof(ms)};
+		if (GlobalMemoryStatusEx(&ms))
+		{
+			g_ram_total_gb = ms.ullTotalPhys / 1e9;
+			g_ram_used_gb = (ms.ullTotalPhys - ms.ullAvailPhys) / 1e9;
+		}
+		PROCESS_MEMORY_COUNTERS pmc{};
+		if (K32GetProcessMemoryInfo(GetCurrentProcess(), &pmc, sizeof(pmc)))
+			g_ram_proc_gb = pmc.WorkingSetSize / 1e9;
+#endif
+		return true;
+	}
