+	// The counter in a corner (F3: off / FPS / detailed, the launcher's choice at start): the rate large, its frame
+	// time beside it; detailed, the frame times and the figures below.
+	void draw_counter(const ps3rsx_overlay::frame_info& fi, float s)
+	{
+		const ImGuiIO& io = ImGui::GetIO();
+		const int corner = g_corner.load();
+		const float pad = 14 * s;
+		const ImVec2 pos(corner & 1 ? io.DisplaySize.x - pad : pad, corner & 2 ? io.DisplaySize.y - pad : pad);
+		ImGui::SetNextWindowPos(pos, ImGuiCond_Always, ImVec2(corner & 1 ? 1.0f : 0.0f, corner & 2 ? 1.0f : 0.0f));
+		ImGui::SetNextWindowBgAlpha(0.74f);
+		ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(12 * s, 8 * s));
+		ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 8 * s);
+		ImGui::PushStyleColor(ImGuiCol_Border, alpha(GOLD, 0.30f));
+		ImGui::Begin("##counter", nullptr, ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_AlwaysAutoResize |
+		             ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoMove);
+		g_counter_h = ImGui::GetWindowSize().y;
+		float avg, worst, low1;
+		frame_stats(&avg, &worst, &low1);
+		ImGui::PushFont(f_big);
+		ImGui::TextColored(rate_colour(g_fps), "%.0f", g_fps);
+		ImGui::PopFont();
+		ImGui::SameLine();
+		ImGui::BeginGroup();
+		ImGui::PushFont(f_small);
+		ImGui::TextColored(GOLD, "FPS");
+		ImGui::TextColored(MUTED, "%.1f ms", g_fps > 0 ? 1000.0 / g_fps : 0.0);
+		ImGui::PopFont();
+		ImGui::EndGroup();
+		if (g_counter.load() == COUNTER_FULL)
+		{
+			ImGui::PushFont(f_detail);
+			frame_graph(ImVec2(230 * s, 48 * s), s);
+			if (ImGui::BeginTable("##figures", 2, ImGuiTableFlags_SizingFixedFit))
+			{
+				char t[64];
+				auto line = [&t](const char* k, ImVec4 colour)
+				{
+					ImGui::TableNextRow();
+					ImGui::TableNextColumn();
+					ImGui::TextColored(GOLD, "%s", k);
+					ImGui::TableNextColumn();
+					ImGui::TextColored(colour, "%s", t);
+				};
+				std::snprintf(t, sizeof t, "%.0f FPS", low1);
+				line("1% low", CREAM);
+				std::snprintf(t, sizeof t, "%u %%", fi.rsx_load);
+				line(L("Carga do RSX", "RSX load"), fi.rsx_load > 90 ? DANGER : fi.rsx_load > 75 ? GOLD : OK_GREEN);
+				for (int i = 0; i < g_guest_n; i++)
+				{
+					std::snprintf(t, sizeof t, "%s", g_guest[i].value);
+					line(g_guest[i].name, guest_colour(g_guest[i].colour));
+				}
+				if (!g_guest_n)
+				{
+					std::snprintf(t, sizeof t, L("%.0f%%  (sistema %.0f%%)", "%.0f%%  (system %.0f%%)"), std::max(g_cpu_proc, 0.0), std::max(g_cpu_sys, 0.0));
+					line("CPU", CREAM);
+				}
+				std::snprintf(t, sizeof t, "%.1f GB", g_ram_proc_gb);
+				line("RAM", CREAM);
+				ImGui::EndTable();
+			}
+			ImGui::PopFont();
+		}
+		ImGui::End();
+		ImGui::PopStyleColor();
+		ImGui::PopStyleVar(2);
+	}
