+
+		dir += "/rpcs3/";
+
+		if (!create_path(dir))
+		{
+			std::printf("Failed to create configuration directory '%s' (%d).\n", dir.c_str(), errno);
+		}
+#endif
+
+		return dir;
+	}();
+
+	return s_dir;
+#endif
+}
