+// The in-game panel (ps3rsx_overlay.h) on RPCS3's Vulkan renderer: VKPresent.cpp builds it before the flip's
+// overlays and draws it over them, into the swapchain image.
+#pragma once
+
+#include "Emu/RSX/VK/VulkanAPI.h"
+
+namespace vk
+{
+	class render_device;
+	class command_buffer;
+}
+
+namespace ps3rsx_overlay
+{
+	// This flip's frame; true when there is something to draw.
+	bool vk_prepare(const vk::render_device& dev, VkFormat surface_format, unsigned width, unsigned height, unsigned rsx_load);
+
+	// Draws it into `fbo` (the swapchain image as a colour attachment, pass the renderer's single-target pass).
+	void vk_draw(const vk::command_buffer& cmd, VkFramebuffer fbo, unsigned width, unsigned height);
+}
diff --git a/gpu/bridge/ps3rsx_thread.cpp b/gpu/bridge/ps3rsx_thread.cpp
new file mode 100644
index 00000000..5483e3a1
--- /dev/null
+++ b/gpu/bridge/ps3rsx_thread.cpp
@@ -0,0 +1,967 @@
+// RPCS3's RSX thread on ps3recomp's GCM state (ps3rsx.h). Built with RPCS3
+// (MSVC), see gpu/rpcs3_build. GPL-2.0, like RPCS3.
+//
+// The RSX runs as it does under RPCS3 with an LLE libgcm (isHLE = false): it
+// pulls the title's FIFO from guest memory through the IO map, flips when the
+// command stream says so, and reports flips, vblanks and user commands as GCM
+// events. Here those events go to ps3recomp's cellGcmSys through a callback
+// instead of an lv2 event port (gpu/patches: g_ps3recomp_rsx_event_hook).
+// Only the handful of RPCS3's global objects the RSX touches are created; no
+// Emulator::Load, no PPU/SPU/lv2.
+#include "stdafx.h"
+#include "Emu/System.h"
+#include "Emu/system_config.h"
+#include "Emu/emu_callbacks.h"
+#include "Emu/Memory/vm.h"
+#include "Emu/Cell/lv2/sys_rsx.h"
+#include "Emu/Cell/Modules/cellGcmSys.h"
+#include "Emu/RSX/RSXThread.h"
+#include "Emu/RSX/GSFrameBase.h"
+#include "Emu/RSX/RSXOffload.h"
+#include "Emu/RSX/Core/RSXReservationLock.hpp"
+#include "Emu/RSX/VK/VKGSRender.h"
+// OpenGL is not built on macOS and Android: Vulkan only there.
+#if defined(__APPLE__) || defined(__ANDROID__)
+#define PS3RSX_NO_OPENGL 1
+#else
+#include "Emu/RSX/GL/GLGSRender.h"
+#endif
+#include "Emu/Cell/Modules/cellMsgDialog.h"
+#include "Emu/Cell/Modules/cellOskDialog.h"
+#include "util/video_source.h"
+#include "util/logs.hpp"
+
+#include "ps3rsx.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#ifdef __APPLE__
+extern "C" void ps3rsx_metal_view_size(void* view, int* width, int* height);
+#endif
+#ifdef __ANDROID__
+#include <android/native_window.h>   // the view is the window's ANativeWindow
+#endif
+
+// gpu/patches
+extern void (*g_ps3recomp_rsx_event_hook)(u64 data1, u64 event_flags, u64 data3);
