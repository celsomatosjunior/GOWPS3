+			if (exch.m_ptr)
+			{
+				exch.d()->refs += c_ref_mask;
+			}
+
+			atomic_ptr old;
+
+			const auto [_val, ok] = m_val.fetch_op([&](fat_ptr& val)
+			{
+				if (val.ptr == _old)
+				{
+					// Set new value
+					val = to_val(_new);
+					return true;
+				}
+
+				return false;
+			});
