+// PS3RSX_SHM_STATS=1 (ps3kit): how often views are mapped and unmapped at fixed
+// addresses (map_critical / unmap_critical), their bytes, and the busiest caller
+// (a return address: resolve with the exe's .map), every 5 s.
+#ifdef _WIN32
+#include <intrin.h>
+#define PS3RSX_RETURN_ADDRESS() _ReturnAddress()
+#else
+#define PS3RSX_RETURN_ADDRESS() __builtin_return_address(0)
+#endif
+#include <atomic>
+#include <chrono>
+namespace
+{
+	std::atomic<long> s_shm_n[5];
+	std::atomic<long long> s_shm_bytes[5];
+	std::atomic<unsigned long long> s_shm_t0;
+	std::atomic<uintptr_t> s_shm_ra[5][8];
+	std::atomic<long> s_shm_ran[5][8];
+	void shm_stat(int unmap, size_t bytes, void* ra)
+	{
+		static int on = -1;
+		if (on < 0) { const char* e = std::getenv("PS3RSX_SHM_STATS"); on = e && *e == '1'; }
+		if (!on) return;
+		s_shm_n[unmap]++; s_shm_bytes[unmap] += static_cast<long long>(bytes);
+		for (int i = 0; i < 8; i++)
+		{
+			uintptr_t cur = s_shm_ra[unmap][i].load();
+			if (!cur) { s_shm_ra[unmap][i].compare_exchange_strong(cur, reinterpret_cast<uintptr_t>(ra)); cur = s_shm_ra[unmap][i].load(); }
+			if (cur == reinterpret_cast<uintptr_t>(ra)) { s_shm_ran[unmap][i]++; break; }
+		}
+		const unsigned long long now = static_cast<unsigned long long>(std::chrono::duration_cast<std::chrono::milliseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count());
+		unsigned long long t0 = s_shm_t0.load();
+		if (!t0) { s_shm_t0.compare_exchange_strong(t0, now); return; }
+		if (now - t0 < 5000 || !s_shm_t0.compare_exchange_strong(t0, now)) return;
+#ifdef _WIN32
+		const uintptr_t base = reinterpret_cast<uintptr_t>(::GetModuleHandleW(nullptr));
+#else
+		const uintptr_t base = 0; // absolute addresses; resolve with atos
+#endif
+		static const char* const kind[5] = { "mapped views", "unmapped views", "decommits", "resets", "protects" };
+		for (int k = 0; k < 5; k++)
+		{
+			if (!s_shm_n[k].load()) continue;
+			std::fprintf(stderr, "[shm] 5 s: %s %ld, %lld MB;", kind[k], s_shm_n[k].exchange(0), s_shm_bytes[k].exchange(0) >> 20);
+			for (int i = 0; i < 8; i++)
+			{
+				const uintptr_t ra = s_shm_ra[k][i].load();
+				if (ra) std::fprintf(stderr, " exe+0x%llX x%ld", static_cast<unsigned long long>(ra - base), s_shm_ran[k][i].exchange(0));
+			}
+			std::fprintf(stderr, "\n");
+		}
+	}
+}
