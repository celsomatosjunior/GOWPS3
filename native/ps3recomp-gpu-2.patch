+	constexpr int c_madv_no_dump = MADV_NOCORE;
+	constexpr int c_madv_dump = MADV_CORE;
+#else
+	[[maybe_unused]] constexpr int c_madv_no_dump = 0;
+	[[maybe_unused]] constexpr int c_madv_dump = 0;
