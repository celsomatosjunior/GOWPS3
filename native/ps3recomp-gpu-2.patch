+namespace
+{
+    // The host's window, as RPCS3's presentation sees it. Vulkan only needs
+    // the handle and the client size; the window itself (messages, input,
+    // title) stays the host's.
+    class host_frame final : public GSFrameBase
+    {
+        void* m_view;
+
+    public:
+        explicit host_frame(void* view) : m_view(view) {}
+
+        void close() override {}
+        void reset() override {}
+        bool shown() override { return true; }
+        void hide() override {}
+        void show() override {}
+        void toggle_fullscreen() override {}
+
+        void delete_context(draw_context_t) override {}
+        draw_context_t make_context() override { return nullptr; }
+        void set_current(draw_context_t) override {}
+        void flip(draw_context_t, bool) override {}
+
+        int client_width() override
+        {
+#ifdef _WIN32
+            // 0 when minimized: RPCS3 then keeps the swapchain it has (VKPresent
+            // reinitialize_swapchain); a 1x1 request against a 0x0 surface failed
+            // and ended the RSX thread ("Invalid swapchain setup").
+            RECT r{};
+            if (IsIconic(static_cast<HWND>(m_view)) || !GetClientRect(static_cast<HWND>(m_view), &r))
+                return 0;
+            return std::max<int>(0, r.right - r.left);
+#elif defined(__APPLE__)
+            int w = 1, h = 1;
+            ps3rsx_metal_view_size(m_view, &w, &h);
+            return w;
+#elif defined(__ANDROID__)
+            return m_view ? std::max(0, ANativeWindow_getWidth(static_cast<ANativeWindow*>(m_view))) : 0;
+#else
+            return 1280;
+#endif
+        }
+
+        int client_height() override
+        {
+#ifdef _WIN32
+            // 0 when minimized: RPCS3 then keeps the swapchain it has (VKPresent
+            // reinitialize_swapchain); a 1x1 request against a 0x0 surface failed
+            // and ended the RSX thread ("Invalid swapchain setup").
+            RECT r{};
+            if (IsIconic(static_cast<HWND>(m_view)) || !GetClientRect(static_cast<HWND>(m_view), &r))
+                return 0;
+            return std::max<int>(0, r.bottom - r.top);
+#elif defined(__APPLE__)
+            int w = 1, h = 1;
+            ps3rsx_metal_view_size(m_view, &w, &h);
+            return h;
+#elif defined(__ANDROID__)
+            return m_view ? std::max(0, ANativeWindow_getHeight(static_cast<ANativeWindow*>(m_view))) : 0;
+#else
+            return 720;
+#endif
+        }
+
+        f64 client_display_rate() override { return 60.; }
+        bool has_alpha() override { return false; }
+        display_handle_t handle() const override
+        {
+#ifdef _WIN32
+            return static_cast<HWND>(m_view);
+#elif defined(__APPLE__)
+            return m_view;
+#elif defined(__ANDROID__)
+            return static_cast<ANativeWindow*>(m_view);
+#else
+            return {};
+#endif
+        }
+
+        bool can_consume_frame() const override { return false; }
+        void present_frame(std::vector<u8>&&, u32, u32, u32, bool) const override {}
+        void take_screenshot(std::vector<u8>&&, u32, u32, bool) override {}
+        void update_title(double) override {}
+    };
+
+    // RPCS3's log, to stderr: errors always, warnings and below with
+    // PS3RSX_LOG=<level> (0 fatal .. 7 trace; default 5, warning).
+    struct stderr_listener final : logs::listener
+    {
+        unsigned max_level = 5;
+
+        void log(u64, const logs::message& msg, std::string_view prefix, std::string_view text) override
+        {
+            const auto sev = static_cast<unsigned>(static_cast<logs::level>(msg));
+            if (sev > max_level)
+                return;
+            // RPCS3's overlay icons, looked for next to the executable.
+            if (text.starts_with("Image resource file"))
+                return;
+            std::fprintf(stderr, "[rpcs3] %.*s%s%.*s\n", static_cast<int>(prefix.size()), prefix.data(),
+                         prefix.empty() ? "" : " ", static_cast<int>(text.size()), text.data());
+        }
+    };
+
+#ifdef _WIN32
+    // RPCS3 reports failures as C++ exceptions (fmt::throw_exception), and on a
+    // thread that does not catch them the process just ends with 0xE06D7363.
+    // Print each one's message as it is thrown (the first 16).
+    LONG WINAPI cxx_throw_reporter(EXCEPTION_POINTERS* ep)
+    {
+        static LONG s_count = 0;
+        const auto* er = ep->ExceptionRecord;
+        if (er->ExceptionCode != 0xE06D7363 || er->NumberParameters < 3 || InterlockedIncrement(&s_count) > 16)
+            return EXCEPTION_CONTINUE_SEARCH;
+        const char* what = "(not a std::exception)";
+        __try
+        {
+            // MSVC: ExceptionInformation[1] is the thrown object. RPCS3 throws
+            // std::exception derivatives.
+            what = reinterpret_cast<const std::exception*>(er->ExceptionInformation[1])->what();
+            std::fprintf(stderr, "[ps3rsx] C++ exception thrown (tid %lu): %s\n", GetCurrentThreadId(), what);
+        }
+        __except (EXCEPTION_EXECUTE_HANDLER)
+        {
+            std::fprintf(stderr, "[ps3rsx] C++ exception thrown (tid %lu)\n", GetCurrentThreadId());
+        }
+        // Where from, as executable-relative addresses (resolve with the link map).
+        void* frames[24];
+        const USHORT n = RtlCaptureStackBackTrace(1, 24, frames, nullptr);
+        const auto exe = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
+        std::fprintf(stderr, "[ps3rsx]   stack:");
+        for (USHORT i = 0; i < n; i++)
+            std::fprintf(stderr, " %llX", static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(frames[i]) - exe));
+        std::fprintf(stderr, "\n");
+        std::fflush(stderr);
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+#endif
+
+    stderr_listener s_listener;
+    ps3rsx_event_fn s_on_event = nullptr;
+    void (*s_on_guest_write)(unsigned, unsigned) = nullptr;
+    int (*s_report_hold)(unsigned, unsigned long long) = nullptr;
+    void (*s_on_report)(unsigned, int) = nullptr;
+    void* s_view = nullptr;
+    std::string s_font_dir;   // PS3_OVERLAY_FONT's folder
+
+    void on_rsx_event(u64 /*data1*/, u64 flags, u64 /*data3*/)
+    {
+        const auto render = rsx::get_current_renderer();
+        u32 ev = 0, user_arg = 0;
+        if (flags & (SYS_RSX_EVENT_FLIP_BASE | SYS_RSX_EVENT_FLIP_BASE << 1)) ev |= PS3RSX_EVENT_FLIP;
+        if (flags & SYS_RSX_EVENT_VBLANK) ev |= PS3RSX_EVENT_VBLANK;
+        if (flags & (SYS_RSX_EVENT_QUEUE_BASE | SYS_RSX_EVENT_QUEUE_BASE << 1)) ev |= PS3RSX_EVENT_QUEUE;
+        if (flags & SYS_RSX_EVENT_USER_CMD)
+        {
+            ev |= PS3RSX_EVENT_USER;
+            user_arg = vm::_ref<RsxDriverInfo>(render->driver_info).userCmdParam;
+        }
+        if (ev && s_on_event)
+            s_on_event(ev, user_arg);
+    }
+}
+
+unsigned g_ps3rsx_put_ea;   // ps3recomp: the FIFO's put (PS3_RSX_IDLE_WAIT's count of missed writes)
+
+static int ps3rsx_start_impl(const ps3rsx_params* p)
+{
+    if (!p || !p->hwnd || !p->context_addr)
+        return -1;
+    g_ps3rsx_put_ea = p->context_addr + 0x40;
+
+    if (const char* e = std::getenv("PS3RSX_LOG"))
+        s_listener.max_level = static_cast<unsigned>(std::atoi(e));
+    logs::listener::add(&s_listener);
+#ifdef _WIN32
+    AddVectoredExceptionHandler(0, cxx_throw_reporter);
+#endif
+
+    s_view = p->hwnd;
+    s_on_event = p->on_event;
+
+#ifdef PS3RSX_NO_OPENGL
+    g_cfg.video.renderer.set(video_renderer::vulkan);
+#else
+    g_cfg.video.renderer.set(p->renderer == PS3RSX_OPENGL ? video_renderer::opengl : video_renderer::vulkan);
+#endif
+    g_cfg.video.resolution.set(video_resolution::_720p);
+    // PS3_FRAME_LIMIT=none|30|50|60|120|display (RPCS3's frame limiter): a
+    // title that measures its frame time in vblanks (God of War: Ascension)
+    // runs fast above 59.94 fps without one. None by default.
+    {
+        const char* e = std::getenv("PS3_FRAME_LIMIT");
+        const std::string v = e ? e : "";
+        g_cfg.video.frame_limit.set(v == "30" ? frame_limit_type::_30 : v == "50" ? frame_limit_type::_50 :
+                                    v == "60" ? frame_limit_type::_60 : v == "120" ? frame_limit_type::_120 :
+                                    v == "display" ? frame_limit_type::display_rate : frame_limit_type::none);
+    }
+    g_cfg.video.vsync.set(vsync_mode::off);
+    // The FIFO fetch: "direct" (RPCS3's Fast) by default. Atomic made every
+    // SPU write into IO-mapped memory take a lock shared with the FIFO
+    // fetcher (ps3rsx_dma_put): God of War: Ascension's post-process tasks
+    // write their images there and waited on the RSX thread, ~5 % of them;
+    // the menu went from 45-48 to 50-51 fps (one run 60), no FIFO error in
+    // the menu or the level. PS3_RSX_FIFO=atomic / ordered for the old modes.
+    g_cfg.core.rsx_fifo_accuracy.set(rsx_fifo_mode::fast);
+    if (const char* e = std::getenv("PS3_RSX_FIFO"))
+    {
+        if (!std::strcmp(e, "direct")) g_cfg.core.rsx_fifo_accuracy.set(rsx_fifo_mode::fast);
+        else if (!std::strcmp(e, "atomic")) g_cfg.core.rsx_fifo_accuracy.set(rsx_fifo_mode::atomic);
+        else if (!std::strcmp(e, "ordered")) g_cfg.core.rsx_fifo_accuracy.set(rsx_fifo_mode::atomic_ordered);
+        else std::fprintf(stderr, "[ps3rsx] unknown PS3_RSX_FIFO=%s (keeping default)\n", e);
+    }
+    std::fprintf(stderr, "[ps3rsx] FIFO fetch mode=%u\n", static_cast<unsigned>(g_cfg.core.rsx_fifo_accuracy.get()));
+    // The launcher's video settings: PS3_VSYNC=1/0 (unset: off),
+    // PS3_RENDER_SCALE=<25-800> percent of the game's resolution,
+    // PS3_SCALE_FILTER=linear/nearest/fsr, PS3_ASPECT=stretch, and
+    // PS3_ANISO=<0-16> (0: the game's own filtering).
+    if (const char* e = std::getenv("PS3_VSYNC"); e && e[0] == '1')
+        g_cfg.video.vsync.set(vsync_mode::full);
+
+    // PS3_FPS_LIMIT=<1-1000>: cap the flip rate at this many frames per second.
+    // frame_limit is `none` above (the launcher only exposes VSync), and RPCS3
+    // applies second_frame_limit on top of `none` as well -- `none` leaves limit
+    // at 0 and the second limit takes over -- so this needs no enum widened and
+    // changes nothing when the variable is unset.
+    if (const char* e = std::getenv("PS3_FPS_LIMIT"))
+    {
+        const double v = std::atof(e);
+        if (v >= 1.0 && v <= 1000.0)
+            g_cfg.video.second_frame_limit.set(static_cast<float>(v));
+    }
+    if (const char* e = std::getenv("PS3_RENDER_SCALE"))
+    {
+        const int v = std::atoi(e);
+        if (v >= 25 && v <= 800)
+            g_cfg.video.resolution_scale_percent.set(static_cast<u32>(v));
+    }
+    if (const char* e = std::getenv("PS3_SCALE_FILTER"))
+        g_cfg.video.output_scaling.set(!std::strcmp(e, "nearest") ? output_scaling_mode::nearest :
+                                       !std::strcmp(e, "fsr") ? output_scaling_mode::fsr :
+                                       output_scaling_mode::bilinear);
+    if (const char* e = std::getenv("PS3_ASPECT"))
+        g_cfg.video.stretch_to_display_area.set(!std::strcmp(e, "stretch"));
+    if (const char* e = std::getenv("PS3_ANISO"))
+    {
+        const int v = std::atoi(e);
+        if (v >= 0 && v <= 16)
+            g_cfg.video.anisotropic_level_override.set(static_cast<u32>(v));
+    }
+    // The title's SPU post-process (MLAA) reads its render targets back from
+    // local memory.
+    // PS3_RSX_WCB=0: RPCS3 flushes a surface only when its pages are touched
+    // (the host's fault handler), not after every draw.
+    {
+        const char* e = std::getenv("PS3_RSX_WCB");
+        g_cfg.video.write_color_buffers.set(!(e && e[0] == '0'));
+    }
+    // PS3_RSX_LOG_PROGRAMS=1: "Log shader programs" (each program's GLSL in
+    // <cache dir>/shaderlog), a diagnostic.
+    {
+        const char* e = std::getenv("PS3_RSX_LOG_PROGRAMS");
+        g_cfg.video.log_programs.set(e && e[0] == '1');
+    }
+    // PS3_RSX_WDB=1: "Write Depth Buffer" (a diagnostic: PS3RSX_PASS_DUMP
+    // then also writes each pass's zeta).
+    {
+        const char* e = std::getenv("PS3_RSX_WDB");
+        g_cfg.video.write_depth_buffer.set(e && e[0] == '1');
+    }
+    // RPCS3's own per-game settings for Ascension turn "Accurate ZCULL stats"
+    // off: with it on the RSX thread waits for the GPU's occlusion queries.
+    // PS3_RSX_ZPASS=1 keeps them accurate, PS3_RSX_RELAXED_ZCULL=1 relaxes
+    // the ZCULL sync, PS3_RSX_MT=1 is "Multithreaded RSX" (a second thread
+    // takes part of the FIFO's work).
+    {
+        const char* e = std::getenv("PS3_RSX_ZPASS");
+        g_cfg.video.precise_zpass_count.set(e && e[0] == '1');
+        e = std::getenv("PS3_RSX_RELAXED_ZCULL");
+        g_cfg.video.relaxed_zcull_sync.set(e && e[0] == '1');
+        e = std::getenv("PS3_RSX_MT");
+        g_cfg.video.multithreaded_rsx.set(e && e[0] == '1');
+        // PS3_RSX_NO_ZCULL_QUERIES=1: "Disable ZCull Occlusion Queries" (the
+        // queries report as passing; ZCULL work off the RSX thread).
+        e = std::getenv("PS3_RSX_NO_ZCULL_QUERIES");
+        g_cfg.video.disable_zcull_queries.set(e && e[0] == '1');
+        // PS3_RSX_HOST_LABELS=1: "Allow Host GPU Labels" -- the GPU writes
+        // the semaphores when it gets to them (the host is told then, see
+        // release_GCM_label), and with it passthrough DMA (guest memory
+        // imported into the GPU) is on.
+        e = std::getenv("PS3_RSX_HOST_LABELS");
+        g_cfg.video.host_label_synchronization.set(e && e[0] == '1');
+    }
+    // RPCS3's per-game settings for Ascension also turn MSAA off and run the
+    // shaders at Ultra precision; this library's defaults are MSAA Auto and
+    // High, and with them the port drew rainbow-edged fire and blocky colour
+    // where RPCS3 itself (same scene, its Ascension config) draws it right.
+    // PS3_RSX_MSAA=auto puts MSAA back on; PS3_RSX_SHADER_PRECISION=
+    // low|auto|high|ultra picks the precision.
+    {
+        const char* e = std::getenv("PS3_RSX_MSAA");
+        g_cfg.video.antialiasing_level.set(e && !std::strcmp(e, "auto") ? msaa_level::_auto : msaa_level::none);
+        e = std::getenv("PS3_RSX_SHADER_PRECISION");
+        g_cfg.video.shader_precision.set(
+            !e ? gpu_preset_level::ultra :
+            !std::strcmp(e, "low") ? gpu_preset_level::low :
+            !std::strcmp(e, "auto") ? gpu_preset_level::_auto :
+            !std::strcmp(e, "high") ? gpu_preset_level::high : gpu_preset_level::ultra);
+        // PS3_RSX_NO_VERTEX_CACHE=1: "Disable Vertex Cache" (every draw uploads
+        // its vertices again instead of reusing a range uploaded before).
+        e = std::getenv("PS3_RSX_NO_VERTEX_CACHE");
+        g_cfg.video.disable_vertex_cache.set(e && e[0] == '1');
+    }
+    // No RPCS3 game paths here (VFS, title id): no boot music, no RPCS3
+    // overlays but the two below, no shader cache under RPCS3's cache folder.
+    g_cfg.misc.play_music_during_boot.set(false);
+    g_cfg.misc.use_native_interface.set(false);
+    // PS3_OVERLAY_OFF=1: nothing drawn over the picture while playing (the
+    // launcher's choice): no corner counter and no compile notices. The shader
+    // loading dialog is not one of them -- see the cache block below.
+    const char* ov_off = std::getenv("PS3_OVERLAY_OFF");
+    const bool overlay_off = ov_off && ov_off[0] && ov_off[0] != '0';
+    // The performance counter is the in-game panel's (ps3rsx_overlay.cpp, F3):
+    // 1 the rate, 2 and up detailed, with the host's guest lines.
+    ps3rsx_overlay_set_counter(overlay_off || p->perf_overlay <= 0 ? 0 : p->perf_overlay == 1 ? 1 : 2);
+    g_ps3recomp_perf_guest_text = p->perf_guest_text;
+    // PS3_OVERLAY_FONT=<path to a .ttf> (the port's own font, for the
+    // performance overlay and the shader loading screen; its folder
+    // joins the font dirs) and PS3_OVERLAY_COLORS=<body>,<body back>,
+    // <title>,<title back> as #RRGGBBAA, the port's palette.
+    if (const char* f = std::getenv("PS3_OVERLAY_FONT"); f && *f)
+    {
+        const std::string path = f;
+        const auto slash = path.find_last_of("/\\");
+        s_font_dir = slash == std::string::npos ? std::string() : path.substr(0, slash + 1);
+        g_cfg.video.perf_overlay.font.from_string(slash == std::string::npos ? path : path.substr(slash + 1));
+    }
+    if (const char* c = std::getenv("PS3_OVERLAY_COLORS"); c && *c)
+    {
+        std::vector<std::string> v;
+        for (std::string s = c; !s.empty();)
+        {
+            const auto comma = s.find(',');
+            v.push_back(s.substr(0, comma));
+            s = comma == std::string::npos ? std::string() : s.substr(comma + 1);
+        }
+        if (v.size() >= 4)
+        {
+            g_cfg.video.perf_overlay.color_body.from_string(v[0]);
+            g_cfg.video.perf_overlay.background_body.from_string(v[1]);
+            g_cfg.video.perf_overlay.color_title.from_string(v[2]);
+            g_cfg.video.perf_overlay.background_title.from_string(v[3]);
+            g_cfg.video.perf_overlay.opacity.set(100);
+        }
+    }
+    // PS3_SHADER_CACHE=<folder>: RPCS3's on-disk shader cache there
+    // (shim/emu.cpp), preloaded behind a loading screen of the RSX's own
+    // (Overlays/Shaders/shader_loading_dialog.cpp), which needs the native
+    // interface's overlay manager.
+    {
+        const char* e = std::getenv("PS3_SHADER_CACHE");
+        const bool on = e && *e && std::strcmp(e, "0") != 0;
+        g_cfg.video.disable_on_disk_shader_cache.set(!on);
+        // PS3_OVERLAY_OFF does NOT drop the loading dialog: it is the only
+        // sign the game is starting (the preload runs for minutes before the
+        // first frame; without it the window is blank and looks like a dead
+        // launch). It is over the boot, never over the picture.
+        if (on)
+            g_cfg.misc.use_native_interface.set(true);
+    }
+    // Shaders compiled asynchronously, without RPCS3's shader interpreter,
+    // whose preload compiles its pipeline variants for many seconds before
+    // the RSX takes its first command.
+    g_cfg.video.shadermode.set(shader_mode::async_recompiler);
+
+    g_emu_callbacks.get_gs_frame = []() -> std::unique_ptr<GSFrameBase>
+    {
+        return std::make_unique<host_frame>(s_view);
+    };
+    g_emu_callbacks.close_gs_frame = []() {};
+    g_emu_callbacks.get_localized_string = [](localized_string_id, const char*) -> std::string { return {}; };
+    g_emu_callbacks.get_localized_u32string = [](localized_string_id, const char*) -> std::u32string { return {}; };
+    g_emu_callbacks.play_sound = [](const std::string&, std::optional<f32>) {};
+    // What the RSX and its backends call into RPCS3's application for, as
+    // RPCS3's headless application provides them (headless_application.cpp).
+    g_emu_callbacks.call_from_main_thread = [](std::function<void()> func, atomic_t<u32>* wake_up)
+    {
+        func();
+        if (wake_up)
+        {
+            *wake_up = true;
+            wake_up->notify_one();
+        }
+    };
+    g_emu_callbacks.get_localized_setting = [](const cfg::_base*, u32) -> std::string { return {}; };
+    g_emu_callbacks.display_sleep_control_supported = []() { return false; };
+    g_emu_callbacks.enable_display_sleep = [](bool) {};
+    g_emu_callbacks.handle_taskbar_progress = [](s32, s32) {};
+    g_emu_callbacks.on_run = [](bool) {};
+    g_emu_callbacks.on_pause = []() {};
+    g_emu_callbacks.on_resume = []() {};
+    g_emu_callbacks.on_stop = []() {};
+    g_emu_callbacks.on_ready = []() {};
+    g_emu_callbacks.enable_gamemode = [](bool) {};
+    g_emu_callbacks.get_msg_dialog = []() -> std::shared_ptr<MsgDialogBase> { return {}; };
+    g_emu_callbacks.get_osk_dialog = []() -> std::shared_ptr<OskDialogBase> { return {}; };
+    // The overlay's fonts: the system's (Arial and the like); there is no dev_flash.
+    g_emu_callbacks.get_font_dirs = []() -> std::vector<std::string>
+    {
+        std::vector<std::string> dirs;
+        if (!s_font_dir.empty())
+            dirs.push_back(s_font_dir);
+#ifdef _WIN32
+        const char* windir = std::getenv("WINDIR");
+        dirs.push_back(std::string(windir ? windir : "C:\\Windows") + "\\Fonts\\");
+#elif defined(__APPLE__)
+        dirs.insert(dirs.end(), { "/System/Library/Fonts/Supplemental/", "/System/Library/Fonts/", "/Library/Fonts/" });
+#elif defined(__ANDROID__)
+        dirs.push_back("/system/fonts/");
+#else
+        dirs.insert(dirs.end(), { "/usr/share/fonts/truetype/dejavu/", "/usr/share/fonts/TTF/" });
+#endif
+        return dirs;
+    };
+    g_emu_callbacks.make_video_source = []() -> std::unique_ptr<video_source> { return {}; };
+
+    // RSX loops wait while the emulator is not running.
+    Emu.SetTestMode();
+
+    g_fxo->reset();
+    ps3recomp_init_cpu_profiler();
+    g_fxo->init<rsx::avconf>();
+    g_fxo->init<rsx::vblank_thread>();
+    g_fxo->init<gcm_config>();
+    g_fxo->init<rsx::dma_manager>();
+
+    g_ps3recomp_rsx_event_hook = on_rsx_event;
+    s_on_guest_write = p->on_guest_write;
+    if (s_on_guest_write)
+        g_ps3recomp_rsx_write_hook = [](u32 address, u32 size) { s_on_guest_write(address, size); };
+    s_report_hold = p->report_hold;
+    if (s_report_hold)
+        g_ps3recomp_rsx_report_hold = [](u32 arg, u64 waited_us) { return s_report_hold(arg, waited_us) != 0; };
+    s_on_report = p->on_report;
+    if (s_on_report)
+        g_ps3recomp_rsx_report_hook = [](u32 address, bool awaited) { s_on_report(address, awaited ? 1 : 0); };
+
+#ifdef PS3RSX_NO_OPENGL
+    if (p->renderer == PS3RSX_OPENGL)
+        std::fprintf(stderr, "[ps3rsx] OpenGL is not built here; using Vulkan\n");
+    g_fxo->init<rsx::thread, named_thread<VKGSRender>>(static_cast<utils::serial*>(nullptr));
+#else
+    if (p->renderer == PS3RSX_OPENGL)
+        g_fxo->init<rsx::thread, named_thread<GLGSRender>>(static_cast<utils::serial*>(nullptr));
+    else
+        g_fxo->init<rsx::thread, named_thread<VKGSRender>>(static_cast<utils::serial*>(nullptr));
+#endif
+
+    const auto render = rsx::get_current_renderer();
+    if (!render)
+    {
+        std::fprintf(stderr, "[ps3rsx] could not create the RSX thread\n");
+        return -1;
+    }
+
+#ifdef _WIN32
+    u64 tid = 0;
+    for (int i = 0; i < 1000 && !tid; i++)   // the id is known once the thread runs
+    {
+#ifndef __APPLE__
+        if (p->renderer == PS3RSX_OPENGL)
+            tid = thread_ctrl::get_native_id(*static_cast<named_thread<GLGSRender>*>(static_cast<GLGSRender*>(render)));
+        else
+#endif
+            tid = thread_ctrl::get_native_id(*static_cast<named_thread<VKGSRender>*>(static_cast<VKGSRender*>(render)));
+        if (!tid) Sleep(1);
+    }
+    if (tid && p->rsx_thread_started) p->rsx_thread_started(static_cast<unsigned long>(tid));
+    // PS3_PIN_RSX=<logical CPU>: the RSX thread on that CPU only, apart from
+    // the cores SPURS_PIN and PS3_PIN_PPU give the SPUs and the PPU.
+    if (const char* pin = std::getenv("PS3_PIN_RSX"); pin && *pin)
+    {
+        const unsigned cpu = static_cast<unsigned>(std::atoi(pin));
+        HANDLE h = tid ? OpenThread(THREAD_SET_INFORMATION | THREAD_QUERY_INFORMATION, FALSE, static_cast<DWORD>(tid)) : nullptr;
+        const bool ok = h && cpu < 64 && SetThreadAffinityMask(h, static_cast<DWORD_PTR>(1) << cpu);
+        if (h) CloseHandle(h);
+        std::fprintf(stderr, "[ps3rsx] RSX thread %llu pinned to CPU %u: %s\n",
+                     static_cast<unsigned long long>(tid), cpu, ok ? "ok" : "failed");
+    }
+#endif
+
+    // The RSX context, laid out as sys_rsx_context_allocate does: DMA control
+    // (put/get/ref at +0x40), driver info at +1 MB, reports (semaphores, then
+    // notifies at +0x1000, reports at +0x1400) at +2 MB, and the device page
+    // past them.
+    const u32 dma = p->context_addr;
+    const u32 driver = dma + 0x100000;
+    const u32 reports = dma + 0x200000;
+
+    std::lock_guard lock(render->sys_rsx_mtx);
+
+    auto& r = *vm::_ptr<RsxReports>(reports);
+    std::memset(&r, 0, sizeof(RsxReports));
+    for (auto& n : r.notify)
+        n.timestamp = -1;
+    for (auto& rep : r.report)
+    {
+        rep.val = 0;
+        rep.timestamp = -1;
+        rep.pad = -1;
+    }
+
+    auto& info = *vm::_ptr<RsxDriverInfo>(driver);
+    std::memset(&info, 0, sizeof(RsxDriverInfo));
+    info.version_driver = 0x211;
+    info.version_gpu = 0x5c;
+    info.memory_size = p->local_size;
+    info.nvcore_frequency = 500000000;
+    info.memory_frequency = 650000000;
+    info.reportsNotifyOffset = 0x1000;
+    info.reportsOffset = 0;
+    info.reportsReportOffset = 0x1400;
+    info.hardware_channel = 1;
+
+    auto& ctrl = *vm::_ptr<RsxDmaControl>(dma);
+    ctrl.get = 0;
+    ctrl.put = 0;
+    ctrl.ref = 0;
+
+    render->isHLE = false;
+    render->driver_info = driver;
+    render->label_addr = reports;
+    render->device_addr = dma + 0x2F0000;
+    render->local_mem_size = p->local_size;
+    render->main_mem_size = 0x10000000;
+    render->display_buffers_count = 0;
+    render->current_display_buffer = 0;
+    render->init(dma);
+
+    std::fprintf(stderr, "[ps3rsx] RPCS3 RSX (%s) on context 0x%08X\n",
+                 p->renderer == PS3RSX_OPENGL ? "OpenGL" : "Vulkan", dma);
+    return 0;
+}
+
+extern "C" int ps3rsx_dma_put(unsigned ea, const void* source, unsigned size)
+{
+    const auto render = rsx::get_current_renderer();
+    if (!render || !size || ea >= rsx::constants::local_mem_base || !g_cfg.core.rsx_fifo_accuracy)
+        return 0;
+    // Matches SPUThread::do_dma_transfer: shared writer lock versus the
+    // FIFO fetcher's exclusive lock, covering every crossed 8 KB section.
+    rsx::reservation_lock<false, 1> lock(ea, size, true);
+    std::memcpy(vm::base(ea), source, size);
+    return 1;
+}
+
+static void ps3rsx_iomap_impl(u32 ea, u32 io, u32 size)
+{
+    const auto render = rsx::get_current_renderer();
+    if (!render)
+        return;
+    std::lock_guard lock(render->sys_rsx_mtx);
+    auto& table = render->iomap_table;
+    for (u32 i = 0, n = (size + 0xFFFFF) >> 20; i < n; i++)
+    {
+        const u32 io_page = (io >> 20) + i, ea_page = (ea >> 20) + i;
+        const u32 prev_ea = table.ea[io_page];
+        table.ea[io_page].release(ea_page << 20);
+        if (prev_ea + 1)
+            table.io[prev_ea >> 20].release(-1);
+        table.io[ea_page].release(io_page << 20);
+    }
+}
+
+static void ps3rsx_iounmap_impl(u32 io, u32 size)
+{
+    const auto render = rsx::get_current_renderer();
+    if (!render)
+        return;
+    std::lock_guard lock(render->sys_rsx_mtx);
+    auto& table = render->iomap_table;
+    for (u32 i = 0, n = size >> 20; i < n; i++)
+    {
+        const u32 io_page = (io >> 20) + i;
+        const u32 ea_entry = table.ea[io_page];
+        table.ea[io_page].release(-1);
+        if (ea_entry + 1)
+            table.io[ea_entry >> 20].release(-1);
+    }
+}
+
+static void ps3rsx_set_display_buffer_impl(u32 id, u32 offset, u32 pitch, u32 width, u32 height)
+{
+    const auto render = rsx::get_current_renderer();
+    if (!render || id > 7)
+        return;
+    std::lock_guard lock(render->sys_rsx_mtx);
+    render->display_buffers[id].width = width;
+    render->display_buffers[id].height = height;
+    render->display_buffers[id].pitch = pitch;
+    render->display_buffers[id].offset = offset;
+    render->display_buffers_count = std::max<u32>(id + 1, render->display_buffers_count);
+}
+
+static int ps3rsx_flip_impl(u32 id)
+{
+    const auto render = rsx::get_current_renderer();
+    return render && render->request_emu_flip(id) ? 1 : 0;
+}
+
+// The C entry points: RPCS3 reports errors as C++ exceptions, which must not
+// cross into the C caller.
+static void report_exception(const char* where, const std::exception& e)
+{
+    std::fprintf(stderr, "[ps3rsx] %s: %s\n", where, e.what());
+    std::fflush(stderr);
+}
+
+extern "C" int ps3rsx_start(const ps3rsx_params* p)
+{
+    try { return ps3rsx_start_impl(p); }
+    catch (const std::exception& e) { report_exception("ps3rsx_start", e); }
+    return -1;
+}
+
+extern "C" void ps3rsx_iomap(u32 ea, u32 io, u32 size)
+{
+    try { ps3rsx_iomap_impl(ea, io, size); }
+    catch (const std::exception& e) { report_exception("ps3rsx_iomap", e); }
+}
+
+extern "C" void ps3rsx_iounmap(u32 io, u32 size)
+{
+    try { ps3rsx_iounmap_impl(io, size); }
+    catch (const std::exception& e) { report_exception("ps3rsx_iounmap", e); }
+}
+
+extern "C" void ps3rsx_set_display_buffer(u32 id, u32 offset, u32 pitch, u32 width, u32 height)
+{
+    try { ps3rsx_set_display_buffer_impl(id, offset, pitch, width, height); }
+    catch (const std::exception& e) { report_exception("ps3rsx_set_display_buffer", e); }
+}
+
+extern "C" int ps3rsx_flip(u32 id)
+{
+    try { return ps3rsx_flip_impl(id); }
+    catch (const std::exception& e) { report_exception("ps3rsx_flip", e); }
