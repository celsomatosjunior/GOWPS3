diff --git a/gpu/tests/ps3rsx_flip_smoke.c b/gpu/tests/ps3rsx_flip_smoke.c
new file mode 100644
index 00000000..21a21065
--- /dev/null
+++ b/gpu/tests/ps3rsx_flip_smoke.c
@@ -0,0 +1,147 @@
+/* ps3rsx_flip_smoke: RPCS3's RSX through ps3rsx.h, without a game. Opens a
+ * window, starts the RSX (Vulkan, or OpenGL with an argument "gl"), and hands
+ * it a FIFO that clears display buffer 0 to red and flips it. Exit code 0 when
+ * the RSX consumed the FIFO and reported the flip. */
+#include "ps3rsx.h"
+
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CONTEXT_ADDR 0x2E000000u   /* RSX context (3 MB) */
+#define FIFO_EA      0x10000000u   /* command buffer, mapped at IO 0 */
+#define LOCAL_BASE   0xC0000000u
+
+static volatile LONG s_flips;
+
+static void on_event(unsigned events, unsigned user_arg)
+{
+    (void)user_arg;
+    if (events & PS3RSX_EVENT_FLIP) InterlockedIncrement(&s_flips);
+}
+
+static unsigned char* s_base;
+
+static void w32(unsigned ea, unsigned v)   /* big-endian, as the guest writes */
+{
+    unsigned char* p = s_base + ea;
+    p[0] = (unsigned char)(v >> 24); p[1] = (unsigned char)(v >> 16);
+    p[2] = (unsigned char)(v >> 8);  p[3] = (unsigned char)v;
+}
+
+static unsigned r32(unsigned ea)
+{
+    const unsigned char* p = s_base + ea;
+    return (unsigned)p[0] << 24 | (unsigned)p[1] << 16 | (unsigned)p[2] << 8 | p[3];
+}
+
+static unsigned s_put;
+static void method(unsigned m, unsigned arg)
+{
+    w32(FIFO_EA + s_put, (1u << 18) | m);
+    w32(FIFO_EA + s_put + 4, arg);
+    s_put += 8;
+}
+
+/* Every other thread's stack as exe-relative addresses (resolve them with the
+ * link map, ps3rsx_flip_smoke.map), to see where one is stuck. */
+#include <tlhelp32.h>
+static void dump_thread_stacks(void)
+{
+    const DWORD self = GetCurrentThreadId(), pid = GetCurrentProcessId();
+    const ULONG64 exe = (ULONG64)GetModuleHandleA(NULL);
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    THREADENTRY32 te = { sizeof te };
+    for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+        if (te.th32OwnerProcessID != pid || te.th32ThreadID == self) continue;
+        HANDLE h = OpenThread(THREAD_ALL_ACCESS, FALSE, te.th32ThreadID);
+        if (!h) continue;
+        SuspendThread(h);
+        CONTEXT c = { 0 };
+        c.ContextFlags = CONTEXT_FULL;
+        if (GetThreadContext(h, &c)) {
+            fprintf(stderr, "[stack] tid %lu:", te.th32ThreadID);
+            for (int i = 0; i < 32 && c.Rip; i++) {
+                if (c.Rip >= exe && c.Rip < exe + 0x40000000ull) fprintf(stderr, " %llX", c.Rip - exe);
+                else fprintf(stderr, " ?");
+                DWORD64 base = 0;
+                PRUNTIME_FUNCTION f = RtlLookupFunctionEntry(c.Rip, &base, NULL);
+                if (!f) { c.Rip = *(DWORD64*)c.Rsp; c.Rsp += 8; continue; }
+                void* hd; DWORD64 ef;
+                RtlVirtualUnwind(UNW_FLAG_NHANDLER, base, c.Rip, f, &c, &hd, &ef, NULL);
+            }
+            fputc('\n', stderr);
+        }
+        ResumeThread(h);
+        CloseHandle(h);
+    }
+    CloseHandle(snap);
+    fflush(stderr);
+}
+
+static LRESULT CALLBACK wndproc(HWND h, UINT m, WPARAM w, LPARAM l)
+{
+    if (m == WM_DESTROY) { PostQuitMessage(0); return 0; }
+    return DefWindowProcA(h, m, w, l);
+}
+
+int main(int argc, char** argv)
+{
+    const int gl = argc > 1 && strcmp(argv[1], "gl") == 0;
+
+    WNDCLASSA wc = {0};
+    wc.lpfnWndProc = wndproc;
+    wc.hInstance = GetModuleHandleA(NULL);
+    wc.lpszClassName = "ps3rsx_smoke";
+    RegisterClassA(&wc);
+    RECT r = {0, 0, 1280, 720};
+    AdjustWindowRect(&r, WS_OVERLAPPEDWINDOW, FALSE);
+    HWND hwnd = CreateWindowA("ps3rsx_smoke", "ps3rsx flip smoke", WS_OVERLAPPEDWINDOW | WS_VISIBLE,
+                              CW_USEDEFAULT, CW_USEDEFAULT, r.right - r.left, r.bottom - r.top,
+                              NULL, NULL, wc.hInstance, NULL);
+
+    s_base = ps3rsx_init_memory();
+    if (!s_base) { printf("ps3rsx_init_memory failed\n"); return 1; }
+
+    ps3rsx_params p = {0};
+    p.hwnd = hwnd;
+    p.renderer = gl ? PS3RSX_OPENGL : PS3RSX_VULKAN;
+    p.context_addr = CONTEXT_ADDR;
+    p.local_size = 0x10000000u;
+    p.on_event = on_event;
+    if (ps3rsx_start(&p) != 0) { printf("ps3rsx_start failed\n"); return 1; }
+
+    ps3rsx_iomap(FIFO_EA, 0, 0x100000);
+    ps3rsx_set_display_buffer(0, 0, 1280 * 4, 1280, 720);
+
+    /* Colour target A: display buffer 0 (local offset 0), 1280x720 A8R8G8B8. */
+    method(0x0184, 0xFEED0000u);                         /* SET_CONTEXT_DMA_COLOR_A: local */
+    method(0x0200, 1280u << 16);                         /* SURFACE_CLIP_HORIZONTAL */
+    method(0x0204, 720u << 16);                          /* SURFACE_CLIP_VERTICAL */
+    method(0x0208, 8u | (2u << 5) | (1u << 8));          /* SURFACE_FORMAT: A8R8G8B8, Z24S8, linear */
+    method(0x020C, 1280u * 4u);                          /* SURFACE_PITCH_A */
+    method(0x0210, 0);                                   /* SURFACE_COLOR_AOFFSET */
+    method(0x0220, 1);                                   /* SURFACE_COLOR_TARGET: A */
+    method(0x1D90, 0xFFFF0000u);                         /* COLOR_CLEAR_VALUE: red */
+    method(0x1D94, 0xF0);                                /* CLEAR_SURFACE: RGBA */
+    method(0xE920, 0);                                   /* GCM flip, head 0: buffer at offset 0 */
+
+    w32(CONTEXT_ADDR + 0x40, s_put);                     /* put */
+
+    const DWORD t0 = GetTickCount();
+    MSG msg;
+    while (GetTickCount() - t0 < 4000) {
+        while (PeekMessageA(&msg, NULL, 0, 0, PM_REMOVE)) { TranslateMessage(&msg); DispatchMessageA(&msg); }
+        Sleep(10);
+        { static DWORD last; if (GetTickCount() - last >= 1000) { last = GetTickCount(); ps3rsx_debug_dump(); } }
+    }
+
+    ps3rsx_debug_dump();
+    if (getenv("SMOKE_STACKS")) dump_thread_stacks();
+    const unsigned get = r32(CONTEXT_ADDR + 0x44);
+    printf("ps3rsx_flip_smoke: put=0x%X get=0x%X flips=%ld\n", s_put, get, s_flips);
+    fflush(stdout);
+    const int ok = get == s_put && s_flips > 0;
+    ExitProcess(ok ? 0 : 1);   /* the RSX threads are not torn down here */
+}
