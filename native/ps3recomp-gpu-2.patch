+    int         GetSelectionStart() const;
+    int         GetSelectionEnd() const;
+    void        SelectAll();
+
+    // Reload user buf (WIP #2890)
+    // If you modify underlying user-passed const char* while active you need to call this (InputText V2 may lift this)
