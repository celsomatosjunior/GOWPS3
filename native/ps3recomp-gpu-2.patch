+
+	void notify_one()
+		requires(sizeof(type) == 4 || sizeof(type) == 8)
+	{
+		atomic_wait_engine::notify_one(&m_data);
+	}
+
+	void notify_all()
+		requires(sizeof(type) == 4 || sizeof(type) == 8)
+	{
+		atomic_wait_engine::notify_all(&m_data);
+	}
+};
