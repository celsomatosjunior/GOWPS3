+void ImGui::PopFocusScope()
+{
+    ImGuiContext& g = *GImGui;
+    if (g.FocusScopeStack.Size <= g.StackSizesInBeginForCurrentWindow->SizeOfFocusScopeStack)
+    {
+        IM_ASSERT_USER_ERROR(0, "Calling PopFocusScope() too many times!");
