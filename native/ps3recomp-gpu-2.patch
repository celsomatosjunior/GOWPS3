+	// The notice in the bottom right while the RSX compiles shaders it met for the first time (RPCS3's own hint is
+	// off): a diamond turning, how many this time; it fades out a moment after the last one.
+	void spinner(ImVec2 c, float r, float s)
+	{
+		const float ph = static_cast<float>(std::fmod(g_time, 1.2) / 1.2), a = 0.7853982f + 1.5707963f * ease(std::min(ph / 0.6f, 1.0f));
+		ImVec2 p[4];
+		for (int i = 0; i < 4; i++) p[i] = ImVec2(c.x + r * std::cos(a + i * 1.5707963f), c.y + r * std::sin(a + i * 1.5707963f));
+		ImDrawList* dl = ImGui::GetWindowDrawList();
+		dl->AddPolyline(p, 4, rgba(EMBER, 0.25f), ImDrawFlags_Closed, 5 * s);
+		dl->AddPolyline(p, 4, rgba(EMBER, 1), ImDrawFlags_Closed, 2 * s);
+	}
+
+	void draw_toast(float s, float dt)
+	{
+		static float a;
+		static int base;            // the count when this notice showed
+		if (overlay_off()) { a = 0; g_toast_live = 0; return; }   // a performance notice
+		const bool busy = now_ms() - g_shader_last_ms.load() < 1200;
+		const bool on = g_toast.load() && busy;
+		if (on && a <= 0) base = std::max(g_shaders.load() - 1, 0);
+		a = on ? std::min(1.0f, a + dt / 0.25f) : std::max(0.0f, a - dt / 0.4f);
+		g_toast_live = a > 0 || on;
+		if (a <= 0) return;
+		const ImGuiIO& io = ImGui::GetIO();
+		const float k = ease(a), pad = 24 * s;
+		ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x - pad, io.DisplaySize.y - pad + (1 - k) * 12 * s), ImGuiCond_Always, ImVec2(1, 1));
+		ImGui::PushStyleVar(ImGuiStyleVar_Alpha, k);
+		ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(14 * s, 11 * s));
+		ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 12 * s);
+		ImGui::PushStyleColor(ImGuiCol_WindowBg, ImVec4(0.055f, 0.027f, 0.020f, 0.90f));
+		ImGui::PushStyleColor(ImGuiCol_Border, alpha(EMBER, 0.40f));
+		ImGui::Begin("##toast", nullptr, ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_AlwaysAutoResize |
+		             ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoMove);
+		const ImVec2 p = ImGui::GetCursorScreenPos();
+		const float box = 28 * s;
+		ImGui::Dummy(ImVec2(box, box));
+		spinner(ImVec2(p.x + box / 2, p.y + box / 2), 8 * s, s);
+		ImGui::SameLine(0, 12 * s);
+		ImGui::BeginGroup();
+		ImGui::TextColored(GOLD_HI, "%s", busy ? L("Compilando shaders…", "Compiling shaders…") : L("Shaders prontos", "Shaders ready"));
+		ImGui::PushFont(f_small);
+		const int n = std::max(g_shaders.load() - base, 1);
+		if (busy) ImGui::TextColored(MUTED, L("%d novos  ·  o jogo segue rodando", "%d new  ·  the game keeps running"), n);
+		else ImGui::TextColored(MUTED, "%s", L("guardados no cache para a próxima vez", "kept in the cache for next time"));
+		ImGui::PopFont();
+		ImGui::EndGroup();
+		ImGui::End();
+		ImGui::PopStyleColor(2);
+		ImGui::PopStyleVar(3);
+	}
