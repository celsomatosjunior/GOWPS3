+	bool rail_button(int which, bool active, float size, float s, const char* tip)
+	{
+		const ImVec2 p = ImGui::GetCursorScreenPos(), q(p.x + size, p.y + size), c(p.x + size / 2, p.y + size / 2);
+		ImGui::PushID(which);
+		const bool clicked = ImGui::InvisibleButton("##tab", ImVec2(size, size));
