+				return res;
+			}
+			else
+			{
+				return res && serialize_tuple<next_i>(obj);
+			}
+		}
+
+		// std::pair, std::tuple
+		template <typename T> requires TupleAlike<T>
+		bool serialize(T& obj)
+		{
+			return serialize_tuple(obj);
+		}
+
+		// Wrapper for serialize(T&), allows to pass multiple objects at once
