+	ImVec4 rate_colour(double fps) { return fps >= 28.5 ? OK_GREEN : fps >= 22 ? GOLD : DANGER; }   // the game aims at 30
+
+	void frame_stats(float* avg, float* worst, float* low1)
+	{
+		*avg = *worst = *low1 = 0;
+		if (!g_ft_n) return;
+		float v[HIST];
+		for (int i = 0; i < g_ft_n; i++) v[i] = g_ft[(g_ft_at - g_ft_n + i + HIST) % HIST];
+		double sum = 0;
+		for (int i = 0; i < g_ft_n; i++) { sum += v[i]; *worst = std::max(*worst, v[i]); }
+		*avg = static_cast<float>(sum / g_ft_n);
+		const int k = std::min(g_ft_n - 1, static_cast<int>(g_ft_n * 0.99f));   // 1% low: the 99th percentile time as a rate
+		std::nth_element(v, v + k, v + g_ft_n);
+		*low1 = v[k] > 0 ? 1000.0f / v[k] : 0;
+	}
