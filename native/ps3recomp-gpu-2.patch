+	// Every icon decoded once (stb_image) and scaled to ICON by area averaging.
+	void load_icons()
+	{
+		g_icons_loaded = true;
+		const int n = g_trophy_count ? g_trophy_count() : 0;
+		g_icon_px.assign(n, {});
+		for (int id = 0; id < n && g_trophy_icon; id++)
+		{
+			const unsigned char* png = nullptr;
+			unsigned long long size = 0;
+			if (g_trophy_icon(id, &png, &size) != 0) continue;
+			int w = 0, h = 0, comp = 0;
+			unsigned char* px = stbi_load_from_memory(png, static_cast<int>(size), &w, &h, &comp, 4);
+			if (!px) continue;
+			std::vector<unsigned char>& out = g_icon_px[id];
+			out.resize(ICON * ICON * 4);
+			for (int y = 0; y < ICON; y++)
+				for (int x = 0; x < ICON; x++)
+				{
+					const int x0 = x * w / ICON, x1 = std::max(x0 + 1, (x + 1) * w / ICON);
+					const int y0 = y * h / ICON, y1 = std::max(y0 + 1, (y + 1) * h / ICON);
+					unsigned sum[4] = {};
+					for (int yy = y0; yy < y1; yy++)
+						for (int xx = x0; xx < x1; xx++)
+							for (int c = 0; c < 4; c++) sum[c] += px[(yy * w + xx) * 4 + c];
+					const unsigned cnt = static_cast<unsigned>((x1 - x0) * (y1 - y0));
+					for (int c = 0; c < 4; c++) out[(y * ICON + x) * 4 + c] = static_cast<unsigned char>(sum[c] / cnt);
+				}
+			stbi_image_free(px);
+		}
+	}
