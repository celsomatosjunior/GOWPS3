+			{
+				const char* om = "Ω";   // the Omega, U+03A9
+				const ImVec2 ts = f_omega->CalcTextSizeA(f_omega->FontSize, FLT_MAX, 0, om);
+				const ImVec2 at(c.x - ts.x / 2, c.y - ts.y / 2);
+				for (int k = 0; k < 8; k++)   // the glow
+				{
+					const float a = k * 0.7853982f, d = 2.2f * s;
+					dl->AddText(f_omega, f_omega->FontSize, ImVec2(at.x + d * std::cos(a), at.y + d * std::sin(a)), rgba(DANGER, 0.10f * (0.7f + 0.3f * glow)), om);
+				}
+				dl->AddText(f_omega, f_omega->FontSize, at, rgba(BLOOD_HI, 1), om);
+			}
+			else dl->AddCircleFilled(c, 4 * s, rgba(BLOOD_HI, 0.6f + 0.4f * glow));
+			const float bs = 52 * s;
+			ImGui::SetCursorPosY(76 * s);
+			for (int t = 0; t < TABS; t++)
+			{
+				ImGui::SetCursorPosX((rail - bs) / 2);
+				if (rail_button(t, g_tab == t, bs, s, tab_name(t)) && g_tab != t) { g_tab = t; g_tab_t = g_time; }
+				ImGui::Dummy(ImVec2(1, 4 * s));
+			}
+			const float cs = 44 * s;
+			ImGui::SetCursorPos(ImVec2((rail - cs) / 2, H - 22 * s - cs));
+			const ImVec2 p = ImGui::GetCursorScreenPos();
+			if (ImGui::InvisibleButton("##close", ImVec2(cs, cs))) g_panel = 0;
+			const bool hov = ImGui::IsItemHovered();
+			dl->AddRect(p, ImVec2(p.x + cs, p.y + cs), rgba(GOLD, hov ? 0.5f : 0.22f), 10 * s, 0, 1);
+			tab_icon(-1, ImVec2(p.x + cs / 2, p.y + cs / 2), 9 * s, ImGui::GetColorU32(hov ? CREAM : MUTED), 2 * s);
+			if (hov) ImGui::SetTooltip("%s", L("Fechar (F1 / Esc)", "Close (F1 / Esc)"));
+		}
+
+		// the content
+		const float px = 30 * s, top = 26 * s, foot = f_small->FontSize + 22 * s;
+		ImGui::SetCursorPos(ImVec2(rail + px, top));
+		ImGui::BeginChild("##content", ImVec2(w - rail - 2 * px, H - top - foot - 10 * s), 0, ImGuiWindowFlags_NoBackground);
+		stagger(0, s);
+		ImGui::PushFont(f_title);
+		ImGui::TextColored(GOLD_HI, "GOD OF WAR  ASCENSION");
+		ImGui::PopFont();
+		hint(tab_name(g_tab));
+		ImGui::PopStyleVar();
+		ImGui::Dummy(ImVec2(1, 6 * s));
+		switch (g_tab)
+		{
+		case TAB_PERF: tab_performance(fi, s); break;
+		case TAB_TROPHIES: tab_trophies(s); break;
+		case TAB_SHADERS: tab_shaders(s); break;
+		case TAB_OPTIONS: tab_options(s); break;
+		default: tab_system(fi, s);
+		}
+		ImGui::EndChild();
+		const float fy = H - foot;
+		dl->AddLine(ImVec2(x + rail + px, fy), ImVec2(x + w - px, fy), rgba(GOLD, 0.12f), 1);
+		ImGui::SetCursorPos(ImVec2(rail + px, fy - ImGui::GetWindowPos().y + 9 * s));
+		hint(L("F1 ou Esc fecha  ·  F3 contador  ·  F11 tela cheia", "F1 or Esc closes  ·  F3 counter  ·  F11 full screen"));
+		ImGui::End();
+	}
+}
+
+namespace ps3rsx_overlay
+{
+	bool ensure_context()
+	{
+		if (ImGui::GetCurrentContext()) return true;
+		ImGui::CreateContext();
+		ImGuiIO& io = ImGui::GetIO();
+		io.IniFilename = nullptr;
+		io.LogFilename = nullptr;
+		lang_init();
+		return true;
+	}
+
+	bool visible()
+	{
+		if (g_trophy_live.load()) return true;   // PS3_OVERLAY_OFF keeps these
+		if (overlay_off()) return false;
+		return g_panel.load() || g_anim.load() || g_counter.load() != COUNTER_OFF || g_toast_live.load() ||
+		       (g_toast.load() && now_ms() - g_shader_last_ms.load() < 1200);
+	}
+
+	void shader_compiled()
+	{
+		g_shaders++;
+		g_shader_last_ms = now_ms();
+	}
+
+	ImDrawData* build(const frame_info& fi, const std::function<void(bool)>& backend_frame)
+	{
+		ensure_context();
+		static auto last = std::chrono::steady_clock::now();
+		const auto now = std::chrono::steady_clock::now();
+		const double raw = std::chrono::duration<double>(now - last).count();
+		last = now;
+		const float dt = static_cast<float>(std::clamp(raw, 1e-4, 0.1));
+		g_time += dt;
+		frame_time(raw * 1000);
+		// The host's figures are read twice a second whatever the counter shows: reading them
+		// is what writes the [perf] line to the log every 5 s (boot_main.cpp), and a run with
+		// the counter off (LD_PERF_OVERLAY=0, the title's default) logged no fps at all.
+		if (sample(raw)) guest_read();
+
+		const bool panel = g_panel.load() != 0;
+		g_open = panel ? std::min(1.0f, g_open + dt / 0.32f) : std::max(0.0f, g_open - dt / 0.22f);
+		g_anim = g_open > 0 && g_open < 1;
+		const bool counter = !overlay_off() && g_counter.load() != COUNTER_OFF;
+		// PS3_OVERLAY_OFF drops the compile notice, never the trophy notices.
+		const bool toast = g_trophy_live.load() || (!overlay_off() &&
+			(g_toast_live.load() || (g_toast.load() && now_ms() - g_shader_last_ms.load() < 1200)));
+		if ((g_open <= 0 && !counter && !toast) || !fi.width || !fi.height)
+		{
+			std::lock_guard lock(g_mu);
+			g_in.clear();
+			return nullptr;
+		}
+
+		ImGuiIO& io = ImGui::GetIO();
+		const float s = std::clamp(std::round(fi.height / 1080.0f * 8) / 8, 0.75f, 2.5f);   // in eighths: few rebuilds while resizing
+		if (!g_icons_loaded && g_trophy_count && g_trophy_count() > 0)
+		{
+			load_icons();
+			g_scale = 0;   // the atlas again, with them
+		}
+		if (s != g_scale)
+		{
+			build_fonts(s);
+			build_style(s);
+			g_scale = s;
+			g_fonts_dirty = true;
+		}
+		io.DeltaTime = dt;
+		io.DisplaySize = ImVec2(static_cast<float>(fi.width), static_cast<float>(fi.height));
+		{
+			std::lock_guard lock(g_mu);
+			for (const auto& e : g_in)
+			{
+				if (e.type == IN_POS) io.AddMousePosEvent(e.a, e.b);
+				else if (e.type == IN_BUTTON && e.a >= 0 && e.a < 3) io.AddMouseButtonEvent(static_cast<int>(e.a), e.b != 0);
+				else if (e.type == IN_WHEEL) io.AddMouseWheelEvent(0, e.b);
+			}
+			g_in.clear();
+		}
+		if (g_open <= 0) io.AddMousePosEvent(-FLT_MAX, -FLT_MAX);
+		if (panel && g_open < 0.05f) g_tab_t = g_time;   // opening: the sections come in again
+
+		backend_frame(g_fonts_dirty);
+		g_fonts_dirty = false;
+		ImGui::NewFrame();
+		if (g_open > 0) draw_panel(fi, s);
+		else if (counter) draw_counter(fi, s);
+		draw_toast(s, dt);
+		draw_trophy_toast(s, dt);
+		ImGui::Render();
+		return ImGui::GetDrawData();
+	}
+}
+
+// ---------------- the host window's messages (its thread) ----------------
+extern "C" int ps3rsx_overlay_message(void* hwnd, unsigned msg, unsigned long long wp, long long lp)
+{
+#ifdef _WIN32
+	g_hwnd = static_cast<HWND>(hwnd);
+	const bool open = g_panel.load() != 0;
+	switch (msg)
+	{
+	case WM_KEYDOWN:
+		if ((wp == VK_F1 || wp == VK_F3) && overlay_off()) return 1;   // PS3_OVERLAY_OFF: no performance overlay
+		if (wp == VK_F1 || (open && wp == VK_ESCAPE))
+		{
+			if (!(lp & (1LL << 30))) g_panel = !open;   // not the key's repeats
+			return 1;
+		}
+		if (wp == VK_F3)
+		{
+			if (!(lp & (1LL << 30))) g_counter = (g_counter.load() + 1) % COUNTERS;
+			return 1;
+		}
+		return open && wp != VK_F11;   // the game's keys wait while it is open (F11 still toggles)
+	case WM_KEYUP:
+		return wp == VK_F1 || wp == VK_F3 || (open && wp != VK_F11);
+	case WM_MOUSEMOVE:
+		if (open) push_input(IN_POS, static_cast<float>(static_cast<short>(lp & 0xFFFF)), static_cast<float>(static_cast<short>((lp >> 16) & 0xFFFF)));
+		return open;
+	case WM_LBUTTONDOWN: case WM_LBUTTONUP:
+	case WM_RBUTTONDOWN: case WM_RBUTTONUP:
+	case WM_MBUTTONDOWN: case WM_MBUTTONUP:
+		if (!open) return 0;
+		push_input(IN_POS, static_cast<float>(static_cast<short>(lp & 0xFFFF)), static_cast<float>(static_cast<short>((lp >> 16) & 0xFFFF)));
+		push_input(IN_BUTTON, msg <= WM_LBUTTONUP ? 0.0f : msg <= WM_RBUTTONUP ? 1.0f : 2.0f,
+		           (msg == WM_LBUTTONDOWN || msg == WM_RBUTTONDOWN || msg == WM_MBUTTONDOWN) ? 1.0f : 0.0f);
+		return 1;
+	case WM_MOUSEWHEEL:
+		if (open) push_input(IN_WHEEL, 0, static_cast<float>(static_cast<short>((wp >> 16) & 0xFFFF)) / WHEEL_DELTA);
+		return open;
+	}
+#else
+	(void)hwnd; (void)msg; (void)wp; (void)lp;
+#endif
+	return 0;
+}
+
+extern "C" int ps3rsx_overlay_blocks_input(void)
+{
+	return g_panel.load() != 0;
+}
+
+extern "C" void ps3rsx_overlay_set_counter(int level)
+{
+	g_counter = overlay_off() || level <= 0 ? COUNTER_OFF : level == 1 ? COUNTER_FPS : COUNTER_FULL;
+}
+
+extern "C" void ps3rsx_overlay_set_trophies(int (*count)(void), int (*get)(int index, ps3rsx_trophy* out),
+                                            int (*icon)(int id, const unsigned char** png, unsigned long long* size))
+{
+	g_trophy_icon = icon;
+	g_trophy_get = get;
+	g_trophy_count = count;
+}
+
+extern "C" void ps3rsx_overlay_trophy_unlocked(int id)
+{
+	// Not a performance overlay: shown even with PS3_OVERLAY_OFF (the console's
+	// own notice, like RPCS3's).
+	std::lock_guard lock(g_mu);
+	g_trophy_queue.push_back(id);
+	g_trophy_live = 1;
+}
diff --git a/gpu/bridge/ps3rsx_overlay.h b/gpu/bridge/ps3rsx_overlay.h
new file mode 100644
index 00000000..dbe51cf8
--- /dev/null
+++ b/gpu/bridge/ps3rsx_overlay.h
@@ -0,0 +1,40 @@
+/* The in-game panel (ps3rsx_overlay.cpp, Dear ImGui) over RPCS3's RSX picture: F1 opens it from the left edge, with
+ * a rail of tabs (performance, shaders, options, system). The host window's thread hands it the window messages
+ * (ps3rsx_overlay_message, ps3rsx.h); the RSX thread builds and draws it at each flip, after RPCS3's own overlays:
+ * ps3rsx_overlay_vk.cpp (VKPresent.cpp) and ps3rsx_overlay_gl.cpp (GLPresent.cpp). */
+#pragma once
+
+#include <functional>
+
+struct ImDrawData;
+
+namespace ps3rsx_overlay
+{
+	struct frame_info
+	{
+		unsigned width, height;     // the window's client area, in pixels
+		unsigned rsx_load;          // RPCS3's RSX load, 0..100
+		const char* renderer;       // "Vulkan" or "OpenGL"
+		const char* gpu_name;
+		unsigned long long vram_bytes;   // the device's local memory (0: unknown)
+	};
+
+	// Something to draw this flip (the panel, or its closing).
+	bool visible();
+
+	// Builds this flip's frame; nullptr when there is nothing to draw. RSX thread. `backend_frame` runs just before
+	// ImGui::NewFrame: the renderer's backend set up (the first time) and its NewFrame; its argument says the fonts
+	// were built again (another scale), so the font texture goes and is made again.
+	ImDrawData* build(const frame_info& info, const std::function<void(bool fonts_changed)>& backend_frame);
+
+	// The ImGui context, made on the first call (the renderers set up their backends on it).
+	bool ensure_context();
+
+	// RPCS3's OpenGL renderer (ps3rsx_overlay_gl.cpp): this flip's frame, true when there is something to draw; then
+	// drawn into the bound framebuffer.
+	bool gl_prepare(unsigned width, unsigned height, unsigned rsx_load);
+	void gl_draw();
+
+	// A shader the renderer had to compile during play (a cache miss).
+	void shader_compiled();
+}
diff --git a/gpu/bridge/ps3rsx_overlay_gl.cpp b/gpu/bridge/ps3rsx_overlay_gl.cpp
new file mode 100644
index 00000000..239eba0c
--- /dev/null
+++ b/gpu/bridge/ps3rsx_overlay_gl.cpp
@@ -0,0 +1,50 @@
+// The in-game panel on RPCS3's OpenGL renderer: Dear ImGui's own OpenGL 3 backend, in the renderer's context on the
+// RSX thread, into the window's framebuffer (GLPresent.cpp binds it). The backend keeps and restores the GL state it
+// changes, so RPCS3's state tracking still holds.
+#ifdef _WIN32
+#include <windows.h>
+#endif
+#include <GL/gl.h>
+
+#include "ps3rsx_overlay.h"
+#include "imgui.h"
+#include "imgui_impl_opengl3.h"
+
+#include <string>
+
+namespace
+{
+	bool s_init;
+	std::string s_gpu;
+	ImDrawData* s_draw;
+}
+
+namespace ps3rsx_overlay
+{
+	bool gl_prepare(unsigned width, unsigned height, unsigned rsx_load)
+	{
+		s_draw = nullptr;
+		const frame_info fi{width, height, rsx_load, "OpenGL", s_gpu.c_str(), 0};
+		s_draw = build(fi, [](bool fonts_changed)
+		{
+			if (!s_init)
+			{
+				const char* r = reinterpret_cast<const char*>(glGetString(GL_RENDERER));
+				s_gpu = r ? r : "?";
+				ImGui_ImplOpenGL3_Init("#version 330");
+				s_init = true;
+			}
+			else if (fonts_changed)
+				ImGui_ImplOpenGL3_DestroyFontsTexture();
+			ImGui_ImplOpenGL3_NewFrame();
+		});
+		return s_draw && s_draw->CmdListsCount > 0;
+	}
+
+	void gl_draw()
+	{
+		if (!s_draw || !s_init) return;
+		ImGui_ImplOpenGL3_RenderDrawData(s_draw);
+		s_draw = nullptr;
+	}
+}
diff --git a/gpu/bridge/ps3rsx_overlay_vk.cpp b/gpu/bridge/ps3rsx_overlay_vk.cpp
new file mode 100644
index 00000000..64c28304
--- /dev/null
+++ b/gpu/bridge/ps3rsx_overlay_vk.cpp
@@ -0,0 +1,101 @@
+// The in-game panel on RPCS3's Vulkan renderer: Dear ImGui's own Vulkan backend, on the renderer's device and its
+// single-target render pass for the swapchain's format (the one RPCS3's overlays draw with).
+#include "stdafx.h"
+#include "Emu/RSX/VK/VKHelpers.h"
+#include "Emu/RSX/VK/VKRenderPass.h"
+#include "Emu/RSX/VK/vkutils/commands.h"
+#include "Emu/RSX/VK/vkutils/device.h"
+
+#include "ps3rsx_overlay.h"
+#include "ps3rsx_overlay_vk.h"
+#include "imgui.h"
+#include "imgui_impl_vulkan.h"
+
+#include <string>
+
+namespace
+{
+	bool s_init;
+	VkRenderPass s_pass;
+	VkQueue s_queue;
+	std::string s_gpu;
+	unsigned long long s_vram;
+	ImDrawData* s_draw;
+
+	// The queue idle before the backend's objects go (they may be in a frame still in flight), under RPCS3's lock.
+	void queue_idle()
+	{
+		vk::acquire_global_submit_lock();
+		vkQueueWaitIdle(s_queue);
+		vk::release_global_submit_lock();
+	}
+
+	void init(const vk::render_device& dev, VkRenderPass pass)
+	{
+		const VkPhysicalDevice pdev = dev.gpu();
+		VkPhysicalDeviceProperties props;
+		vkGetPhysicalDeviceProperties(pdev, &props);
+		s_gpu = props.deviceName;
+		VkPhysicalDeviceMemoryProperties mem;
+		vkGetPhysicalDeviceMemoryProperties(pdev, &mem);
+		s_vram = 0;
+		for (u32 i = 0; i < mem.memoryHeapCount; i++)
+			if (mem.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) s_vram = std::max<unsigned long long>(s_vram, mem.memoryHeaps[i].size);
+
+		s_queue = dev.get_graphics_queue();
+		ImGui_ImplVulkan_InitInfo ii{};
+		ii.ApiVersion = props.apiVersion;
+		ii.Instance = dev.gpu();
+		ii.PhysicalDevice = pdev;
+		ii.Device = dev;
+		ii.QueueFamily = dev.get_graphics_queue_family();
+		ii.Queue = s_queue;
+		ii.DescriptorPoolSize = 8;
+		ii.RenderPass = pass;
+		ii.MinImageCount = 2;
+		ii.ImageCount = 8;   // its vertex buffers, one per frame in flight: more than RPCS3 keeps
+		ii.MSAASamples = VK_SAMPLE_COUNT_1_BIT;
+		ImGui_ImplVulkan_Init(&ii);
+		s_pass = pass;
+		s_init = true;
+	}
+}
+
+namespace ps3rsx_overlay
+{
+	bool vk_prepare(const vk::render_device& dev, VkFormat surface_format, unsigned width, unsigned height, unsigned rsx_load)
+	{
+		s_draw = nullptr;
+		const VkRenderPass pass = vk::get_renderpass(dev, vk::get_renderpass_key(surface_format));
+		const frame_info fi{width, height, rsx_load, "Vulkan", s_gpu.c_str(), s_vram};
+		s_draw = build(fi, [&](bool fonts_changed)
+		{
+			if (s_init && s_pass != pass)   // another swapchain format
+			{
+				queue_idle();
+				ImGui_ImplVulkan_Shutdown();
+				s_init = false;
+			}
+			if (!s_init) init(dev, pass);
+			else if (fonts_changed)
+			{
+				queue_idle();
+				ImGui_ImplVulkan_DestroyFontsTexture();
+			}
+			// the font texture, when it is (re)made, goes up through the backend's own submit on the queue
+			vk::acquire_global_submit_lock();
+			ImGui_ImplVulkan_NewFrame();
+			vk::release_global_submit_lock();
+		});
+		return s_draw && s_draw->CmdListsCount > 0;
+	}
+
+	void vk_draw(const vk::command_buffer& cmd, VkFramebuffer fbo, unsigned width, unsigned height)
+	{
+		if (!s_draw || !s_init) return;
+		vk::begin_renderpass(cmd, s_pass, fbo, coordu(0u, 0u, width, height));
+		ImGui_ImplVulkan_RenderDrawData(s_draw, cmd);
+		vk::end_renderpass(cmd);
+		s_draw = nullptr;
+	}
+}
diff --git a/gpu/bridge/ps3rsx_overlay_vk.h b/gpu/bridge/ps3rsx_overlay_vk.h
