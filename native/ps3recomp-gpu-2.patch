+			char t[64];
+			std::snprintf(t, sizeof t, "%.0f%%", std::max(g_cpu_proc, 0.0));
+			line(L("CPU (jogo)", "CPU (game)"), static_cast<float>(g_cpu_proc / 100), t);
+			std::snprintf(t, sizeof t, "%u%%", fi.rsx_load);
+			line("RSX", fi.rsx_load / 100.0f, t);
+			if (g_ram_total_gb > 0)
+			{
+				std::snprintf(t, sizeof t, "%.1f / %.0f GB", g_ram_used_gb, g_ram_total_gb);
+				line(L("RAM (sistema)", "RAM (system)"), static_cast<float>(g_ram_used_gb / g_ram_total_gb), t);
+				std::snprintf(t, sizeof t, "%.1f GB", g_ram_proc_gb);
