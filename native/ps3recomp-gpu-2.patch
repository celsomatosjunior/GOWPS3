+	std::vector<ps3rsx_trophy> trophies()
+	{
+		std::vector<ps3rsx_trophy> out;
+		const int n = g_trophy_count ? g_trophy_count() : 0;
+		for (int i = 0; i < n; i++)
+		{
+			ps3rsx_trophy t{};
+			if (g_trophy_get(i, &t) == 0) out.push_back(t);
