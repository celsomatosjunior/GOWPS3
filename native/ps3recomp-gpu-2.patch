+
+	void memory_protect(void* pointer, usz size, protection prot)
+	{
+		shm_stat(4, size, PS3RSX_RETURN_ADDRESS());
+		{   // which memory: by 16 MB of host address, with the bytes (PS3RSX_SHM_STATS=1)
+			static std::atomic<long long> s_pb[4096];
+			static std::atomic<unsigned long long> s_pt0;
+			static int on = -1;
+			if (on < 0) { const char* e = std::getenv("PS3RSX_SHM_STATS"); on = e && *e == '1'; }
+			if (on)
+			{
+				s_pb[(reinterpret_cast<uintptr_t>(pointer) >> 24) & 4095] += static_cast<long long>(size);
+				const unsigned long long now = static_cast<unsigned long long>(std::chrono::duration_cast<std::chrono::milliseconds>(
+					std::chrono::steady_clock::now().time_since_epoch()).count());
+				unsigned long long t0 = s_pt0.load();
+				if (!t0) s_pt0.compare_exchange_strong(t0, now);
+				else if (now - t0 >= 5000 && s_pt0.compare_exchange_strong(t0, now))
+				{
+					std::fprintf(stderr, "[shm] protects by host 16 MB:");
+					for (int r = 0; r < 6; r++)
+					{
+						int best = -1; long long bn = 0;
+						for (int i = 0; i < 4096; i++) { const long long v = s_pb[i].load(); if (v > bn) { bn = v; best = i; } }
+						if (best < 0) break;
+						std::fprintf(stderr, " 0x%llX000000=%lld MB", static_cast<unsigned long long>(best), bn >> 20);
+						s_pb[best] = -bn;
+					}
+					for (int i = 0; i < 4096; i++) s_pb[i] = 0;
+					std::fprintf(stderr, "%c", 10);
+				}
+			}
+		}
+		if (!size)
+		{
+			return;
+		}
+
+#ifdef _WIN32
+
+		DWORD old;
+		if (::VirtualProtect(pointer, size, +prot, &old))
+		{
+			return;
+		}
+
+		for (u64 addr = reinterpret_cast<u64>(pointer), end = addr + size; addr < end;)
+		{
+			const u64 boundary = (addr + 0x10000) & -0x10000;
+			const u64 block_size = std::min(boundary, end) - addr;
+
+			if (!::VirtualProtect(reinterpret_cast<LPVOID>(addr), block_size, +prot, &old))
+			{
+				fmt::throw_exception("VirtualProtect failed (%p, 0x%x, addr=0x%x, error=%s)", pointer, size, addr, fmt::win_error{GetLastError(), nullptr});
+			}
+
+			// Next region
+			addr += block_size;
+		}
+#else
+		const u64 ptr64 = reinterpret_cast<u64>(pointer);
+		ensure(::mprotect(reinterpret_cast<void*>(ptr64 & -get_page_size()), size + (ptr64 & (get_page_size() - 1)), +prot) != -1);
+#endif
+	}
+
+	bool memory_lock(void* pointer, usz size)
+	{
+		if (!size)
+		{
+			return true;
+		}
+
+#ifdef _WIN32
+		return ::VirtualLock(pointer, size);
+#else
+		return !::mlock(pointer, size);
+#endif
+	}
