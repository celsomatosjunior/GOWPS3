diff --git a/gpu/tests/test_fifo_recovery.py b/gpu/tests/test_fifo_recovery.py
new file mode 100644
index 00000000..5b47e4b4
--- /dev/null
+++ b/gpu/tests/test_fifo_recovery.py
@@ -0,0 +1,126 @@
+"""Exercise the production FIFO read/set_get methods without a graphics driver.
+
+Only the external memory/control interfaces are stubbed; the methods under
+test are extracted unchanged from RSXFIFO.cpp. This reproduces a recovery
+inside a method handler followed by the run_FIFO packet-drain call.
+Run in a compiler environment: python test_fifo_recovery.py --build-dir <dir>.
+"""
+import argparse
+import pathlib
+import shutil
+import subprocess
+import tempfile
+
+
+def method(source, signature):
+    begin = source.index(signature)
+    brace = source.index("{", begin)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[begin:end]
+
+
+STUBS = r"""
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <tuple>
+#include <utility>
+using u32 = uint32_t;
+enum { FIFO_ERROR = 0xdeadbeef, FIFO_EMPTY = 0xdeadf1f0 };
+struct register_pair { u32 reg = 0, value = 0; void set(u32 r, u32 v) { reg=r; value=v; } };
+struct { struct { bool rsx_fifo_accuracy = true; } core; } g_cfg;
+namespace vm { u32 words[1024]{}; u32 read32(u32 address) { assert(address < sizeof words); return words[address/4]; } }
+struct word { u32 v{}; void release(u32 n) { v=n; } };
+struct control { word get; u32 put = 0x1000; };
+struct FIFO_control;
+struct thread_stub { FIFO_control* fifo; u32 last_code_jump{}; void recover_fifo(); };
+struct FIFO_control {
+    u32 m_fifo_pos{}, m_cache_size{}, m_next_cmd_entry{}, m_remaining_commands{};
+    u32 m_command_reg{}, m_command_inc{4}, m_args_ptr{}, m_cmd{};
+    u32 m_memwatch_addr{}, m_memwatch_cmp{};
+    control* m_ctrl{}; thread_stub* m_thread{};
+    bool fetch_ok = true; u32 fetch_word = 0x11;
+    template<bool> u32 read_put() { return m_ctrl->put; }
+    std::pair<bool,u32> fetch_u32(u32) { return {fetch_ok,fetch_word}; }
+    void invalidate_cache() { m_cache_size=0; }
+    bool read_unsafe(register_pair&);
+    void set_get(u32 get, u32 spin_cmd=0);
+};
+void thread_stub::recover_fifo() { fifo->set_get(0x800); }
+"""
+
+CASES = r"""
+int main() {
+    control ctrl; FIFO_control fifo; thread_stub thread{&fifo};
+    fifo.m_ctrl=&ctrl; fifo.m_thread=&thread;
+    register_pair data;
+    // A valid packet must still consume its second argument and advance to
+    // the following header exactly once, in both fetch modes.
+    for (bool cached : {false,true}) {
+        g_cfg.core.rsx_fifo_accuracy=cached;
+        fifo.m_fifo_pos=0x104; fifo.m_next_cmd_entry=0x10c;
+        fifo.m_remaining_commands=1; fifo.m_command_reg=0x181c;
+        fifo.m_args_ptr=0x104; fifo.fetch_ok=true; fifo.fetch_word=0x11;
+        vm::words[0x108/4]=0x11;
+        assert(fifo.read_unsafe(data));
+        assert(data.reg==0x1820 && data.value==0x11);
+        assert(!fifo.read_unsafe(data));
+        assert(fifo.m_fifo_pos==0x10c);
+    }
+    // A method handler recovers to a new packet header. run_FIFO then calls
+    // read_unsafe to drain the old packet: it must preserve that new header.
+    fifo.set_get(0x800);
+    vm::words[0x800/4]=0x00041808;
+    vm::words[0x804/4]=0x12345678;
+    assert(!fifo.read_unsafe(data));
+    if (vm::read32(fifo.m_fifo_pos)!=0x00041808) {
+        std::fprintf(stderr,"FAIL: recovery skipped header, next word=%08X at %08X\n",
+            vm::read32(fifo.m_fifo_pos),fifo.m_fifo_pos); return 1;
+    }
+    // An empty queue leaves an outstanding argument pending at the old PC.
+    g_cfg.core.rsx_fifo_accuracy=true;
+    fifo.m_fifo_pos=0x104; fifo.m_next_cmd_entry=0x10c;
+    fifo.m_remaining_commands=1; fifo.fetch_ok=false; fifo.fetch_word=FIFO_EMPTY;
+    assert(!fifo.read_unsafe(data));
+    assert(fifo.m_fifo_pos==0x104 && fifo.m_remaining_commands==1);
+    // Recovery caused by fetch failure has the same boundary contract.
+    fifo.fetch_word=FIFO_ERROR;
+    assert(!fifo.read_unsafe(data));
+    assert(fifo.m_fifo_pos==0x800 && fifo.m_remaining_commands==0);
+    assert(!fifo.read_unsafe(data));
+    assert(vm::read32(fifo.m_fifo_pos)==0x00041808);
+    std::puts("PASS: FIFO packet draining, empty queue and recovery boundaries");
+}
+"""
+
+
+def run(build, compiler):
+    source = (pathlib.Path(__file__).resolve().parents[1] / "rsx/Emu/RSX/RSXFIFO.cpp").read_text(encoding="utf-8")
+    code = STUBS + method(source, "bool FIFO_control::read_unsafe(") + "\n" + method(source, "void FIFO_control::set_get(") + CASES
+    build.mkdir(parents=True, exist_ok=True)
+    cpp, exe = build / "fifo_recovery.cpp", build / "fifo_recovery.exe"
+    cpp.write_text(code, encoding="utf-8")
+    if "clang-cl" in pathlib.Path(compiler).name or pathlib.Path(compiler).name in {"cl", "cl.exe"}:
+        command = [compiler, "/nologo", "/std:c++20", "/EHsc", str(cpp), f"/Fe{exe}", f"/Fo{build / 'fifo_recovery.obj'}"]
+    else:
+        command = [compiler, "-std=c++20", str(cpp), "-o", str(exe)]
+    subprocess.run(command, check=True)
+    subprocess.run([str(exe.resolve())], check=True)
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--build-dir", type=pathlib.Path)
+    ap.add_argument("--cxx", default=shutil.which("clang-cl") or shutil.which("c++"))
+    args = ap.parse_args()
+    if not args.cxx:
+        ap.error("No C++ compiler available")
+    if args.build_dir:
+        run(args.build_dir.resolve(), args.cxx)
+    else:
+        with tempfile.TemporaryDirectory() as temp:
+            run(pathlib.Path(temp), args.cxx)
